create global temporary table TEMP_PRONTO_PAGO
  ( RUT                       VARCHAR2(20)
    ,FECHA_PAGO               DATE
    ,COD_TIPO_DEUDA           VARCHAR(20)
    ,MONTO_ABONO_NO_EXIGIBLE  NUMBER
    ,PESOS_ABONO_NO_EXIGIBLE  NUMBER
    ,MONTO_ABONO_FUTURO       NUMBER
    ,PESOS_ABONO_FUTURO       NUMBER
    ,MONTO_DSCTO_NO_EXIGIBLE  NUMBER
    ,PESOS_DSCTO_NO_EXIGIBLE  NUMBER
    ,MONTO_DSCTO_FUTURO       NUMBER
    ,PESOS_DSCTO_FUTURO       NUMBER
    ,MONTO_TOTAL              NUMBER
    ,MONTO_TOTAL_PESOS        NUMBER
)
on commit delete ROWS;