<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">
<script charset="utf-8" src="../../../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="../../../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js" type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input">
<input name="wi_hidden" id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
	<!-- menu superior-->
		<td width="1000"  height="51" align="center" id="awmAnchor-menu" style="width:100px; height:50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="520" border="0">
							<tr>
								<td height="100%"><div class="titulo_central_parametro">{WI_RUTA_MENU}</div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}</font></div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}</font></div></td>
							</tr>
						</table>
					</td> 
					<td width="68"></td>
					<td width="68">{WI_NO_SAVE}</td>
					<td width="68">{WI_SAVE}</td>
					<td width="68">{WI_MODIFY}</td>
					<td width="68"><input type="image" onmouseover="MM_swapImage('b_export','','../../../../commonlib_seven/trunk/images/b_export_over.jpg',1)" onmouseout="MM_swapImgRestore()" onmouseup="MM_swapImgRestore()" onmousedown="MM_swapImage('b_export','','../../../../commonlib_seven/trunk/images/b_export_click.jpg',1)" src="http://192.168.2.100/desarrolladores/hvera/commonlib_seven/trunk/images/b_export.jpg" id="b_export" name="b_export"></td>
				</tr>
			</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
	  	<td>
			<table width="1000" border="0" align="center">
				<tr>
					<td height="95" valign="top">
						<table width="1015" border="0" align="center" >
							<tr valign="top">
								<td>						
									<div style="height:526px;" class="claro">											
										<table width="1000" rules="none" border="1" align="center" class="claro">							
												<tr class="titulo_tabla">				
													<td colspan="6" >DATOS GENERALES</td>
												</tr>
												<tr class="encabezado_right">
													<td width="200">C&oacute;digo:</td>
													<td width="300" class="oscuro" align="left" colspan="5">{COD_EJECUCION_PROCESO}</td>	
												</tr>
												<tr class="encabezado_right">
													<td width="200">Nombre Proceso:</td>
													<td width="300" class="claro" align="left" colspan="5" style="width: 186px">{NOM_PROCESO}</td>
												</tr>
												<tr class="encabezado_right">
													<td width="200">Fecha de Inicio:</td>
													<td width="200" class="oscuro" align="left">{FECHA_EJECUCION_PROCESO}</td>
													<td width="200" style="width: 324px">Fecha de Termino:</td>
													<td width="200" class="oscuro" align="left" style="width: 275px">{FECHA_TERMINO}</td>
													<td width="200">Duración:</td>
													<td width="200" class="oscuro" align="left">{DURACION}</td>
												</tr>
												<tr class="encabezado_right">
													<td width="200"> Registros Procesados:</td>
													<td width="200" class="claro" align="left" style="height: 26px">{ACTUAL_REGISTRO}</td>
													<td width="200"> Errores:</td>
													<td width="200" class="claro" align="left">{CANT_ERROR}</td>
													<td width="200">Warning:</td>
													<td width="200" class="claro" align="left">{CANT_WARNING}</td>
												</tr>
										</table>
										<table width="1000" rules="none" border="1" align="center" class="claro">
											<tr><td></td></tr>
											<tr class="titulo_tabla">				
												<td colspan="6" >DETALLE ERROR DE PROCESO</td>
											</tr>
										</table>
										<table width="1000" rules="none" border="1" align="center" class="claro">
											<tr class="encabezado_right" >
												<th width="80" align="center">Código Error Proceso</th>
												<th width="80" align="center">Código Ejecución Proceso</th>
												<th width="80" align="center">Tipo Error</th>
												<th width="80" align="center">Código Error BD</th>
												<th width="330" align="center">Mensaje Error BD</th>
												<th width="350" align="center">Mensaje de Error</th>										
											</tr>
										</table>
										<div width="1000" style="display:{DISPLAY_DETALLE_ERROR}">
											<div style="overflow-x: hidden; overflow-y: auto; height: 310; ">
												<table width="1000" rules="none" border="1" align="center" class="claro" id="DETALLE_ERROR_PROCESO">
													<!-- startBlock(DETALLE_ERROR_PROCESO) -->
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}" >
														<td width="80" align="center">{COD_ERROR_PROCESO}</td>
														<td width="80" align="center">{COD_EJECUCION_PROCESO_DW}</td>
														<td width="80" align="center">{TIPO_ERROR}</td>
														<td width="80" align="center">{ERROR_CODE_BD}</td>
														<td width="330" align="left">{ERROR_MESSAGE_BD}</td>
														<td width="350" align="left">{ERROR_MESSAGE}</td>
													</tr>
													<!-- endBlock(DETALLE_ERROR_PROCESO) -->
												</table>	
											</div>
										</div>
									<div width="1000" style="display:{DISPLAY_MENSAJE_DETALLE_ERROR};">
										<table width="1000" border="1" rules="none" align="center" height="330">
											<tr class="titulo_tabla" valign="top">
												<td colspan="6" align="left" style="padding-left:10px;padding-top:10px; color:#0066CC;font-size:18px;">DETALLE ERROR DE PROCESO contiene demasiada informaci&oacute;n, favor usar bot&oacute;n &quot;Exportar&quot;.</td>
											</tr>
										</table>
									</div>
									</div>								
								</td>
							</tr>
						</table>
						<table width="1000" border="0" align="center">
				<tr valign="middle">
					  <td width="290" >{WI_BACK}</td>
					  <td align="right">{WI_FIRST}{WI_PREV}</td>
					  <td align="left">{WI_NEXT}{WI_LAST}</td>
					  <td width="290"></td>
				</tr>
			</table> 		
					</td>	
				</tr>  
			</table>
		</td>
	</tr>
</table>		
</form>
</body>
</html>
