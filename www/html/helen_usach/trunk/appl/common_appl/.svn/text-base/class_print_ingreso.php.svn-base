<?php
require_once(dirname(__FILE__)."/../../../../commonlib_seven/trunk/php/auto_load.php");
class print_ingreso extends reporte_helen{
    const K_PARAM_UNIVERSIDAD = 5;
    const K_ESTADO_SIMULACION        = 1000;
    const K_PARAM_MAX_VALIDEZ_SIMULACION = 24;
    const K_FONDO_SOLIDARIO       = 1;
    const K_CREDITO_INSTITUCIONAL = 2;
    
    
    function __construct ($sql, $xml, $labels=array(), $titulo, $con_logo, $vuelve_a_presentacion=false) {
        parent::__construct($sql, $xml, $labels, $titulo, $con_logo, $vuelve_a_presentacion);
    }
    function dibuja_uno(&$pdf, $result, $iniX, $iniY, $copia) {
        
        $pdf->SetDrawColor( 0,0,0);
        $count = count($result);
        $cod_estado_ingreso = $result[0]['COD_ESTADO_INGRESO'];
        
        $db_uni = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
        $sql= sql_ingreso::get_sql('PRINT_PARAM',self::K_PARAM_UNIVERSIDAD);
        $result_uni = $db_uni->build_results($sql);
        
        
        //results para imprimir partes que solo son para la usach
        $pdf->SetFont('Helvetica','B',8);
        $cod_ingreso = $result[0]['COD_INGRESO'];
        $sql_validez= sql_ingreso::get_sql('AJAX_VALIDEZ_SIMULACION_USACH',self::K_PARAM_MAX_VALIDEZ_SIMULACION,$cod_ingreso);
        $result_validez = $db_uni->build_results($sql_validez);
        
        //titulo de impresion
        $pdf->SetFont('Helvetica','B',20);
        //la impresiï¿½n de SIMULACION tiene algunas diferencias con INGRESO
        if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
            
            if(session::get('K_CLIENTE') == 'SURCOB_UACH'){
                $pdf->Text($iniX + 120, $iniY + 80,'Simulación Universidad Austral');
            }else{
                $pdf->Text($iniX + 220, $iniY + 85,'Simulación');
            }
            
            if($result_validez[0]['UNIVERSIDAD'] == 99999){
                $fecha_simulacion = $result_validez[0]['FECHA_INGRESO'];
                $fecha_habil = $result_validez[0]['DIA_HABIL'];
                $separado_fecha = explode('/',$fecha_simulacion);
                $fecha_impresa = $fecha_habil.'/'.$separado_fecha[1].'/'.$separado_fecha[2];
                $pdf->SetFont('Helvetica','B',7);
                $pdf->Text($iniX + 405, $iniY + 90,'Simulación Válida Hasta:');
                $pdf->SetFont('Helvetica','',7);
                $pdf->Text($iniX + 490, $iniY + 90,$fecha_impresa);
            }
        }
        else
            $pdf->Text($iniX + 220, $iniY + 85,'Ingreso Caja');
            
            $pdf->SetFont('Helvetica','B',8);
            $pdf->Text($iniX + 515, $iniY + 50,$result[0]['FECHA_INGRESO']);
            
            $pdf->SetFont('Helvetica','B',20);
            $pdf->Text($iniX +450, $iniY + 85,'N°:');
            $pdf->SetFont('Helvetica','',20);
            $pdf->Text($iniX + 480, $iniY + 85,$result[0]['COD_INGRESO']);
            
            $pdf->SetFont('Helvetica','B',9);
            $pdf->Text($iniX + 50, $iniY + 125,'Rut');
            $pdf->Text($iniX + 109, $iniY + 125,':');
            $pdf->SetFont('Helvetica','',8);
            $pdf->Text($iniX + 114, $iniY + 125,number_format($result [0]['RUT'], 0, ',', '.').' - '.$result[0]['DIG_VERIF']);
            
            $pdf->SetFont('Helvetica','B',9);
            $pdf->Text($iniX + 200, $iniY + 125,'Nombre :');
            $pdf->SetFont('Helvetica','',8);
            $pdf->Text($iniX + 240, $iniY + 125,$result[0]['NOMBRE']);
            
            $pdf->SetFont('Helvetica','B',9);
            $pdf->Text($iniX + 50, $iniY + 140,'Atendido por');
            $pdf->Text($iniX + 109, $iniY + 140,':');
            $pdf->SetFont('Helvetica','',8);
            $pdf->Text($iniX + 114, $iniY + 140, $result[0]['NOM_USUARIO']);
            
            $pdf->SetFont('Helvetica','B',9);
            $pdf->Text($iniX + 50, $iniY + 155,'Referencia');
            $pdf->Text($iniX + 109, $iniY + 155,':');
            $pdf->SetFont('Helvetica','',8);
            $pdf->Text($iniX + 114, $iniY + 155, $result[0]['REFERENCIA']);
            
            //DETALLE DE DEUDA EN INGRESO
            $cod_ingreso = $result[0]['COD_INGRESO'];
            $db_deuda = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
            
            $sql_deuda = "SELECT	DA.COD_DEUDA
									,DA.COD_TIPO_DEUDA
									,PP.ANO_COBRO
									,TO_CHAR(PP.FECHA_VENCTO, 'DD/MM/YYYY') FECHA_VENCTO
									,SALDO_CUOTA
									,SALDO_MULTA
									,TD.NOM_TIPO_DESCUENTO
									,MONTO_DESCUENTO
									,MONTO_PAGO
									,MONTO_PAGO_PESOS
							FROM	INGRESO I, ITEM_INGRESO IT	left outer join PLAN_PAGO PP on IT.COD_PLAN_PAGO = PP.COD_PLAN_PAGO
																left outer join TIPO_DESCUENTO TD on TD.COD_TIPO_DESCUENTO = IT.COD_TIPO_DESCUENTO
									,DEUDA DA, TIPO_DEUDA T, MONEDA M
							WHERE	I.COD_INGRESO = $cod_ingreso
							  AND	IT.COD_INGRESO = I.COD_INGRESO
							  AND	DA.COD_DEUDA = IT.COD_DEUDA
							  AND	T.COD_TIPO_DEUDA = DA.COD_TIPO_DEUDA
							  AND	M.COD_MONEDA = T.COD_MONEDA
							ORDER BY	DA.COD_TIPO_DEUDA, DA.COD_DEUDA, PP.ANO_COBRO";
            $result_deuda = $db_deuda->build_results($sql_deuda);
            
            //TITULOS  para Detalle Deuda.
            $pdf->SetFont('Helvetica','B',7);
            $pdf->Text($iniX + 50, $iniY + 180, 'DETALLE DEUDA');
            $pdf->SetFont('Helvetica','B',8);
            $pdf->SetXY($iniX + 50, $iniY+ 185);
            $pdf->Cell(50, 15, 'Cod. Deuda', 'LBRT', '','C');
            $pdf->SetXY($iniX + 100, $iniY+ 185);
            $pdf->Cell(50, 15, 'Tipo Deuda', 'BRT', '','C');
            $pdf->SetXY($iniX + 150, $iniY+ 185);
            $pdf->Cell(45, 15, 'Año Cobro', 'BRT', '','C');
            $pdf->SetXY($iniX + 195, $iniY+ 185);
            $pdf->Cell(45, 15, 'F. Vencto', 'BRT', '','C');
            $pdf->SetXY($iniX + 240, $iniY+ 185);
            $pdf->Cell(50, 15, 'Cuota UTM', 'BRT', '','C');
            $pdf->SetXY($iniX + 290, $iniY+ 185);
            $pdf->Cell(50, 15, 'I. Penal', 'BRT', '','C');
            $pdf->SetXY($iniX + 340, $iniY+ 185);
            $pdf->Cell(35, 15, 'Descto.', 'BRT', '','C');
            $pdf->SetXY($iniX + 375, $iniY+ 185);
            $pdf->Cell(60, 15, 'Monto Descto.', 'BRT', '','C');
            $pdf->SetXY($iniX + 435, $iniY+ 185);
            $pdf->Cell(60, 15, 'Total Moneda', 'BRT', '','C');
            $pdf->SetXY($iniX + 495, $iniY+ 185);
            $pdf->Cell(60, 15, 'Total Pesos', 'BRT', '','C');
            
            //TABLA DE DATOS_DEUDA
            $SUM_TOTAL_MONEDA = 0;
            $SUM_TOTAL_PESOS  = 0;
            for ($i=0, $y=0; $i < count($result_deuda); $i++,$y++) {
                $cod_deuda            = $result_deuda[$i]['COD_DEUDA'];
                $cod_tipo_deuda        = $result_deuda[$i]['COD_TIPO_DEUDA'];
                $ano_cobro            = $result_deuda[$i]['ANO_COBRO'];
                $fecha_vencto        = $result_deuda[$i]['FECHA_VENCTO'];
                $saldo_cuota        = number_format($result_deuda[$i]['SALDO_CUOTA'],4, ',', '.');
                $saldo_multa        = number_format($result_deuda[$i]['SALDO_MULTA'],4, ',', '.');
                $nom_tipo_descuento    = $result_deuda[$i]['NOM_TIPO_DESCUENTO'];
                $monto_descuento    = number_format($result_deuda[$i]['MONTO_DESCUENTO'],4, ',', '.');
                $monto_pago            = number_format($result_deuda[$i]['MONTO_PAGO'],4, ',', '.');
                $monto_pago_pesos    = number_format($result_deuda[$i]['MONTO_PAGO_PESOS'],0, ',', '.');
                
                $pdf->SetFont('Helvetica','',8);
                $pdf->SetXY($iniX + 50, $iniY+ 200 +(15 * $y));
                $pdf->Cell(50, 15, $cod_deuda, 'LB', '','C');
                $pdf->SetXY($iniX + 100, $iniY+ 200 +(15 * $y));
                $pdf->Cell(50, 15, $cod_tipo_deuda, 'LBR', '','C');
                $pdf->SetXY($iniX + 150, $iniY+ 200 +(15 * $y));
                $pdf->Cell(45, 15, $ano_cobro, 'BR', '','C');
                $pdf->SetXY($iniX + 195, $iniY+ 200 +(15 * $y));
                $pdf->Cell(45, 15, $fecha_vencto, 'BR', '','C');
                $pdf->SetXY($iniX + 240, $iniY+ 200 +(15 * $y));
                $pdf->Cell(50, 15, $saldo_cuota, 'BR', '','R');
                $pdf->SetXY($iniX + 290, $iniY+ 200 +(15 * $y));
                $pdf->Cell(50, 15, $saldo_multa, 'BR', '','R');
                $pdf->SetXY($iniX + 340, $iniY+ 200 +(15 * $y));
                $pdf->Cell(35, 15, $nom_tipo_descuento, 'BR', '','C');
                $pdf->SetXY($iniX + 375, $iniY+ 200 +(15 * $y));
                $pdf->Cell(60, 15, $monto_descuento, 'BR', '','R');
                $pdf->SetXY($iniX + 435, $iniY+ 200 +(15 * $y));
                $pdf->Cell(60, 15, $monto_pago, 'BR', '','R');
                $pdf->SetXY($iniX + 495, $iniY+ 200 +(15 * $y));
                $pdf->Cell(60, 15, $monto_pago_pesos, 'BR', '','R');
                $SUM_TOTAL_MONEDA    += $result_deuda[$i]['MONTO_PAGO'];
                $SUM_TOTAL_PESOS    += $result_deuda[$i]['MONTO_PAGO_PESOS'];
            }
            
            //totales de deuda
            $pdf->SetFont('Helvetica','B',7);
            $pdf->SetXY($iniX + 375, $iniY+ 200 +(15 * $y));
            $pdf->Cell(60, 15, 'Total Abonado', 'LBR', '','L');
            $pdf->SetFont('Helvetica','B',8);
            $SUM_TOTAL_MONEDA = number_format($SUM_TOTAL_MONEDA,4, ',', '.');
            $SUM_TOTAL_PESOS  = number_format($SUM_TOTAL_PESOS,0, ',', '.');
            $pdf->SetXY($iniX + 435, $iniY+ 200 +(15 * $y));
            $pdf->Cell(60, 15, $SUM_TOTAL_MONEDA, 'BR', '','R');
            $pdf->SetXY($iniX + 495, $iniY+ 200 +(15 * $y));
            $pdf->Cell(60, 15, $SUM_TOTAL_PESOS, 'BR', '','R');
            
            //otros gastos
            $pdf->SetFont('Helvetica','B',7);
            $pdf->SetXY($iniX + 375, $iniY+ 220 +(15 * $y));
            $pdf->Text($iniX + 50, $iniY+ 220 +(15 * $y),'Otros Gastos');
            $pdf->Text($iniX + 110, $iniY+ 220 +(15 * $y),':');
            $pdf->SetFont('Helvetica','',7);
            $monto_otros_gastos = $result[0]['MONTO_OTROS_GASTOS'];
            $pdf->Text($iniX + 115, $iniY+ 220 +(15 * $y), number_format($monto_otros_gastos,0, ',', '.'));
            
            $pdf->SetFont('Helvetica','B',7);
            $pdf->Text($iniX + 50, $iniY+ 230 +(15 * $y),'Descripción');
            $pdf->Text($iniX + 110, $iniY+ 230 +(15 * $y),':');
            $pdf->SetFont('Helvetica','',8);
            $pdf->Text($iniX + 115, $iniY+ 230 +(15 * $y), $result[0]['GLOSA_OTROS_GASTOS']);
            
            //coordenadas x, y
            $y = 40 + ($iniY+ 225 +(15 * $y));
            
            //agrega los totales arriba de Formas Pago solo para simulacion
            if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                $pdf->SetFont('Helvetica','B',7);
                $pdf->Text($iniX + 50, $iniY + $y - 28, 'Totales');
                $inicioT = $y - 15;//se usa para la posicion de los totales
                $y = $y + 35;
            }
            
            //TITULOS  para Forma Pago.
            $pdf->SetFont('Helvetica','B',7);
            $pdf->Text($iniX + 50, $iniY + $y - 15, 'FORMA PAGO');
            
            $y = $y - 10;
            $pdf->SetY($y);
            
            //valor que obtiene la posicion donde se empiezan a imprimir el detalle forma pago,
            //este para usar cuando se obtienen muchos registros y hacer tablas a un lado.
            $sigTabla = $pdf->GetY();//al momento de imprimir con este valor sumar 10
            
            $limiteDoc = 600;// el limite maximo hasta donde se pueden ingresar los registros
            $celdaX = 50;
            //la impresiï¿½n de SIMULACION tiene algunas diferencias con INGRESO
            if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                $pdf->SetFont('Helvetica','B',8);
                $pdf->SetXY($iniX + 50, $iniY+ $y);
                $pdf->Cell(55, 15, 'Documento', 'LBRT', '','C');
                $pdf->SetXY($iniX + 105, $iniY+ $y);
                $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                $pdf->SetXY($iniX + 150, $iniY+ $y);
                $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
            }
            else{
                $pdf->SetFont('Helvetica','B',8);
                $pdf->SetXY($iniX + 50, $iniY+ $y);
                $pdf->Cell(80, 15, 'Tipo Documento', 'LBRT', '','C');
                $pdf->SetXY($iniX + 130, $iniY+ $y);
                $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                $pdf->SetXY($iniX + 175, $iniY+ $y);
                $pdf->Cell(180, 15, 'Banco', 'LBRT', '','C');
                $pdf->SetXY($iniX + 355, $iniY+ $y);
                $pdf->Cell(70, 15, 'N° Documento', 'LBRT', '','C');
                $pdf->SetXY($iniX + 425, $iniY+ $y);
                $pdf->Cell(70, 15, 'Plaza', 'BRT', '','C');
                $pdf->SetXY($iniX + 495, $iniY+ $y);
                $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
            }
            
            //DETALLE DE DOCUMENTO_PAGO
            $cod_ingreso = $result[0]['COD_INGRESO'];
            $db_pagos = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
            $sql_pagos = sql_ingreso::get_sql('PRINT_DOCUMENTO_PAGO', $cod_ingreso);
            $result_pagos = $db_pagos->build_results($sql_pagos);
            
            //COORDENADAS DE TABLA FORMA_PAGO
            $Y = $iniX+ $y + 15;
            
            
            //TABLA DE FORMA_PAGO
            $SUM_MONTO_PAGO     = 0;
            
            for($i=0, $y_salto=0; $i < count($result_pagos); $i++,$y_salto++){
                $nom_docto_pago        = $result_pagos[$i]['NOM_TIPO_DOCUMENTO_PAGO'];
                $fecha_docto_pago    = $result_pagos[$i]['FECHA_DOCUMENTO_PAGO'];
                $nom_banco_pago        = $result_pagos[$i]['NOM_BANCO'];
                $nro_docto_pago        = $result_pagos[$i]['NRO_DOCUMENTO_PAGO'];
                $nom_plaza_pago        = $result_pagos[$i]['NOM_PLAZA'];
                $monto_pago            = number_format($result_pagos[$i]['MONTO'],0, ',', '.');
                
                $regActual = $pdf->GetY();
                if($regActual < $limiteDoc){
                    //la impresiï¿½n de SIMULACION tiene algunas diferencias con INGRESO
                    if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                        $pdf->SetFont('Helvetica','',8);
                        $pdf->SetXY($iniX + $celdaX, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(55, 15, $nom_docto_pago, 'LBR', '','L');
                        $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(45, 15, $fecha_docto_pago, 'LBR', '','C');
                        $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(60, 15, $monto_pago, 'BR', '','R');
                    }
                    else{
                        $pdf->SetFont('Helvetica','',8);
                        $pdf->SetXY($iniX + 50, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(80, 15, $nom_docto_pago, 'LB', '','C');
                        $pdf->SetXY($iniX + 130, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(45, 15, $fecha_docto_pago, 'LBR', '','C');
                        $pdf->SetXY($iniX + 175, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(180, 15, $nom_banco_pago, 'BR', '','L');
                        $pdf->SetXY($iniX + 355, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(70, 15, $nro_docto_pago, 'BR', '','C');
                        $pdf->SetXY($iniX + 425, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(70, 15, $nom_plaza_pago, 'BR', '','L');
                        $pdf->SetXY($iniX + 495, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(60, 15, $monto_pago, 'BR', '','R');
                    }
                }
                else{
                    //inicializan, heredan variables
                    $y_salto = 0;
                    $y = $sigTabla;
                    $celdaX = $celdaX + 170;
                    
                    if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                        $pdf->SetFont('Helvetica','B',8);
                        $pdf->SetXY($iniX + $celdaX, $iniY+ $y);
                        $pdf->Cell(55, 15, 'Documento', 'LBRT', '','C');
                        $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $y);
                        $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                        $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $y);
                        $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
                    }
                    else{
                        $pdf->addpage();
                        $y = 125;
                        
                        $factor = 0.2;
                        $pdf->Image(dirname(__FILE__)."/../../images_appl/".session::get('K_CLIENTE')."/logo_universidad.jpg",$iniX + 40,$iniY - 10, $factor * 400, $factor * 457);
                        
                        $pdf->SetFont('Helvetica','',8);
                        $pdf->Text($iniX + 130, $iniY + 12,'FONDO SOLIDARIO DE CRéDITO UNIVERSITARIO');
                        $pdf->Text($iniX + 130, $iniY + 21,$result_uni[0]['NOM_UNIVERSIDAD']);
                        
                        
                        $cod_ingreso = $result[0]['COD_INGRESO'];
                        
                        $pdf->SetFont('Helvetica','B',20);
                        $pdf->Text($iniX + 220, $iniY + 80,'Ingreso Caja');
                        
                        $pdf->SetFont('Helvetica','B',20);
                        $pdf->Text($iniX +450, $iniY + 50,'N°:');
                        $pdf->SetFont('Helvetica','',20);
                        $pdf->Text($iniX + 480, $iniY + 50,$result[0]['COD_INGRESO']);
                        
                        $pdf->SetFont('Helvetica','B',8);
                        $pdf->SetXY($iniX + 50, $iniY+ $y);
                        $pdf->Cell(80, 15, 'Tipo Documento', 'LBRT', '','C');
                        $pdf->SetXY($iniX + 130, $iniY+ $y);
                        $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                        $pdf->SetXY($iniX + 175, $iniY+ $y);
                        $pdf->Cell(180, 15, 'Banco', 'LBRT', '','C');
                        $pdf->SetXY($iniX + 355, $iniY+ $y);
                        $pdf->Cell(70, 15, 'N° Documento', 'LBRT', '','C');
                        $pdf->SetXY($iniX + 425, $iniY+ $y);
                        $pdf->Cell(70, 15, 'Plaza', 'BRT', '','C');
                        $pdf->SetXY($iniX + 495, $iniY+ $y);
                        $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
                    }
                    
                    if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                        $pdf->SetFont('Helvetica','',8);
                        $pdf->SetXY($iniX + $celdaX, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(55, 15, $nom_docto_pago, 'LBR', '','L');
                        $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(45, 15, $fecha_docto_pago, 'LBR', '','C');
                        $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(60, 15, $monto_pago, 'BR', '','R');
                    }
                    else{
                        $Y = 140;
                        
                        $pdf->SetFont('Helvetica','',8);
                        $pdf->SetXY($iniX + 50, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(80, 15, $nom_docto_pago, 'LB', '','C');
                        $pdf->SetXY($iniX + 130, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(45, 15, $fecha_docto_pago, 'LBR', '','C');
                        $pdf->SetXY($iniX + 175, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(180, 15, $nom_banco_pago, 'BR', '','L');
                        $pdf->SetXY($iniX + 355, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(70, 15, $nro_docto_pago, 'BR', '','C');
                        $pdf->SetXY($iniX + 425, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(70, 15, $nom_plaza_pago, 'BR', '','L');
                        $pdf->SetXY($iniX + 495, $iniY+ $Y +(15 * $y_salto));
                        $pdf->Cell(60, 15, $monto_pago, 'BR', '','R');
                    }
                }
                $SUM_MONTO_PAGO      += $result_pagos[$i]['MONTO'];
            }
            
            //DETALLE DE DOCUMENTO_PAGO_CH_FECHA
            $cod_ingreso = $result[0]['COD_INGRESO'];
            $db_pago_fecha = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
            
            $sql_pago_fecha = "SELECT 	 TO_CHAR(FECHA_DOCUMENTO_PAGO, 'DD/MM/YYYY') FECHA_DOCUMENTO_PAGO_CH_FECH
									,B.NOM_BANCO NOM_BANCO_CH_FECH
									,NRO_DOCUMENTO_PAGO NRO_DOCUMENTO_PAGO_CH_FECH
								    ,P.NOM_PLAZA NOM_PLAZA_CH_FECH
								    ,MONTO MONTO_CH_FECH
								    ,I.MONTO_CHEQUE_FECHA
							FROM 	DOCUMENTO_INGRESO_CH_FECHA D, INGRESO I
									,DOCUMENTO_PAGO DP	left outer join BANCO B on DP.COD_BANCO = B.COD_BANCO
														left outer join PLAZA P on DP.COD_PLAZA = P.COD_PLAZA
							WHERE 	D.COD_INGRESO = I.COD_INGRESO
							AND   	D.COD_DOCUMENTO_PAGO = DP.COD_DOCUMENTO_PAGO
              				AND   	I.COD_INGRESO = $cod_ingreso";
            $result_pago_fecha = $db_pago_fecha->build_results($sql_pago_fecha);
            
            $cantidad_pago_fecha = count($result_pago_fecha);
            if($cantidad_pago_fecha > 0){
                //COORDENADAS DE TABLA FORMA_PAGO
                //coordenadas y
                $Y = ($Y +(15 * $y_salto));//AQUI TA EL PROBLEMA
                $y_salto = 0;
                //TABLA DE DOCUMENTO_PAGO_CH_FECHA
                $SUM_MONTO_PAGO_FECHA    = 0;
                $MONTO_INTERES            = 0;
                $TOTAL_ABONO            = 0;
                $MONTO_CH_FECHA_INGRESO = $result_pago_fecha[0]['MONTO_CHEQUE_FECHA'];
                
                for($i=0, $y_salto=0; $i < $cantidad_pago_fecha; $i++,$y_salto++){
                    $nom_pago_fecha                = 'CH. FECHA';
                    $fecha_pago_fecha            = $result_pago_fecha[$i]['FECHA_DOCUMENTO_PAGO_CH_FECH'];
                    $nom_banco_pago_fecha        = $result_pago_fecha[$i]['NOM_BANCO_CH_FECH'];
                    $nro_docto_pago_fecha        = $result_pago_fecha[$i]['NRO_DOCUMENTO_PAGO_CH_FECH'];
                    $nom_plaza_pago_fecha        = $result_pago_fecha[$i]['NOM_PLAZA_CH_FECH'];
                    $monto_pago_fecha            = number_format($result_pago_fecha[$i]['MONTO_CH_FECH'],0, ',', '.');
                    
                    $regActual = $pdf->GetY();
                    if($regActual < $limiteDoc){
                        if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                            $pdf->SetFont('Helvetica','',8);
                            $pdf->SetXY($iniX + $celdaX, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(55, 15, $nom_pago_fecha, 'LBR', '','L');
                            $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(45, 15, $fecha_pago_fecha, 'LBR', '','C');
                            $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(60, 15, $monto_pago_fecha, 'BR', '','R');
                        }else{
                            $pdf->SetFont('Helvetica','',8);
                            $pdf->SetXY($iniX + 50, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(80, 15, $nom_pago_fecha, 'LB', '','C');
                            $pdf->SetXY($iniX + 130, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(45, 15, $fecha_pago_fecha, 'LBR', '','C');
                            $pdf->SetXY($iniX + 175, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(180, 15, $nom_banco_pago_fecha, 'BR', '','L');
                            $pdf->SetXY($iniX + 355, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(70, 15, $nro_docto_pago_fecha, 'BR', '','C');
                            $pdf->SetXY($iniX + 425, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(70, 15, $nom_plaza_pago_fecha, 'BR', '','L');
                            $pdf->SetXY($iniX + 495, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(60, 15, $monto_pago_fecha, 'BR', '','R');
                        }
                    }
                    else{
                        //inicializan, heredan variables
                        $y_salto = 0;
                        $celdaX = $celdaX + 170;
                        $Y = $sigTabla + 15;
                        
                        if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                            $pdf->SetFont('Helvetica','B',8);
                            $pdf->SetXY($iniX + $celdaX, $iniY+ $sigTabla);
                            $pdf->Cell(55, 15, 'Documento', 'LBRT', '','C');
                            $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $sigTabla);
                            $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                            $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $sigTabla);
                            $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
                        }
                        else{
                            $pdf->addpage();
                            $y = 125;
                            
                            //para el caso de la UV el encabezado es distinto
                            if(session::get('K_CLIENTE') == 'UV'){
                                $factor = 0.45;
                                $pdf->Image(dirname(__FILE__)."/../../images_appl/".session::get('K_CLIENTE')."/logo_universidad.jpg", $iniX + 50, $iniY - 5, $factor * 286, $factor * 147);
                                $pdf->SetFont('Helvetica','B',8);
                                $pdf->Text($iniX + 200, $iniY + 765,'FONDO SOLIDARIO DE CRÉDITO UNIVERSITARIO');
                            }else{
                                $factor = 0.2;
                                $pdf->Image(dirname(__FILE__)."/../../images_appl/".session::get('K_CLIENTE')."/logo_universidad.jpg",$iniX + 40,$iniY + 0, $factor * 300, $factor * 357);
                                
                                $pdf->SetFont('Helvetica','',8);
                                $pdf->Text($iniX + 130, $iniY + 12,'FONDO SOLIDARIO DE CRÉDITO UNIVERSITARIO');
                                $pdf->Text($iniX + 130, $iniY + 21,$result_uni[0]['NOM_UNIVERSIDAD']);
                            }
                            
                            $pdf->SetFont('Helvetica','B',20);
                            $pdf->Text($iniX + 220, $iniY + 80,'Ingreso Caja');
                            
                            $pdf->SetFont('Helvetica','B',8);
                            $pdf->SetXY($iniX + 50, $iniY+ $y);
                            $pdf->Cell(80, 15, 'Tipo Documento', 'LBRT', '','C');
                            $pdf->SetXY($iniX + 130, $iniY+ $y);
                            $pdf->Cell(45, 15, 'Fecha', 'BRT', '','C');
                            $pdf->SetXY($iniX + 175, $iniY+ $y);
                            $pdf->Cell(180, 15, 'Banco', 'LBRT', '','C');
                            $pdf->SetXY($iniX + 355, $iniY+ $y);
                            $pdf->Cell(70, 15, 'N° Documento', 'LBRT', '','C');
                            $pdf->SetXY($iniX + 425, $iniY+ $y);
                            $pdf->Cell(70, 15, 'Plaza', 'BRT', '','C');
                            $pdf->SetXY($iniX + 495, $iniY+ $y);
                            $pdf->Cell(60, 15, 'Monto', 'BRT', '','C');
                            
                        }
                        
                        if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                            $pdf->SetFont('Helvetica','',8);
                            $pdf->SetXY($iniX + $celdaX, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(55, 15, $nom_pago_fecha, 'LBR', '','L');
                            $pdf->SetXY($iniX + $celdaX + 55, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(45, 15, $fecha_pago_fecha, 'LBR', '','C');
                            $pdf->SetXY($iniX + $celdaX + 100, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(60, 15, $monto_pago_fecha, 'BR', '','R');
                        }else{
                            $pdf->SetFont('Helvetica','',8);
                            $pdf->SetXY($iniX + 50, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(80, 15, $nom_pago_fecha, 'LB', '','C');
                            $pdf->SetXY($iniX + 130, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(45, 15, $fecha_pago_fecha, 'LBR', '','C');
                            $pdf->SetXY($iniX + 175, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(190, 15, $nom_banco_pago_fecha, 'BR', '','L');
                            $pdf->SetXY($iniX + 365, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(60, 15, $nro_docto_pago_fecha, 'BR', '','C');
                            $pdf->SetXY($iniX + 425, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(70, 15, $nom_plaza_pago_fecha, 'BR', '','L');
                            $pdf->SetXY($iniX + 495, $iniY+ $Y +(15 * $y_salto));
                            $pdf->Cell(60, 15, $monto_pago_fecha, 'BR', '','R');
                        }
                    }
                    
                    //la impresiï¿½n de SIMULACION tiene algunas diferencias con INGRESO
                    //INTERES DE CHEQUES FALTA
                    $SUM_MONTO_PAGO_FECHA     += $result_pago_fecha[$i]['MONTO_CH_FECH'];
                }
                
                //CALCULOS DE TOTAL_MONTO, MONTO_INTERES, TOTAL_ABONO
                $TOTAL_MONTO = $SUM_MONTO_PAGO + $SUM_MONTO_PAGO_FECHA;
                $MONTO_INTERES = $SUM_MONTO_PAGO_FECHA - $MONTO_CH_FECHA_INGRESO;
                $TOTAL_ABONO = $TOTAL_MONTO - $MONTO_INTERES - $monto_otros_gastos;
                
                //COORDENADAS DE TABLA TOTALES
                //coordenadas y
                $Y = ($iniY+ $Y +(15 * $y_salto));
                
                //TOTAL ABONO
                $pdf->SetFont('Helvetica','B',7);
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 50, $iniX+ $inicioT);
                    $pdf->Cell(80, 15, 'Total Abono', 'LBTR', '','L');
                }
                else{
                    $pdf->SetXY($iniX + 425, $iniX+ $Y);
                    $pdf->Cell(70, 15, 'Total Abono', 'LBR', '','L');
                }
                $pdf->SetFont('Helvetica','B',8);
                $TOTAL_ABONO = number_format($TOTAL_ABONO,0, ',', '.');
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 50, $iniX+ $inicioT +15);
                    $pdf->Cell(80, 15, $TOTAL_ABONO, 'LBTR', '','R');
                }else{
                    $pdf->SetXY($iniX + 495, $iniX+ $Y);
                    $pdf->Cell(60, 15, $TOTAL_ABONO, 'BR', '','R');
                }
                
                //TOTAL INTERES DE CHEQUE FECHA
                $pdf->SetFont('Helvetica','B',7);
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 130, $iniX+ $inicioT);
                    $pdf->Cell(110, 15, 'Interés Cheque a Fecha', 'LBTR', '','L');
                }
                else{
                    $pdf->SetXY($iniX + 425, $iniX+ $Y + 15);
                    $pdf->Cell(70, 15, 'Interés Ch. Fecha', 'LBR', '','L');
                }
                $pdf->SetFont('Helvetica','B',8);
                $MONTO_INTERES = number_format($MONTO_INTERES,0, ',', '.');
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 130, $iniX+ $inicioT + 15);
                    $pdf->Cell(110, 15, $MONTO_INTERES, 'LBTR', '','R');
                }else{
                    $pdf->SetXY($iniX + 495, $iniX+ $Y + 15);
                    $pdf->Cell(60, 15, $MONTO_INTERES, 'BR', '','R');
                }
                
                //TOTAL DOCUMENTO
                $pdf->SetFont('Helvetica','B',7);
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 240, $iniX+ $inicioT);
                    $pdf->Cell(80, 15, 'Total Documento', 'LBTR', '','L');
                }
                else{
                    $pdf->SetXY($iniX + 425, $iniX+ $Y + 30);
                    $pdf->Cell(70, 15, 'Total Documento', 'LBR', '','L');
                }
                $pdf->SetFont('Helvetica','B',8);
                $TOTAL_MONTO = number_format($TOTAL_MONTO,0, ',', '.');
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 240, $iniX+ $inicioT + 15);
                    $pdf->Cell(80, 15, $TOTAL_MONTO, 'LBTR', '','R');
                }else{
                    $pdf->SetXY($iniX + 495, $iniX+ $Y + 30);
                    $pdf->Cell(60, 15, $TOTAL_MONTO, 'BR', '','R');
                }
            }
            else{
                //COORDENADAS DE TABLA FORMA_PAGO
                //coordenadas y
                $Y = ($Y +(15 * $y_salto));
                
                //totales de deuda
                $pdf->SetFont('Helvetica','B',7);
                
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 50, $iniX+ $inicioT);
                    $pdf->Cell(80, 15, 'Total Documentos', 'LBTR', '','L');
                }
                else{
                    $pdf->SetXY($iniX + 425, $iniX+ $Y + 10);
                    $pdf->Cell(70, 15, 'Total Documentos', 'LBR', '','L');
                }
                $pdf->SetFont('Helvetica','B',8);
                $SUM_MONTO_PAGO = number_format($SUM_MONTO_PAGO,0, ',', '.');
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    $pdf->SetXY($iniX + 50, $iniX+ $inicioT + 15);
                    $pdf->Cell(80, 15, $SUM_MONTO_PAGO, 'LBTR', '','R');
                }else{
                    $pdf->SetXY($iniX + 495, $iniX+ $Y + 10);
                    $pdf->Cell(60, 15, $SUM_MONTO_PAGO, 'BR', '','R');
                }
            }
            
            if($result_validez[0]['UNIVERSIDAD'] == 99999){
                //mensaje
                $pdf->SetFont('Helvetica','',8);
                $pdf->Text($iniX + 90, $iniY + 740,'SE  ENTENDERA  CANCELADA(S)  LA(S)  CUOTA(S)  UNA  VEZ  COBRADO(S)  EL(LOS)  CHEQUE(S).');
                $pdf->Line($iniX + 40, $iniY + 752, $iniX + 555, $iniY + 752);
            }else{
                if(session::get('K_CLIENTE') == 'MASCOB_UCM' || session::get('K_CLIENTE') == 'SURCOB_UCM'){
                    $pdf->SetFont('Helvetica','',8);
                    $pdf->Text($iniX + 90, $iniY + 700,'SE  ENTENDERA  CANCELADA(S)  LA(S)  CUOTA(S)  UNA  VEZ  COBRADO(S)  EL(LOS)  CHEQUE(S).');
                }else if(session::get('K_CLIENTE') == 'ALIANSE'){
                    $pdf->SetFont('Helvetica','',8);
                    $pdf->Text($iniX + 90, $iniY + 700,'SE  ENTENDERA  CANCELADA(S)  LA(S)  CUOTA(S)  UNA  VEZ  COBRADO(S)  EL(LOS)  CHEQUE(S).');
                    $pdf->SetFont('Helvetica','B',8);
                    $pdf->Text($iniX + 120, $iniY + 680,'pp. Universidad de Atacama.');
                }else{
                    $pdf->SetFont('Helvetica','',8);
                    $pdf->Text($iniX + 90, $iniY + 734,'SE  ENTENDERA  CANCELADA(S)  LA(S)  CUOTA(S)  UNA  VEZ  COBRADO(S)  EL(LOS)  CHEQUE(S).');
                }
                
                if($cod_estado_ingreso == self::K_ESTADO_SIMULACION){
                    if(session::get('K_CLIENTE') == 'ALIANSE'){
                        $pdf->Text($iniX + 90, $iniY + 720,'DOCUMENTO VALIDO SOLO POR EL DIA DE EMISION DE ESTA SIMULACION');
                        $pdf->Line($iniX + 40, $iniY + 722, $iniX + 555, $iniY + 722);
                    }else{
                        $pdf->Text($iniX + 90, $iniY + 750,'DOCUMENTO VALIDO SOLO POR EL DIA DE EMISION DE ESTA SIMULACION');
                        $pdf->Line($iniX + 40, $iniY + 752, $iniX + 555, $iniY + 752);
                    }
                }
            }
            
            //tipo copia
            $pdf->SetFont('Helvetica','',9);
            $pdf->Line($iniX + 415, $iniY + 660, $iniX + 555, $iniY + 660);
            $pdf->Text($iniX + 450, $iniY + 670,'Timbre Caja');
            $pdf->Line($iniX + 105, $iniY + 660, $iniX + 245, $iniY + 660);
            $pdf->Text($iniX + 150, $iniY + 670,'Copia'.' '.$copia);
            $pdf->SetFont('Helvetica','B',8);
    }
    function modifica_pdf(&$pdf) {
        $db = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
        $result = $db->build_results($this->sql);
        
        $this->dibuja_uno($pdf, $result,0, 10, 'Deudor');
        
        $pdf->AddPage();
        if(K_CLIENTE =="ALIANSE")
            $this->dibuja_uno($pdf, $result, 0, 10, 'Alianse');
        else
            $this->dibuja_uno($pdf, $result, 0, 10, 'Universidad');
    }
}
