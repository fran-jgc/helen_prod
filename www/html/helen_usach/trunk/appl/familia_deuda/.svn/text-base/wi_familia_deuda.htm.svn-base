<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="familia_deuda.js" type="text/javascript"></script>
<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />

<style type="text/css">
<!--
.Estilo1 {
	color: #FF0000;
	font-weight: bold;
}

.Estilo2 {
	color: #993300;
	font-weight: bold;
	align: right;
}
-->
</style>


{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js"
	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input">
<input name="wi_hidden" id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
	<!-- menu superior-->
		<td width="1000"  height="51" align="center" id="awmAnchor-menu" style="width:100px; height:50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="520" border="0">
							<tr>
								<td height="100%"><div class="titulo_central_parametro">{WI_RUTA_MENU}</div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}</font></div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}</font></div></td>
							</tr>
						</table>
					</td> 
					<td width="68"></td>
					<td width="68">{WI_NO_SAVE}</td>
					<td width="68">{WI_SAVE}</td>
					<td width="68">{WI_MODIFY}</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
	  	<td>
			<table width="1000" border="0" align="center">
				<tr>
					<td height="95" valign="top">
						<table width="1015" border="0" align="center" >
							<tr valign="top">
								<td>						
									<div style="height:526px;" class="claro">											
										<table width="1000" rules="none" border="1" align="center" class="claro">							
											<tr class="titulo_tabla">				
												<td colspan="4" >DATOS GENERALES</td>
											</tr>
											<tr class="encabezado_right">
												<td width="266">C&oacute;digo:</td>
												<td colspan="3" class="claro" align="left">{COD_FAMILIA_DEUDA}</td>	
											</tr>
											<tr class="encabezado_right">
												<td>Familia Deuda:</td>
												<td class="oscuro" align="left">{NOM_FAMILIA_DEUDA}</td>
											</tr>
											<tr class="encabezado_right">
												<td>Cuenta Interés CH a Fecha:</td>
												<td class="claro" align="left">{COD_CUENTA_CH_FECHA}</td>
											</tr>
											<tr class="encabezado_right">
												<td>Cuenta Protesto documentos:</td>
												<td class="oscuro" align="left">{COD_CUENTA_PROTESTO}</td>
											</tr>
											<tr class="encabezado_right">
												<td>Cuenta cobranza judicial:</td>
												<td class="claro" align="left">{COD_CUENTA_COBRANZA}</td>
											</tr>
										</table>
										<p />
										<p />
										<table border="0"> 
											<tr>	
												<td>
													<table width="760" rules="none" border="1" align="left" class="claro">          			  					  		
														<tr class="titulo_tabla">				
															<td colspan="3">CUENTAS</td>
														</tr>
														<tr class="encabezado_center">
															<th width="200">Docto. Pago</th>
															<th width="160">Usar Cta. Cte.</th>
															<th width="400">Cta. Contable</th>
														</tr>
													</table>
												</td>
											</tr>			
											<tr>	
												<td>
													<div style="overflow-x:hidden; overflow-y: auto; height:185;">
														<table width="760" border="1" rules="none" align="left" class="claro" id="CUENTA_TIPO_DOCUMENTO_PAGO">
														<!-- startBlock(CUENTA_TIPO_DOCUMENTO_PAGO) -->
														<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
															<td width="200">{COD_CUENTA_TIPO_DOCUMENTO_PAGO}{COD_TIPO_DOCUMENTO_PAGO}</td>
															<td width="160" align="center">{USAR_CUENTA_CTACTE}</td>
															<td width="400">{COD_CUENTA_CONTABLE}</td>
														</tr>
														<!-- endBlock(CUENTA_TIPO_DOCUMENTO_PAGO) -->
													</table>
													</div>	
												<td>
											</tr>	
											<tr>
												<td>
												</td>
											</tr>
										</table>
									</div>	
								</td>
							</tr>
						</table>
						<table width="1000" border="0" align="center">
				<tr valign="middle">
					  <td width="290" >{WI_BACK}</td>
					  <td align="right">{WI_FIRST}{WI_PREV}</td>
					  <td align="left">{WI_NEXT}{WI_LAST}</td>
					  <td width="290"></td>
				</tr>
			</table> 		
					</td>	
				</tr>  
			</table>
		</td>
	</tr>
</table>		
</form>
</body>
</html>
