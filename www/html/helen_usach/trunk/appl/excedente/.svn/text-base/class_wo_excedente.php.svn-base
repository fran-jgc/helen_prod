<?php
require_once(dirname(__FILE__)."/../../../../commonlib_seven/trunk/php/auto_load.php");
require_once(dirname(__FILE__)."/../../appl.ini");

class wo_excedente_base extends w_output{
    
    const K_EXCEDENTE_EMITIDO = 1;
    
    function __construct()
    {
        $sql = sql_excedente::get_sql('OUTPUT');
        
        parent::__construct('excedente', $sql, $_REQUEST['cod_item_menu']);
        
        //formato numeros
        $this->dw->add_control(new static_num('RUT'));
        $this->dw->add_control(new static_num('MONTO_EXCEDENTE'));
        
        // headers
        $COD_EXCEDENTE = new header_num('COD_EXCEDENTE', 'COD_EXCEDENTE', 'N° Excedente');
        $RUT = new header_rut('RUT', 'D', 'Rut');
        $NOMBRE = new header_text('NOMBRE', 'NOMBRE', 'Nombre');
        $APELLIDO_PATERNO = new header_text('APELLIDO_PATERNO', 'APELLIDO_PATERNO', 'Apellido Paterno');
        $APELLIDO_MATERNO = new header_text('APELLIDO_MATERNO', 'APELLIDO_MATERNO', 'Apellido Materno');
        $MONTO_EXCEDENTE = new header_num('MONTO_EXCEDENTE', 'MONTO_EXCEDENTE', 'Monto Excedente $');
        $sql_estado_excedente = sql_excedente::get_sql('DD_COD_ESTADO_EXCEDENTE');
        $NOM_ESTADO_EXCEDENTE = new header_drop_down('NOM_ESTADO_EXCEDENTE', 'E.COD_ESTADO_EXCEDENTE', 'Estado Excedente', $sql_estado_excedente);
        $FECHA_EGRESO = new header_date('FECHA_EGRESO', 'FECHA_EGRESO', 'Fecha Egreso');
        $COD_INGRESO = new header_num('COD_INGRESO', 'AI.COD_INGRESO', 'N° Ingreso');
        
        $this->add_header($COD_EXCEDENTE);
        $this->add_header($RUT);
        $this->add_header($NOMBRE);
        $this->add_header($APELLIDO_PATERNO);
        $this->add_header($APELLIDO_MATERNO);
        $this->add_header($MONTO_EXCEDENTE);
        $this->add_header($NOM_ESTADO_EXCEDENTE);
        $this->add_header($FECHA_EGRESO);
        $this->add_header($COD_INGRESO);
        
        //$header->valor_filtro = self::K_EXCEDENTE_EMITIDO;
        $this->make_filtros();
    }
}
// Se separa por UNIVERSIDAD
$file_name = dirname(__FILE__)."/".K_CLIENTE."/class_wo_excedente.php";
if (file_exists($file_name))
    require_once($file_name);
    else {
        class wo_excedente extends wo_excedente_base {
            function __construct() {
                parent::__construct();
            }
        }
    }
    ?>