<Report>
	<Font name="Arial" size="16" style="B" id="ArialBoldBigB" red="0" green="0" blue="128"/>
	<Font name="Arial" size="13" style="B" id="ArialBoldBig"/>
	<Font name="Arial" size="9" style="B" id="ArialBold"/>
	<Font name="Arial" size="9" style="B" id="ArialBoldBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="9" style="" id="Arial"/>
	<Font name="Arial" size="7" style="" id="ArialSmall"/>
	<Font name="Arial" size="7.5" style="" id="ArialSmallBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="8.5" style="" id="ArialItem"/>
	<Font name="Arial" size="9" style="B" id="ArialBoldBlueItem" red="0" green="0" blue="128"/>
	
	<PageHeader>	
		<Cell text="" width="10%"/>
		<Cell text="{str_familia}" height="20" width="60%" font="ArialBoldBig" newline="1"/>
		<Cell text="" width="10%"/>
		<Cell text="{str_universidad}" height="12" width="60%" font="ArialBoldBig"  newline="1"/>	
		<Cell text="" newline="1"/>		
		<Cell text="PAG. {SectionPageNumber}/{snb}" align="R" font="ArialSmall" newline="1" />
		<Cell text="EXCEDENTE" width="100%" align="C" newline="1" font="ArialBoldBigB"/>
		<Cell text="" border="B" newline="1" height="1" redl="199" greenl="199" bluel="199"/>
		<Cell text="" height="4" newline="1"/>
	</PageHeader>
	<Content font="Arial">
		<Cell text="" width="11%" border="" align="C" font="ArialItem"/>
	</Content>
	<Group local="COD_EXCEDENTE">
		<GroupHeader>	
			<Cell text="" newline="1"/>		
			<Cell text="" height="1" newline="1" />			
			<Cell height="4" newline="1"/>	
			<Cell text="Nº Excedente  :" width="20%" align="L" font="ArialBoldBlue"/>
			<Cell text="{COD_EXCEDENTE}" width="27%" border="B" align="L" font="Arial" redl="192" greenl="192" bluel="192"/>
			<Cell text="" width="2%"/>
			<Cell text="Fecha         :" width="15%" align="L" font="ArialBoldBlue"/>
			<Cell text="{FECHA_EXCEDENTE}" width="27%" border="B" align="L" font="Arial" redl="192" greenl="192" bluel="192" newline="1"/>
					
			<Cell text="Nombre           :" width="20%" align="L" font="ArialBoldBlue"/>
			<Cell text="{NOMBRE}" width="27%" border="B" font="Arial" redl="192" greenl="192" bluel="192" />
			<Cell text="" width="2%"/>
			<Cell text="Rut  	         :" width="15%" align="L" font="ArialBoldBlue"/>
			<Cell text="{RUT} - {DIG_VERIF}" width="27%" border="B" align="L"  font="Arial" redl="192" greenl="192" bluel="192" newline="1"/>
			
			<Cell text="Codigo Abono     :" width="20%" font="ArialBoldBlue"/>
			<Cell text="{COD_ABONO}" width="27%" border="B" align="L"  font="Arial" redl="192" greenl="192" bluel="192"/>
			<Cell text="" width="2%"/>
			<Cell text="Monto            :" width="15%" align="L" font="ArialBoldBlue"/>
			<Cell text="{MONTO_EXCEDENTE}" width="27%" border="B" align="L" format="N0,."  font="Arial" redl="192" greenl="192" bluel="192" newline="1" />
			
			
			
			<Cell text="Estado Excedente  :" width="20%" align="L" font="ArialBoldBlue" />
			<Cell text="{NOM_ESTADO_EXCEDENTE}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" />
			<Cell text="" width="2%"/>
			<Cell text="Fecha Egreso       :" width="15%" align="L" font="ArialBoldBlue" />
			<Cell text="{FECHA_EGRESO}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" newline="1"/>
			
				<Cell text="Nro. Cheque    :" width="20%" align="L" font="ArialBoldBlue" />
			<Cell text="{NRO_CHEQUE}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" />
			<Cell text="" width="2%"/>
			<Cell text="Usuario Egreso  :" width="15%" align="L" font="ArialBoldBlue" />
			<Cell text="{NOM_USUARIO}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" newline="1"/>
			
			<Cell text="Codigo Comprobante :" width="20%" align="L" font="ArialBoldBlue" />
			<Cell text="{COD_COMPROBANTE}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" />
			<Cell text="" width="2%"/>
			<Cell text="Cta Cte			:" width="15%" align="L" font="ArialBoldBlue" />
			<Cell text="{NOM_CUENTA_CORRIENTE}" width="27%" align="L" border="B" font="Arial" redl="192" greenl="192" bluel="192" newline="1"/>
			
			<Cell text="" newline="1"/>
				
			
		</GroupHeader>
	</Group>
</Report>