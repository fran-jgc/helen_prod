alter function f_valida_moneda()
returns varchar(200)
as
BEGIN
	DECLARE
			@vl_current_date DATETIME
			,@ve_cod_moneda numeric
			,@vl_string  varchar(200)
			,@vl_count numeric
			,@ve_simbolo varchar(10)
			,@vl_tiene_moneda numeric
	
	set @vl_tiene_moneda = 0
	set @vl_current_date = convert(date, getdate(),103)
	
	select	@vl_count = count(*) 
	from	VALOR_MONEDA where cod_moneda <> 1
	and		convert(date,FECHA_VALOR_MONEDA,103)  = @vl_current_date
	
	if(@vl_count > 0)
		set @vl_string = '0'
		
	ELSE
	BEGIN --***
		set @vl_string = 'Señor Usuario: El valor moneda del presente mes, no esta ingresado.\nIngrese valor moneda por favor para: '
		
	
	DECLARE C_MONEDA CURSOR FOR
		select cod_moneda, simbolo
		from moneda 
		where cod_moneda <> 1
	
	OPEN C_MONEDA 
	FETCH C_MONEDA INTO @ve_cod_moneda,@ve_simbolo
	WHILE @@FETCH_STATUS = 0 BEGIN
	
	select	@vl_count = count(*) 
	from	VALOR_MONEDA 
	where	COD_MONEDA = @ve_cod_moneda 
	  AND	convert(date,FECHA_VALOR_MONEDA,103)  = @vl_current_date
		
	if(@vl_count = 0)BEGIN
		set @vl_tiene_moneda = 1
		set @vl_string = @vl_string + @ve_simbolo + ', ' 
	END	

	FETCH C_MONEDA INTO @ve_cod_moneda,@ve_simbolo
	END
	CLOSE C_MONEDA
	DEALLOCATE C_MONEDA
	END --***
	if (@vl_tiene_moneda = 1)
		set @vl_string = @vl_string + SUBSTRING(', ',0,1);
	return 	@vl_string;
	
END