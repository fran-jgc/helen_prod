<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />
<script charset="utf-8" src="anula_abono.js" type="text/javascript"></script>
<style type="text/css">
<!--
.Estilo1 {
	color: #FF0000;
	font-weight: bold;
}

.Estilo2 {
	color: #993300;
	font-weight: bold;
	align: right;
}
-->
</style>


{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js"
	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input"
	enctype="multipart/form-data"><input name="wi_hidden"
	id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu"
			style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0">
			<tr>
				<td>
				<table width="520" border="0">
					<tr>
						<td height="100%">
						<div class="titulo_central">{WI_RUTA_MENU}</div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}
						</font></div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}
						</font></div>
						</td>
					</tr>
				</table>
				</td>
				<td width="68"></td>
				<td width="68">{WI_PRINT}</td>
				<td width="68">{WI_DELETE}</td>
				<td width="68">{WI_NO_SAVE}</td>
				<td width="68">{WI_SAVE}</td>
				<td width="68">{WI_MODIFY}</td>
			</tr>
		</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0" align="center">
			<tr>
				<td height="95">
				<table width="1015" border="0" align="center">
					<tr valign="top">
						<td>

						<div id="TabbedPanels1" class="TabbedPanels">
						<ul class="TabbedPanelsTabGroup">
							<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_153005}">Anular Abono</li>
						</ul>

						<div style="height:500px;" class="TabbedPanelsContentGroup"><!--INI ABONO-->
						<div class="TabbedPanelsContent">
						<table width="1000" border="1" rules="none" align="center">
							<tr class="titulo_tabla">
								<td colspan="6">DEUDA</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Rut:</td>
								<td width="162" class="claro" align="left">{RUT}{RUT_H}-{DIG_VERIF}{EXISTE}</td>
								<td width="166">Nombre:</td>
								<td class="claro" align="left" colspan="3">{NOMBRE}{COD_DEUDOR_H}</td>
							</tr>
							<tr class="encabezado_right">
								<td >Tipo Deuda:</td>
								<td class="oscuro" align="left">{COD_DEUDA_DD}</td>
								<td>Nº Deuda:</td>
								<td width="167" class="oscuro" align="left">{COD_DEUDA}</td>
								<td width="166">Moneda:</td>
								<td width="168" class="oscuro" align="left">{SIMBOLO}</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Año Cuota:</td>
								<td class="claro" align="left">{COD_PLAN_PAGO_PP}</td>
								<td>Nº Cuota:</td>
								<td  class="claro" align="left">{NRO_CUOTA}</td>
								<td>Saldo Cuota:</td>
								<td  class="claro" align="left">{SALDO_CUOTA}</td>
							</tr>
						</table>
						<p />
						<table width="1000" rules="none" border="1" align="center" class="claro">
							<tr class="encabezado_center">
								<td width="10%">Nº Abono</td>
								<td width="10%">Origen Pago</td>
								<td width="10%">Fecha Abono</td>
								<td width="10%">Monto Capital</td>
								<td width="12%">Interés Normal</td>
								<td width="10%">Interés Penal</td>
								<td width="10%">Total UTM</td>
								<td width="10%">Total Abono $</td>
								<td width="9%">Anular</td>
								<td width="9%">A Excedente</td>
							</tr>
						</table>
						<div style="overflow-x:hidden; overflow-y:auto; height:125; margin-top:-1em;">
						<table width="1000" rules="none" border="1" align="center" class="claro" id="ABONO">
							<!-- startBlock(ABONO) -->	
							<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
								<td width="10%" align="center">{COD_ABONO}</td>
								<td width="10%" align="left">{NOM_ORIGEN_PAGO}</td>
								<td width="10%" align="center">{FECHA_ABONO}</td>
								<td width="10%" align="right">{MONTO_CAPITAL}</td>
								<td width="12%" align="right">{MONTO_INTERES}</td>
								<td width="10%" align="right">{MONTO_MULTA}</td>
								<td width="10%" align="right">{MONTO_MONEDA}</td>
								<td width="10%" align="right">{MONTO_PESOS}</td>
								<td width="9%" align="center">{ANULA_ABONO}</td>
								<td width="9%" align="center">{ENVIAR_A_EXCEDENTE}</td>
							</tr>
							<!-- endBlock(ABONO) -->
						</table>
						</div>
						<p />
						<table width="1000" border="1" rules="none" align="center">
							<tr class="titulo_tabla">
								<td colspan="6">DATOS ANULACIÓN</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Nº Anulación:</td>
								<td width="166"class="claro" align="left">{COD_ANULA_ABONO}</td>
								<td width="166">Fecha Registro:</td>
								<td class="claro" align="left">{FECHA_ANULA_ABONO}</td>
								<td width="166">Usuario:</td>
								<td class="claro" align="left">{NOM_USUARIO}</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Cod. Comprobante:</td>
								<td class="oscuro" align="left" colspan="5">{COD_COMPROBANTE}</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Observaciones:</td>
								<td class="claro" align="left" colspan="5">{OBS}</td>
							</tr>
						</table>
						</div>
						<!--FIN ABONO--></div>
						<!--FIN TabbedPanelsContentGroup--></div>
						<!--FIN TabbedPanels--></td>
					</tr>
				</table>
				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</form>
<script type="text/javascript">
<!--
var TabbedPanels1 = new Spry.Widget.TabbedPanels("TabbedPanels1");
//-->
</script>
</body>
</html>