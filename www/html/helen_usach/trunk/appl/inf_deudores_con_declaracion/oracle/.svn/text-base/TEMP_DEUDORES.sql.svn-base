CREATE GLOBAL TEMPORARY TABLE TEMP_DEUDORES
  (RUT                    VARCHAR2(20)
  ,NOMBRE                 VARCHAR2(100)
  ,APELLIDO_PATERNO       VARCHAR2(100)
  ,APELLIDO_MATERNO       VARCHAR2(100)
  ,DIRECCION              VARCHAR2(100)
  ,NOM_COMUNA             VARCHAR2(100)
  ,NOM_CIUDAD             VARCHAR2(100)
  ,TELEFONO               VARCHAR2(100)
  ,EMAIL                  VARCHAR2(100)
  ,FECHA_INGRESO          DATE
)
ON COMMIT DELETE ROWS;