create global temporary table TEMP_DEUDORES_CONDONADOS
  (COD_CONDONACION        NUMBER 
  ,FECHA_CONDONACION      DATE 
  ,RUT							      VARCHAR2(20)
  ,NOMBRE                 VARCHAR2(100)
  ,APELLIDO_PATERNO       VARCHAR2(100)
  ,APELLIDO_MATERNO       VARCHAR2(100)
  ,NOM_TIPO_CONDONACION   VARCHAR2(100)
  ,MONTO_CONDONACION      NUMBER
  ,TOTAL_MONTO_CONDONACION NUMBER
)
on commit delete ROWS;