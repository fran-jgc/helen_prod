<Report>
	<Font name="Arial" size="7" style="" id="ArialSmall"/>
	<Font name="Arial" size="7" style="" id="ArialSmallBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="17" style="B" id="ArialBoldBigB" red="0" green="0" blue="128"/>
	<Font name="Arial" size="8" style="B" id="ArialBold"/>
	<Font name="Arial" size="8" style="" id="Arial"/>
	<PageHeader>	
		<Cell text="" height="40" newline="1"/>
		<Cell text="{str_fecha_hora}" align="R" font="ArialSmall" newline="1" />
		<Cell text="Pag. {SectionPageNumber}/{snb}" align="R" font="ArialSmall" newline="1" />
		<Cell text="DEUDORES CONDONADOS" width="100%" align="C" newline="1" font="ArialBoldBigB"/>
		<Cell text="{str_filtro}" width="100%" align="C" newline="1" font="ArialSmallBlue"/>
		<Cell text="" height="10" newline="1"/>		
	</PageHeader>
	<Content font="Arial">
		<Cell text="{COD_CONDONACION}" width="12%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{FECHA_CONDONACION}" width="12%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{RUT}" width="12%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{NOMBRE}" width="16%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{APELLIDO_PATERNO}" width="16%" align="l" border="LRTB" font="Arial"/>
		<Cell text="{APELLIDO_MATERNO}" width="16%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{MONTO_CONDONACION}" width="16%" align="R" border="LRTB" format="N0,." font="Arial" newline="1"/>
	</Content>
	<Group>
		<Variable name="cant_reg" function="COUNT"  value="COD_CONDONACION"/>
		<GroupHeader>
			<Cell text="Cantidad de Registros: " width="17%" align="L"  font="ArialBold"/>
			<Cell text="{cant_reg}" width="10%" align="L" font="ArialBold" newline="1"/>
			
			<Cell text="Nº Condonación" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Fecha Condonación" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Rut" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Nombre" width="16%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Paterno" width="16%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Materno" width="16%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Monto" width="16%" align="C" border="LRTB" font="ArialSmallBlue" newline="1"/>
		</GroupHeader>
		<GroupFooter>
			<Cell text="Total:" width="84%" align="R" font="ArialBold"/>	
			<Cell text="{TOTAL_MONTO_CONDONACION}" width="16%"  align="R" border="LRTB" format="N0,." font="ArialBold" newline="1"/>
		</GroupFooter> 
	</Group>
</Report>