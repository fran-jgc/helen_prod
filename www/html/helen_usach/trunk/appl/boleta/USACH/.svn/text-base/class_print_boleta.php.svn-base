		$pdf->SetFont('Helvetica','B',7);
		$pdf->Text($iniX + 240, $iniY + 65,'Señor(a):'.$result	['APELLIDO_PATERNO'].'  '.$result['APELLIDO_MATERNO'].'  '.$result['NOMBRE']);
