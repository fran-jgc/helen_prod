		$pdf->Text($iniX + 112, $iniY + 110,'N° Cuota');
		$pdf->SetFont('Helvetica','',8);
		$pdf->Text($iniX + 122, $iniY + 120, $result['NRO_SUB_BOLETA'].'/'.$result['CANT']);
		$pdf->SetFont('Helvetica','B',7);
		$pdf->Text($iniX + 150, $iniY + 110,'Fecha Vencimiento');
		$pdf->SetFont('Helvetica','',8);
		$pdf->Text($iniX + 160, $iniY + 120,$result['FECHA_VENCTO']);

		$pdf->SetFont('Helvetica','',8);
		$pdf->Text($iniX + 50, $iniY + 100,$result['NOM_UNIVERSIDAD']);
		$pdf->Rect($iniX + 38, $iniY + 140, 180, 130, 'f');
		$pdf->SetFont('Helvetica','B',7);
		$pdf->Text($iniX + 42, $iniY + 150,'Item');
		$pdf->Text($iniX + 120, $iniY + 150,'Monto');
		$pdf->SetFont('Helvetica','',7);
		$pdf->Text($iniX + 42, $iniY + 160,'Subcuota');
		$pdf->Text($iniX + 120, $iniY + 160,number_format($result['MONTO_CAPITAL'], 4, ',', '.'));
		$pdf->Text($iniX + 185, $iniY + 160,$result['SIMBOLO']);

		$pdf->Text($iniX + 42, $iniY + 170,'Interes Normal');
		$pdf->Text($iniX + 120, $iniY + 170,number_format($result['MONTO_INTERES'], 4, ',', '.'));
		$pdf->Text($iniX + 185, $iniY + 170,$result['SIMBOLO']);

		$pdf->Text($iniX + 42, $iniY + 180,'Interes Penal');
		$pdf->Text($iniX + 120, $iniY + 180,number_format($result['MONTO_MULTA'], 4, ',', '.'));
		$pdf->Text($iniX + 185, $iniY + 180,$result['SIMBOLO']);

		$pdf->SetFont('Helvetica','B',7);
		$pdf->Text($iniX + 170, $iniY + 150,'Tipo Moneda');

		
		$pdf->SetFont('Helvetica','B',7);
		$pdf->Text($iniX + 170, $iniY + 235,'Total a Pagar');
		$pdf->Text($iniX + 80, $iniY + 265,'Total');
		$pdf->Text($iniX + 120, $iniY + 265,number_format($result['VALOR_SUB_CUOTA'], 4, ',', '.'));

