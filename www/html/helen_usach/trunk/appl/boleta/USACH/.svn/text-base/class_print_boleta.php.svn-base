		$ceros = 16 - $cuenta_digito;
		$cadena = '';

		for($i = 0; $i < $ceros; $i++){
			$cadena = $cadena.'0';
		}
		$codigo_deudor = $cadena.''.$result['RUT'];
		// Fin de Cï¿½digo 
		
		$bol_final = $result['COD_SUB_BOLETA']; // self::ceros(10, $result['COD_SUB_BOLETA']);
		//Fin Boleta-Sub_boleta 

		//Ceros Codigo Cupon 
