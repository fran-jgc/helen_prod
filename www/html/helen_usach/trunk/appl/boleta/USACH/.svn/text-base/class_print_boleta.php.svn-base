		$pdf->Text($iniX + 40, $iniY + 285,'Valido solo con timbre y firma cajero');
		$pdf->Text($iniX + 40, $iniY + 293,'Comprobante de Pago de Convenio de Recaudación');

		// Menu Derecha
		$pdf->Image(dirname(__FILE__)."/../../../images_appl/".K_CLIENTE."/logo-color.jpg",$iniX + 500,$iniY + 230, $factor * 250, $factor * 350);
		$pdf->Image(dirname(__FILE__)."/../../../images_appl/".K_CLIENTE."/scotiabank.jpg",$iniX + 240,$iniY + 272, $factor * 500, $factor * 90);

