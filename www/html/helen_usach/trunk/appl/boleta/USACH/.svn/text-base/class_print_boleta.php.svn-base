		$cuenta_digito_cupon = strlen($result['NRO_SUB_BOLETA']);
		$cant_ceros_cupon = 3 - $cuenta_digito_cupon;

		for($a = 0; $a < $cant_ceros_cupon; $a++){
			$ceros_cupon = $ceros_cupon.'0';
		}
		$cod_cupon = $ceros_cupon.''.$result['NRO_SUB_BOLETA'].'01';

		$cod_cupon1 = substr($cod_cupon, -3); // Para obtener el codigo del cupï¿½n sin los ceros delanteros para el codigo de barra
		// Fin Script Ceros Codigo Cupon 

		$pdf->Text($iniX + 40, $iniY + 120, $bol_final);
