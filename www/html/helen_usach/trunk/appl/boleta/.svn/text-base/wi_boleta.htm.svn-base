<form action="" method="post" name="input" id="input" enctype="multipart/form-data"><input name="wi_hidden" id="wi_hidden" type="hidden"
	value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="white">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu" style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="white">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="520" border="0">
							<tr>
								<td height="100%">
									<div class="titulo_central">{WI_RUTA_MENU}</div>
								</td>
							</tr>
							<tr>
								<td height="0%">
									<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}</font></div>
								</td>
							</tr>
							<tr>
								<td height="0%">
								<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}</font></div>
								</td>
							</tr>
						</table>
					</td>
					<td width="68">{WI_MODIFY}</td>
					<td width="68">{WI_NO_SAVE}</td>
					<td width="68">{WI_SAVE}</td>
					<td width="136">{WBOLETA_CREA_INGRESO}</td> 
					<td width="136">{WI_PRINT}</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr bgcolor="white">
		<td>
			<table width="1000" border="0" align="center">
				<tr>
					<td height="95">
						<table width="1015" border="0" align="center">
							<tr valign="top">
								<td>
									<div id="TabbedPanels1" class="TabbedPanels">
										<ul class="TabbedPanelsTabGroup">
											<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_150505}">Boleta</li>
											<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_150510}">Sub Boleta</li>
										</ul>
									<div class="TabbedPanelsContentGroup">
									<!--INI BOLETA-->
									<div class="TabbedPanelsContent">
									<table width="1000" align="center">
										<tr>
											<td height="480" valign="top">
												<table width="1000" border="1" rules="none" align="center">
													<tr class="encabezado_right">
														<td width="166">Nº Boleta:</td>
														<td width="166" class="claro" align="left">{COD_BOLETA}{COD_BOLETA_H}{FECHA_HOY_H}</td>
														<td width="166">Fecha:</td>
														<td width="166" class="claro" align="left">{FECHA_BOLETA}</td>
														<td width="166">Usuario:</td>
														<td width="166" class="claro" align="left">{NOM_USUARIO}</td>
													</tr>
												</table>
												<table width="1000" border="1" rules="none" align="center">
													<tr class="titulo_tabla">
														<td colspan="6">DEUDOR</td>
													</tr>
													<tr class="encabezado_right">
														<td width="164">Rut:</td>
														<td width="166" class="claro" align="left">{RUT} - {DIG_VERIF}</td>
														<td width="164">Nombre:</td>
														<td width="504" class="claro" align="left" colspan="3">{NOMBRE}</td>
													</tr>
													<tr class="encabezado_right">
														<td width="166">Tipo Deuda:</td>
														<td width="167" class="oscuro" align="left">{COD_TIPO_DEUDA}</td>
														<td width="166">Nº Deuda:</td>
														<td width="167" class="oscuro" align="left">{COD_DEUDA}{COD_DEUDA_H}{B_COD_PLAN_PAGO}{B_TASA_INTERES_PENAL_H}</td>
														<td width="166">Moneda:</td>
														<td width="168" class="oscuro" align="left">{SIMBOLO}</td>
													</tr>
													<tr class="encabezado_right">
														<td width="166">Año:</td>
														<td width="167" class="claro" align="left">{ANO_COBRO_PP}</td>
														<td width="166">Cuota:</td>
														<td width="167" class="claro" align="left">{NRO_CUOTA_PP}</td>
														<td width="166">Fecha Vencimiento:</td>
														<td width="168" class="claro" align="left">{FECHA_VENCTO_PP}</td>
													</tr>
													<tr class="encabezado_right">
														<td >Boleta Cartera Conocida:</td>
														<td colspan="5" class="oscuro" align="left">{CARTERA_CONOCIDA}</td>
													</tr>
												</table>
												<!--INI DETALLE_PLAN_PAGO-->
												<table width="1000" rules="none" border="1" align="center" id="table_det_pp" style="display:{TABLE_DISPLAY}">
													<tr height="23">
														<td colspan="10" class="titulo_tabla">DETALLE PLAN PAGO</td>
													</tr>
													<tr class="encabezado_center">
														<th width="80">Seleccione Cuota</th>
														<th width="80">Año</th>
														<th width="80">Cuota</th>
														<th width="80">F. Vencto</th>
														<th width="80">Capital UTM</th>
														<th width="80">I. Normal UTM</th>
														<th width="80">I. Penal UTM</th>
														<th width="80">Tot. Saldo UTM</th>
														<th width="80">Tot. Saldo $</th>
														<th width="120">Estado</th>
													</tr>
												</table>
												<div style="overflow-x: hidden; overflow-y: auto; height: 127; margin-top: 0em;">
												<table width="1000" rules="none" border="1" align="center" class="claro" id="DETALLE_PLAN_PAGO" style="display:{TABLE_DISPLAY}">
													<!-- startBlock(DETALLE_PLAN_PAGO) -->
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
														<td width="80" align="center">{COD_PLAN_PAGO}{COD_PLAN_PAGO_H}</td>
														<td width="80" align="center">{ANO_COBRO}</td>
														<td width="80" align="center">{NRO_CUOTA}</td>
														<td width="80" align="center">{FECHA_VENCTO}</td>
														<td width="80" align="center">{SALDO_CAPITAL}</td>
														<td width="80" align="right">{SALDO_INTERES}</td>
														<td width="80" align="right">{SALDO_MULTA}</td>
														<td width="80" align="right">{SALDO_MONEDA}</td>
														<td width="80" align="right">{SALDO_PESOS}</td>
														<td width="120" align="left">{NOM_ESTADO_PLAN_PAGO}{COD_ESTADO_PLAN_PAGO_H}</td>
													</tr>
													<!-- endBlock(DETALLE_PLAN_PAGO) -->
												</table>
												</div>
												<!--FIN DETALLE_PLAN_PAGO-->
												<table width="1000" border="1" rules="none" align="center">
													<tr class="encabezado_center">
														<td width="166"></td>
														<td width="166">Capital UTM</td>
														<td width="166">Interés Normal UTM</td>
														<td width="166">Interés Penal UTM</td>
														<td width="166">Total UTM</td>
														<td width="166">Total Pesos</td>
													</tr>
												</table>
												<table width="1000" border="1" rules="none" align="center" id="SUBCUOTA">
													<!-- startBlock(SUBCUOTA) -->
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}" style="display:{SALDO_DISPLAY}">
														<td width="166" class="encabezado_right">Saldo Seleccionado:</td>
														<td width="166" align="right">{D_RECORD_COD_PLAN_PAGO_H}{D_FECHA_VENCE_PLAN_H}{D_ANO_COBRO_H}{D_SALDO_CAPITAL}</td>
														<td width="166" align="right">{D_SALDO_INTERES}</td>
														<td width="166" align="right">{D_SALDO_MULTA}</td>
														<td width="166" align="right">{D_SALDO_MONEDA}</td>
														<td width="166" align="right">{D_SALDO_PESOS}</td>
													</tr>
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
														<td width="166" class="encabezado_right">Descuento {D_COD_TIPO_DESCUENTO}:</td>
														<td width="166" align="right">{D_DSCTO_CAPITAL}{D_DSCTO_CAPITAL_H}</td>
														<td width="166" align="right">{D_DSCTO_INTERES}{D_DSCTO_INTERES_H}</td>
														<td width="166" align="right">{D_DSCTO_MULTA}{D_DSCTO_MULTA_H}</td>
														<td width="166" align="right">{D_DSCTO_MONEDA}{D_DSCTO_MONEDA_H}</td>
														<td width="166" align="right">{D_DSCTO_PESOS}{D_DSCTO_PESOS_H}</td>
													</tr>
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
														<td width="166" class="encabezado_right">Monto a Pagar:</td>
														<td width="166" align="right">{D_MONTO_CAPITAL}{D_MONTO_CAPITAL_H}</td>
														<td width="166" align="right">{D_MONTO_INTERES}{D_MONTO_INTERES_H}</td>
														<td width="166" align="right">{D_MONTO_MULTA}{D_MONTO_MULTA_H}</td>
														<td width="166" align="right">{D_MONTO_MONEDA}{D_MONTO_MONEDA_H}</td>
														<td width="166" align="right">{D_MONTO_PESOS}{D_MONTO_PESOS_H}</td>
													</tr>
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}" style="display:none">
														<td class="encabezado_right" colspan="4">Total a Pagar</td>
														<td align="right">{D_TOTAL_MONEDA}</td>
														<td align="right">{D_TOTAL_PESOS}</td>
													</tr>
													<!-- endBlock(SUBCUOTA) -->
												</table>
											</td>
										</tr>
									</table>
									<table width="1000" border="0" rules="none" align="center" id="MOROSA">
										<tr id="TR_MOROSA" style="display:{MOROSA_DISPLAY}">
											<td width="166" class="titulo_docto_anulada">Aun Registra Morosa su(s) cuota(s) año(s):{CUOTA_MOROSA}</td>
										</tr>
									</table>
									</div>
									<!--FIN BOLETA-->
									<!-- INICIO SUBCUOTAS -->
									<div class="TabbedPanelsContent">
									<table width="1000" align="center">
										<tr>
											<td height="480" valign="top">
												<table width="1000" border="1" rules="none" align="center">
													<tr class="encabezado_right">
														<td width="166">Nº Boleta:</td>
														<td width="166" class="claro" align="left">{COD_BOLETA}{COD_BOLETA_H}</td>
														<td width="166">Fecha:</td>
														<td width="166" class="claro" align="left">{FECHA_BOLETA}</td>
														<td width="166">Usuario:</td>
														<td width="166" class="claro" align="left">{NOM_USUARIO}</td>
													</tr>
												</table>												
												<table width="1000" border="1" rules="none" align="center">
													<tr class="titulo_tabla">
														<td colspan="6">SUBCUOTA</td>
													</tr>
													<!-- StartBlock(TAB_SUBCUOTA) -->
													<tr class="encabezado_right">							
														<td width="166">1ª Cuota:</td>
														<td width="335" class="claro" align="left">{FECHA_PRIMERA_CUOTA}{FECHA_PRIMERA_CUOTA_H}</td>
														<td width="166" >Cant. de Cuotas:</td>
														<td width="335" class="claro" align="left">{CANT}</td>
													</tr>
													<!-- endBlock(TAB_SUBCUOTA) -->
												</table>	
												<table width="992" border="1" rules="none">
													<tr>
														<td align="left" valign="top">
															<table width="992" rules="none" border="1" align="left">
																<tr class="encabezado_center">
																	<td width="68">Nº</td>
																	<td width="154">F. Vencto.</td>
																	<td width="154">Subcuota UTM</td>
																	<td width="154">I. Normal UTM</td>
																	<td width="154">I. Penal UTM</td>
																	<td width="154">Total UTM</td>
																	<td width="154">Fecha Pago</td>
																</tr>
															</table>
														</td>
													</tr>
													<tr>
														<td align="left" valign="top">
															<div style="overflow-x: hidden; overflow-y: auto; height: 200; margin-top: -0.1em;">
															<table width="992" rules="none" border="1" align="left" class="claro" id="TAB_SUBCUOTA_DETALLE">
																<!-- StartBlock(TAB_SUBCUOTA_DETALLE) -->
																<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
																	<td width="68" align="center">{SC_NRO_SUB_BOLETA}{SC_NRO_SUB_BOLETA_H}{SC_COD_SUB_BOLETA_H}</td>
																	<td width="154" align="center">{SC_FECHA_VENCTO}{SC_FECHA_VENCTO_H}</td>
																	<td width="154" align="right">{SC_MONTO_CAPITAL}{MONTO_CAPITAL_C}{SC_MONTO_CAPITAL_H}</td>
																	<td width="154" align="right">{SC_MONTO_INTERES}{SC_MONTO_INTERES_H}{MONTO_INTERES_C}</td>
																	<td width="154" align="right">{SC_MONTO_MULTA}{SC_MONTO_MULTA_H}{MONTO_MULTA_C}</td>
																	<td width="154" align="right">{SC_TOTAL}{TOTAL_C}</td>
																	<td width="154" align="center">{SC_FECHA_PAGO}{SC_FECHA_PAGO_H}</td>
																</tr>
																<!-- endBlock(TAB_SUBCUOTA_DETALLE) -->
															</table>
															</div>
														</td>
													</tr>
													<tr>
														<td>
															<table width="992" rules="none" border="1" align="left" style="margin-top: -0.1em;">
																<tr class="encabezado_right">
																	<td width="222">TOTAL</td>
																	<td width="154" class="oscuro">{SUM_MONTO_CAPITAL_C}</td>
																	<td width="154" class="oscuro">{SUM_MONTO_INTERES_C}</td>
																	<td width="154" class="oscuro">{SUM_MONTO_MULTA_C}</td>
																	<td width="154" class="oscuro">{SUM_TOTAL_C}</td>
																	<td width="154" class="oscuro"></td>																	
																</tr>
															</table>
														</td>
													</tr>
												</table>										
											</td>
										</tr>
									</table>						
								</div><!--FIN SUBCUOTAS  -->
							</div>
						</div>
						<!--FIN TabbedPanelsContentGroup--></td>
					</tr>
				</table>
				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
