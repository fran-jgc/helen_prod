<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="suspension.js" type="text/javascript"></script>
<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />

<style type="text/css">
<!--
.Estilo1 {
	color: #FF0000;
	font-weight: bold;
}

.Estilo2 {
	color: #993300;
	font-weight: bold;
	align: right;
}
-->
</style>


{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js" 	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input" 	enctype="multipart/form-data"><input name="wi_hidden"	id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu"
			style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0">
			<tr>
				<td>
				<table width="600" border="0">
					<tr>
						<td height="100%">
						<div class="titulo_central">{WI_RUTA_MENU}</div>
						</td>
						<td height="300%" rowspan="3" align="center" id="val" name="val" style="display:{VISIBLE_CAMPO}"><div class="titulo_docto_anulada">DEUDA CON OTRA CARTERA</div></td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}
						</font></div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}
						</font></div>
						</td>
					</tr>
				</table>
				</td>
				<td width="68"></td>

				<td width="68">{WI_PRINT}</td>
				<td width="68">{WI_NO_SAVE}</td>
				<td width="68">{WI_SAVE}</td>
				<td width="68">{WI_MODIFY}</td>
			</tr>
		</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0" align="center">
			<tr>
				<td height="95">
				<table width="1015" border="0" align="center">
					<tr valign="top">
						<td height="530">

						<div id="TabbedPanels1" class="TabbedPanels">
						<ul class="TabbedPanelsTabGroup">
							<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_104005}">Suspensión</li>
						</ul>

						<div class="TabbedPanelsContentGroup">
						<!--INI SUSPENSION-->
						<div class="TabbedPanelsContent">
						<table width="1000" border="1" rules="none" align="center">
							<tr class="titulo_tabla">
								<td colspan="6">SUSPENSION</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Nº Suspensión:</td>
								<td width="166" class="claro" align="left">{COD_SUSPENSION}</td>
								<td width="166">Fecha Registro:</td>
								<td width="166" class="claro" align="left">{FECHA_SUSPENSION}</td>
								<td width="166">Usuario:</td>
								<td width="166" class="claro" align="left">{NOM_USUARIO}</td>
							</tr>
						</table>
						
						<table width="1000" border="1" rules="none" align="center" id="DEUDA">
							<tr class="titulo_tabla">
								<td colspan="6">DEUDA</td>
							</tr>
							<tr class="encabezado_right">
								<td width="166">Rut:</td>
								<td width="164" class="claro" align="left">{RUT} - {DIG_VERIF}{EXISTE}</td>
								<td width="166">Nombre:</td>
								<td width="167" class="claro" align="left">{NOMBRE}{COD_DEUDOR}</td>
								<td width="166">Nº Deuda:</td>
								<td width="168" class="oscuro" align="left">{COD_DEUDA}{COD_DEUDA_H}</td>
							</tr>
						</table>
						<table width="1000" border="1" rules="none" align="center">
							<tr class="encabezado_right">
								<td width="166">Tipo Deuda:</td>
								<td width="167" class="oscuro" align="left">{COD_TIPO_DEUDA}{COD_TIPO_DEUDA_H}</td>
								<td width="166">Año Suspendido:</td>
								<td width="167" class="oscuro" align="left">{ANO_SUSPENSION}{ANO_SUSPENSION_H}</td>
								<td width="166">Estado</td>
								<td width="168" class="oscuro" align="left">{COD_ESTADO_SUSPENSION}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Tipo Suspensión:</td>
								<td class="claro" align="left">{COD_TIPO_SUSPENSION}</td>
								<td>Cantidad Suspensiones</td>
								<td class="claro" align="left">{CANT_SUSPENSIONES}{MAX_SUSP_X_TIPO}</td>
								<td>Fecha del Tramite:</td>
								<td class="claro" align="left">{FECHA_SOLICITUD_TRAMITE}</td>
								<td class="claro"></td>
							</tr>
							<tr class="encabezado_right">
								<td>Usuario Confirma:</td>
								<td class="oscuro" align="left">{NOM_USUARIO_CONFIRMA}{COD_USUARIO_CONFIRMA}</td>
								<td>Fecha Confirma:</td>
								<td class="oscuro" align="left">{FECHA_CONFIRMA_NO_ING}</td>
								<td>Nº Comprobante:</td>
								<td class="oscuro" align="left">{COD_COMPROBANTE}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Observaciones:</td>
								<td colspan="5" class="oscuro" align="left">{OBS}
								</td>
							</tr>
						</table>
						<!--FIN SUSPENSION-->
				</div>
				<!--FIN TabbedPanelsContentGroup-->
				</div>
				<!--FIN TabbedPanels--></td>
			</tr>
		</table>


		<table width="1000" border="0" align="center">
			<tr valign="middle">
				<td width="290">{WI_BACK}</td>
				<td align="right">{WI_FIRST}{WI_PREV}</td>
				<td align="left">{WI_NEXT}{WI_LAST}</td>
				<td width="290"></td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</td>
</tr>
</table>
</form>
<script type="text/javascript">
<!--
var TabbedPanels1 = new Spry.Widget.TabbedPanels("TabbedPanels1");
//-->
</script>
</body>
</html>