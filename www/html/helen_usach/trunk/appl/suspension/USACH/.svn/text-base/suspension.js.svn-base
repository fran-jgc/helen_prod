function validate() {
	var tipo_deuda = document.getElementById('COD_TIPO_DEUDA_H_0').value;
	var K_TIPO_SUS_MAGISTER = 1;
	var K_TIPO_SUS_DOCTORAD = 2;
	var K_TIPO_SUS_PREGRADO = 3;
	var K_TIPO_SUS_CESANTIA = 4;
	
	if(tipo_deuda != 'CSR'){
		var tipo_suspension = document.getElementById('COD_TIPO_SUSPENSION_0').value;
		if(tipo_suspension == K_TIPO_SUS_PREGRADO){
			document.getElementById('COD_TIPO_SUSPENSION_0').focus();
			alert('La deuda '+tipo_deuda+' no puede tener tipo suspensión: PROGRAMA DE PREGRADO');
			return false;
		}
	}
	
	// valida que el primer estado que se ponga sea solicitado
	var cod_deuda = document.getElementById('COD_DEUDA_H_0').value;
	var cod_deudor = document.getElementById('COD_DEUDOR_0').value;
	var tipo_suspension = document.getElementById('COD_TIPO_SUSPENSION_0').value;
	var max_susp_x_tipo = document.getElementById('MAX_SUSP_X_TIPO_0').value
	var ajax = nuevoAjax();
	ajax.open("GET", "ajax_max_susp_x_deuda.php?cod_deuda=" + cod_deuda + "&cod_deudor=" + cod_deudor, false);
	ajax.send(null);
	resp = ajax.responseText;
	
	if(tipo_suspension == K_TIPO_SUS_MAGISTER || tipo_suspension == K_TIPO_SUS_DOCTORAD){
		if (resp >= max_susp_x_tipo) {
			alert('Esta Deuda super\u00f3 el n\u00famero m\u00E1ximo de Suspensiones Permitidas. No pueden ingresarse m\u00E1s.');
			return false;
		}
	}else if(tipo_suspension == K_TIPO_SUS_CESANTIA){
		if(tipo_deuda == 'CS' || tipo_deuda == 'CR12' ){
			if (resp >= max_susp_x_tipo) {
				alert('Esta Deuda super\u00f3 el n\u00famero m\u00E1ximo de Suspensiones Permitidas. No pueden ingresarse m\u00E1s.');
				return false;
			}
		}
	}
	
	return true;
}

function f_get_info_deudor() {
	// RESPUESTAS DEL AJAX:
	// O = EL RUT NO EXISTE EN TABLA DEUDOR (PUEDE INGRESARLO)
	// 1 = EL RUT EXISTE
	// ABONO = deuda posee abonos por lo tanto no se puede
	var rut = document.getElementById('RUT_0').value;
	var ano_h = document.getElementById('ANO_SUSPENSION_H_0').value;
	rut = replaceChars(rut);
	
	if(rut != ''){
		
		if(ano_h != ''){
			
		}
		var ajax = nuevoAjax();
		ajax.open("GET", "USACH/ajax_info_deudor.php?rut=" + rut+"&ano="+ano_h, false);
		ajax.send(null);
		var resp = URLDecode(ajax.responseText);
		var lista = resp.split('|');
		if (lista[0] == 'NO_EXISTE_RUT') {
			alert('No existe un Deudor con ese Rut.');
			setea_null_deudor();
			val.style.display = 'none';
			document.getElementById('RUT_0').focus();
		} else if (lista[0] == 'DEUDA_NO_VIG') {
			alert('Deudor no posee deuda(s) Vigente(s).');
			setea_null_deudor();
			val.style.display = 'none';
			document.getElementById('RUT_0').focus();
		}else if (lista[0] == 'NO_TIENE_CUOTA_FIJA') {
			alert("La deuda debe ser re calculada, favor contactar al encargado de informática.");
			document.getElementById('RUT_0').focus();
			setea_null_deudor();
			val.style.display = 'none';
		}else if (lista[0] == 'DEUDA_NO_CS_CSR') {
			alert('Deudor no posee CS , CSR ,CR12 o CRI.');
			setea_null_deudor();
			val.style.display = 'none';
			document.getElementById('RUT_0').focus();
		}else if (lista[0] == 'SUSPENSION_DEUDA_RECHAZADA') {
			alert("La deuda fue Registrada en Suspension Cod. "+lista[5]+", Estado: "+lista[6]);
			muestra_datos(lista);
			f_deuda_otra_cartera(rut);
		} else if (lista[0] == 'SUSPENSION_DEUDA_NUEVA') {
			muestra_datos(lista);		
			f_deuda_otra_cartera(rut);	
		} else if (lista[0] == 'NO_EXISTE_CUOTA_A_SUSPENDER') {
			document.getElementById('ANO_SUSPENSION_H_0').value = null;
			document.getElementById('ANO_SUSPENSION_0').value = null;
			alert('El deudor ingresado ya tiene la cuota año "'+ano_h+'" suspendida.');
		} else if (lista[0] == 'VARIAS_DEUDAS') {
			//FALTA IMPLEMENTAR CUANDO SON VARIAS DEUDAS A SUSPENDER		
		}
		
	}else{
		alert("Debe ingresar un rut.");
		document.getElementById('RUT_0').focus();
		setea_null_deudor();
		val.style.display = 'none';
	}
}

/*Esta funcion:
al momento de ingresar el rut, verifica que de cartera proviene
si es cartera defecto: no muestra leyenda
si es otra cartera: despliega leyenda de que pertenece a otra cartera*/
function f_deuda_otra_cartera(ve_rut){
	var rut = ve_rut;
	var ajax = nuevoAjax();
	ajax.open("GET", "USACH/ajax_get_deuda_otra_cartera.php?rut="+rut, false);
	ajax.send(null);
	var resp = URLDecode(ajax.responseText);
	var lista = resp.split('|');
	var val = document.getElementById('val');
	if(lista[0] == 'DEUDA_OTRA_CARTERA'){
		val.style.display = '';	
	}
	else{
		val.style.display = 'none';
	}
}