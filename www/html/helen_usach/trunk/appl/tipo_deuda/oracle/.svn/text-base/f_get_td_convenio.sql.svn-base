CREATE OR REPLACE FUNCTION f_get_td_convenio(VE_COD_TIPO_DEUDA  IN VARCHAR, ve_ano IN NUMBER)

RETURN NUMBER
AS
   VS_CONVENIO     NUMBER;
BEGIN
  BEGIN
    SELECT CB.CONVENIO

    INTO VS_CONVENIO

    FROM	  TIPO_DEUDA TD, CONVENIO_BDD CB
		WHERE	  TD.COD_TIPO_DEUDA = VE_COD_TIPO_DEUDA
      AND      CB.ANO = VE_ANO
		  AND TD.COD_TIPO_DEUDA = CB.COD_TIPO_DEUDA;


  RETURN VS_CONVENIO;
  END;
END;
/