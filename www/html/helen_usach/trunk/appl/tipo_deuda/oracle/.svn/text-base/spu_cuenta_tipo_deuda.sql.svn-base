CREATE OR REPLACE PROCEDURE spu_cuenta_tipo_deuda
(
    VE_OPERACION               IN       VARCHAR
   ,VE_COD_CUENTA_TIPO_DEUDA   IN       NUMERIC:=NULL
   ,VE_COD_TIPO_DEUDA          IN       VARCHAR2
   ,VE_COD_CONCEPTO_CUENTA     IN       NUMERIC
   ,VE_COD_CUENTA_CONTABLE     IN       NUMERIC

)
AS
BEGIN
   IF (VE_OPERACION = 'INSERT')
   THEN
      INSERT INTO CUENTA_TIPO_DEUDA
      (           COD_CUENTA_TIPO_DEUDA
                  , COD_TIPO_DEUDA
                  , COD_CONCEPTO_CUENTA
                  , COD_CUENTA_CONTABLE
      )
      VALUES (
       cuenta_tipo_deuda_sq.NEXTVAL
      , VE_COD_TIPO_DEUDA
      , VE_COD_CONCEPTO_CUENTA
      , VE_COD_CUENTA_CONTABLE
      );

   ELSIF (VE_OPERACION = 'UPDATE') THEN
         UPDATE CUENTA_TIPO_DEUDA
         SET   COD_TIPO_DEUDA       = VE_COD_TIPO_DEUDA
             , COD_CONCEPTO_CUENTA  = VE_COD_CONCEPTO_CUENTA
             , COD_CUENTA_CONTABLE  = VE_COD_CUENTA_CONTABLE
         WHERE COD_CUENTA_TIPO_DEUDA= VE_COD_CUENTA_TIPO_DEUDA;
   END IF;


END;
/