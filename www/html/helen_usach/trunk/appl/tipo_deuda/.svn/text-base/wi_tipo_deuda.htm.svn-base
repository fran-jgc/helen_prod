<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="tipo_deuda.js" type="text/javascript"></script>


<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />

<style type="text/css">
<!--
.Estilo1 {
	color: #FF0000;
	font-weight: bold;
}

.Estilo2 {
	color: #993300;
	font-weight: bold;
	align: right;
}
-->
</style>


{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js"
	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input"
	enctype="multipart/form-data"><input name="wi_hidden"
	id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu"
			style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0">
			<tr>
				<td>
				<table width="520" border="0">
					<tr>
						<td height="100%">
						<div class="titulo_central">{WI_RUTA_MENU}</div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}
						</font></div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}
						</font></div>
						</td>
					</tr>
				</table>
				</td>
				<td width="68"></td>

				<td width="68">{WI_PRINT}</td>
				<td width="68"{DISABLE_BUTTON}>{WI_DELETE}</td>
				<td width="68">{WI_NO_SAVE}</td>
				<td width="68">{WI_SAVE}</td>
				<td width="68">{WI_MODIFY}</td>
			</tr>
		</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0" align="center">
			<tr>
				<td height="95">
				<table width="1015" border="0" align="center">
					<tr valign="top">
						<td>

						<div id="TabbedPanels1" class="TabbedPanels">
							<ul class="TabbedPanelsTabGroup">
								<li class="TabbedPanelsTab" tabindex="0">Tipo Deuda</li>
								<li class="TabbedPanelsTab" tabindex="0">Convenio</li>
							</ul>
						<div class="TabbedPanelsContentGroup">
						<!--INI TIPO_DEUDA-->
						<div class="TabbedPanelsContent">
							<table width="1000" border="1" width="30%" rules="none" align="center">
								<tr class="titulo_tabla">				
													<td colspan="4" >DATOS GENERALES</td>
												</tr>
												<tr class="encabezado_right">
													<td width="20%">C&oacute;digo:</td>
													<td width="80%" class="claro" align="left" colspan=3>{COD_TIPO_DEUDA}</td>	
												</tr>
												<tr class="encabezado_right">
													<td>Tipo Deuda:</td>
													<td class="oscuro" align="left" colspan=3>{NOM_TIPO_DEUDA}</td>
												</tr>
												
												<tr class="encabezado_right">
													<td>Familia Deuda:</td>
													<td class="claro" align="left" colspan=3>{COD_FAMILIA_DEUDA}</td>
												</tr>
												<tr class="encabezado_right">
													<td>Tipo Moneda:</td>
													<td class="oscuro" align="left" colspan=3>{COD_MONEDA}</td>
												</tr>
												<tr class="encabezado_right">
													<td width="20%">Cantidad Cuota:</td>
													<td class="claro" align="left" width="30%">{CANT_CUOTA}</td>
													<td width="20%">Monto No Cobrable {SIMBOLO}:</td>
													<td class="claro" align="left" width="30%">{MONTO_NO_COBRABLE}</td>
												</tr>
												<tr class="encabezado_right">
													<td width="20%">Periodo Gracia:</td>
													<td class="oscuro" align="left" width="30%">{PERIODO_GRACIA} Meses</td>
													<td width="20%">Interés Penal:</td>
													<td class="oscuro" align="left">{TASA_INTERES_PENAL}</td>
												</tr>
												<tr class="encabezado_right">
													<td width="20%">Interés Crédito:</td>
													<td class="claro" align="left" colspan=3 width="30%">{TASA_INTERES_CREDITO}</td>
												</tr>
							</table>
							<p />
							<p />
							<table width="1000" border="1" rules="none">
								<tr>
									<td>
									<table width="1000" border="1" rules="none" align="center">
										<tr class="titulo_tabla">				
													<td  >Cuentas Contables</td>
												</tr>
												<tr class="encabezado_center">
													<td width="25%">Concepto:</td>
													<td width="75%">Cuenta Contable:</td>
												</tr>
									</table>
									<div style="overflow-x: hidden; overflow-y: auto; height: 195; margin-top: 0em;">
										<table width="1000" border="1" rules="none" align="center" ID="CUENTA_CONTABLE">
											<!-- startBlock(CUENTA_CONTABLE) -->
											<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
												<td align="left" width="25%">{NOM_CONCEPTO_CUENTA}{COD_CONCEPTO_CUENTA}{COD_TIPO_DEUDA_H}{COD_CUENTA_TIPO_DEUDA}{NUEVO}</td>
													<td align="left" width="75%">{COD_CUENTA_CONTABLE}</td>
											</tr>
											<!-- endBlock(CUENTA_CONTABLE) -->
										</table>
									</div>
									</td>
								</tr>
							</table>
						<!--FIN TIPO_DEUDA-->
						</div>
						<!--INI CONVENIO-->
						<div class="TabbedPanelsContent">
							<table width="1000" border="1" rules="none" align="center">
								<tr class="titulo_tabla">				
													<td colspan="4" >DATOS GENERALES</td>
												</tr>
												<tr class="encabezado_right">
													<td width="20%">Convenio Futuro</td>
													<td width="80%" class="claro" align="left" colspan=3>{CONVENIO_FUTURA}</td>	
												</tr>
												<tr class="encabezado_right">
													<td>Convenio no Exigible:</td>
													<td class="oscuro" align="left" colspan=3>{CONVENIO_NO_EXIGIBLE}</td>
												</tr>
												
												<!--<tr class="encabezado_right">
													<td>Convenio Pago:</td>
													<td class="claro" align="left" colspan=3>{CONVENIO_PRONTO_PAGO}</td>
												</tr> se oculta?=> VM-->											
							</table>
							<p />
							<p />
							<table width="400" border="1" ; rules="none">
								<tr class="titulo_tabla">
									<td colspan="6">CONVENIO BANCO DEL DESARROLLO</td>
								</tr>
								<tr>									
									<td>
									<table width="350" border="1" rules="none" align="left">
										<tr class="encabezado_center">
											<td width="25%">Año</td>
											<td width="25%">Convenio</td>
											<td width="25%">Con Declaración</td>																								
											<td width="25%">Eliminar</td>
										</tr>
									</table>
									<div style="overflow-x:hidden; overflow-y:auto; width:400;height:263;">
										<table width="350" rules="none" border="1" align="left" class="claro" id="CONVENIO">
											<!-- startBlock(CONVENIO) -->
											<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
												<td width="25%" align="center">{ANO}{COD_TIPO_DEUDA_CON_H}{COD_CONVENIO_BDD_H}</td>
												<td width="25%" align="center">{CONVENIO}</td>
												<td width="25%" align="center">{CON_DECLARACION}</td>																								
												<td width="25%" align="center">{ELIMINAR_CONVENIO}</td>
											</tr>
											<!-- endBlock(CONVENIO) -->
										</table>
							 		</div>
									<table width="400" rules="none" border="0" align="left" class="claro">		
										<tr class="claro">
											<td align="left">{AGREGAR_CONVENIO}</td>
										</tr>
									</table>
								</td>
								<!--FIN CONVENIO-->
							</tr>																				
						</table>
						</div>
					</div>
				</div>
						
						
						
						
						</td>
					</tr>
				</table>


				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</form>
<script type="text/javascript">
<!--
var TabbedPanels1 = new Spry.Widget.TabbedPanels("TabbedPanels1");
//-->
</script>
</body>
</html>