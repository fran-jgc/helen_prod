<?php
require_once(dirname(__FILE__)."/../../../../../commonlib_seven/trunk/php/auto_load.php");

class wp_calculo_cuota_cs extends wp_calculo_cuota_cs_base {
	const K_CALCULO_CUOTA_CS = 9;
	function __construct() {
		$sql = "select	 'N' CON_DJ
							,'N' SIN_DJ
					from dual";
		
   		$this->dws['dw_con_sin_DJ'] = new datawindow($sql);
   		$this->dws['dw_con_sin_DJ']->add_control(new edit_check_box('CON_DJ', 'S', 'N', 'Con DJ'));
   		$this->dws['dw_con_sin_DJ']->add_control(new edit_check_box('SIN_DJ', 'S', 'N', 'Sin DJ'));
   		$this->dws['dw_con_sin_DJ']->insert_row();
   		
   		parent::__construct('calculo_cuota_cs', $_REQUEST['cod_item_menu'], self::K_CALCULO_CUOTA_CS);

   	}
	function redraw() {
		$this->nom_template = "USACH/wp_calculo_cuota_cs.htm";
		parent::redraw();
	}
	function redraw_dws(&$temp) {
		parent::redraw_dws($temp);
		$this->dws['dw_con_sin_DJ']->habilitar($temp, true);
	}
	/*function make_cmd_sp($cod_ejecucion_proceso) {
		$this->dws['dw_con_sin_DJ']->get_values_from_POST();
		$con_DJ = $this->dws['dw_con_sin_DJ']->get_item(0, 'CON_DJ');
		$sin_DJ = $this->dws['dw_con_sin_DJ']->get_item(0, 'SIN_DJ');
		return "spp_cuota_cs ($cod_ejecucion_proceso, '$con_DJ', '$sin_DJ')";
	}*/
	function inicia_proceso(){
	    $cod_usuario= $this->cod_usuario;
	    $cod_proceso = 9;
	    
	    $this->dws['dw_con_sin_DJ']->get_values_from_POST();
	    $con_DJ = $this->dws['dw_con_sin_DJ']->get_item(0, 'CON_DJ');
	    $sin_DJ = $this->dws['dw_con_sin_DJ']->get_item(0, 'SIN_DJ');
	    
	    $param = "'NEW'
				,null
				,$cod_proceso
				,$cod_usuario
				,null
				,null";
	    $db = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
	    $sp="spu_ejecucion_proceso";
	    if ($db->EXECUTE_SP($sp, $param)){
	        $COD_EJECUCION_PROCESO =$db->GET_IDENTITY('ejecucion_proceso');
	    }
	    else{
	        $COD_EJECUCION_PROCESO = "null";
	    }
	    
	    $this->redraw();
	    ob_start();
	    for ($i=1; $i<=3; $i++) {
	        print str_pad('',4096); //para que funcione en todos los navegadores
	        ob_end_flush();
	        ob_flush();
	        flush();
	        ob_start();
	        Sleep(1);
	        print "<script>document.getElementById('img_loader').style.display = '';</script>";
	    }
	    ob_end_flush();
	    
	    $error = false;
	    $conn = oci_connect(K_USER, K_PASS, K_SERVER);
	    $stid = oci_parse($conn, "begin spp_cuota_cs ($COD_EJECUCION_PROCESO, '$con_DJ', '$sin_DJ'); end;");
	    if (oci_execute($stid)){
	        print "<script>document.getElementById('img_loader').style.display = 'none';</script>";
	        print "<script>document.getElementById('fin_proceso').style.display = '';</script>";
	        oci_free_statement($stid);
	        oci_close($conn);
	    }
	    else{
	        print "<script>document.getElementById('img_loader').style.display = 'none';</script>";
	        print "<script>document.getElementById('fin_proceso').style.display = 'none';</script>";
	        $error = true;
	        ob_end_flush();
	        $e = oci_error($stid);
	        $error_code= $e['code'];
	        $error_sqltext= $e['sqltext'];
	        
	        $this->redraw();
	        $this->alert('Error Oracle texto sql ejecutado: '.$error_sqltext);
	        
	        oci_free_statement($stid);
	        oci_close($conn);
	    }
	}
	
	function procesa_event() {
	    if(isset($_POST['b_procesar'])){
	        $this->inicia_proceso();
	    }
	    else
	        parent::procesa_event();
	}
	
}
?>