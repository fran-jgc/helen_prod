CREATE GLOBAL TEMPORARY TABLE TEMP_DEUDORES_MOROSOS
  (RUT                    VARCHAR2(20)
  ,NOMBRE                 VARCHAR2(100)
  ,APELLIDO_PATERNO       VARCHAR2(100)
  ,APELLIDO_MATERNO       VARCHAR2(100)
  ,MONTO_MORA             NUMBER
  ,MONTO_MULTA            NUMBER
  ,MONTO_TOTAL            NUMBER
  ,NOM_CARTERA			  VARCHAR2(100)
)
ON COMMIT DELETE ROWS;