DROP TABLE TEMP_DATOS_CONTACTO;
create global temporary table TEMP_DATOS_CONTACTO
  ( RUT							      VARCHAR2(20)
  ,DIG_VERIF  VARCHAR2(1)
  ,COD_DEUDA              NUMBER
  ,NOMBRES				  VARCHAR2(200)
  ,PATERNO			      VARCHAR2(100)
  ,MATERNO			      VARCHAR2(100)
  ,TIPO_DEUDA		      VARCHAR2(100)
  ,CARTERA				  VARCHAR2(200)
  ,UNIVERSIDAD    		  VARCHAR2(100)
  ,ESTADO_DEUDA    		  VARCHAR2(100)
  ,MONTO_INICIO_COBRO      NUMBER
  ,CANT_CUOTA            NUMBER
  ,SALDO_DEUDA            NUMBER
  ,TELEFONO            VARCHAR2(100)
  ,CELULAR	VARCHAR2(100)
  ,DIRECCION 	VARCHAR2(500)
  ,COMUNA 	VARCHAR2(100)
  ,CIUDAD	VARCHAR2(100)
  ,REGION	VARCHAR2(100)
  ,MAIL	VARCHAR2(300)
  ,AIC 	            NUMBER
)
on commit delete ROWS;
