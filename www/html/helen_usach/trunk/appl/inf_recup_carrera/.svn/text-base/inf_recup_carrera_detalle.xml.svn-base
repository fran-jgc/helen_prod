<Report>
	<Font name="Arial" size="7" style="" id="ArialSmall"/>
	<Font name="Arial" size="7" style="" id="ArialSmallBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="17" style="B" id="ArialBoldBigB" red="0" green="0" blue="128"/>
	<Font name="Arial" size="8" style="B" id="ArialBold"/>
	<Font name="Arial" size="8" style="" id="Arial"/>
	<PageHeader>	
		<Cell text="" height="40" newline="1"/>
		<Cell text="{str_fecha_hora}" align="R" font="ArialSmall" newline="1" />
		<Cell text="Pag. {SectionPageNumber}/{snb}" align="R" font="ArialSmall" newline="1" />
		<Cell text="RECUPERACIÓN POR CARRERA" width="100%" align="C" newline="1" font="ArialBoldBigB"/>
		<Cell text="{str_filtro}" width="100%" align="C" newline="1" font="ArialSmallBlue"/>
		<Cell text="" height="10" newline="1"/>		
	</PageHeader>
	<Content font="Arial">
		<Cell text="{NOM_DEUDOR}" width="34%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{RUT_DEUDOR}" width="6%" align="R" border="LRTB" font="Arial"/>
		<Cell text="{COD_CARRERA}" width="12%" align="R" border="LRTB" font="Arial"/>
		<Cell text="{NOM_CARRERA}" width="12%" align="R" border="LRTB" font="Arial"/>
		<Cell text="{MONTO_ABONO_VIGENTE_UTM}" width="12%" align="R" border="LRTB" format="N0,." font="Arial"/>
		<Cell text="{MONTO_ABONO_VIGENTE_PESOS}" width="12%" align="R" border="LRTB" format="N0,." font="Arial" newline="1"/>
	</Content>
	<Group>
		<Variable name="sum_deuda_utm" function="SUM" value="MONTO_ABONO_VIGENTE_UTM"/>
		<Variable name="sum_abono_pesos" function="SUM" value="MONTO_ABONO_VIGENTE_PESOS"/>
		<GroupHeader>		
			<Cell text="Nombre Deudor" width="34%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Rut" width="6%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Codigo Carrera" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Nombre Carrera" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Recuperacion UTM" width="12%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Recuperacion PESOS" width="12%" align="C" border="LRTB" font="ArialSmallBlue" newline="1"/>
		</GroupHeader>
		<GroupFooter>
			<Cell text="" width="48%" align="R" font="ArialBold"/>
			<Cell text="Totales:" width="12%" align="R" font="ArialBold"/>	
			<Cell text="{sum_deuda_utm}" width="12%"  align="R" border="LRTB" format="N0,." font="ArialBold"/>
			<Cell text="{sum_abono_pesos}" width="12%"  align="R" border="LRTB" format="N0,." font="ArialBold" newline="1"/>
		</GroupFooter>
	</Group>
</Report>