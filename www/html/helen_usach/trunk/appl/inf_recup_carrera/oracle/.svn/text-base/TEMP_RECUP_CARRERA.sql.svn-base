drop table TEMP_RECUP_CARRERA;

create table TEMP_RECUP_CARRERA
  ( COD_CARRERA               NUMBER
    ,NOM_CARRERA              VARCHAR2(100)
    ,CANT_DEUDOR              NUMBER
    ,MONTO_DEUDA_VIGENTE      NUMBER
    ,MONTO_ABONO_VIGENTE      NUMBER
    ,MONTO_ABONO_VENCIDA      NUMBER
    ,MONTO_ABONO_ANTICIPADO   NUMBER
    ,MONTO_ABONO_OTRO         NUMBER
    ,MONTO_TOTAL              NUMBER
	,COD_USUARIO				NUMBER			NULL
	,FECHA_REGISTRO				DATE			NULL
    );

create index IND_T_RECUP_CARR_1 on TEMP_RECUP_CARRERA (NOM_CARRERA asc);
create index IND_T_RECUP_CARR_2 on TEMP_RECUP_CARRERA (COD_USUARIO asc);
