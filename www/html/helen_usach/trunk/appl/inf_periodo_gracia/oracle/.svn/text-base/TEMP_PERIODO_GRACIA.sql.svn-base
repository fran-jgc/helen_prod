create global temporary table TEMP_PERIODO_GRACIA
(	 RUT			VARCHAR2(20)
	,NOMBRE			VARCHAR2(200)
	,TIPO_DEUDA			VARCHAR2(200)
	,COD_DEUDA		NUMBER
	,FECHA_INICIO_COBRO		VARCHAR2(20)
	,MONTO_INICIO_COBRO		NUMBER
	,SALDO_ACTUAL_DEUDA		NUMBER
	,DIRECCION		VARCHAR2(200)
	,COMUNA			VARCHAR2(200)
	,CIUDAD			VARCHAR2(200)
	,REGION			VARCHAR2(200)
	,TELEFONO		VARCHAR2(200)
	,MAIL 			VARCHAR2(200)
)
on commit delete ROWS;