<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="usuario.js" type="text/javascript"></script>
{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js" type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input"><input name="wi_hidden" id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu" style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0">
			<tr>
				<td>
				<table width="520" border="0">
					<tr>
						<td height="100%">
						<div class="titulo_central">{WI_RUTA_MENU}</div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}</font></div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}</font></div>
						</td>
					</tr>
				</table>
				</td>
				<td width="68"></td>
				<td width="68">{WI_PRINT}</td>
				<td width="68"{DISABLE_BUTTON}>{WI_DELETE}</td>
				<td width="68">{WI_NO_SAVE}</td>
				<td width="68">{WI_SAVE}</td>
				<td width="68">{WI_MODIFY}</td>
			</tr>
		</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0" align="center">
			<tr>
				<td height="95" valign="top">
				<table width="1015" border="0" align="center">
					<tr valign="top">
						<td>
						<div style="height: 526px;" class="claro">
						<table width="1000" rules="none" border="1" align="center" class="claro">
							<tr class="titulo_tabla">
								<td colspan="6">DATOS GENERALES</td>
							</tr>
							<tr class="encabezado_right">
								<td width="200">C&oacute;digo:</td>
								<td width="800" class="claro" align="left">{COD_USUARIO}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Nombre Usuario:</td>
								<td class="oscuro" align="left">{NOM_USUARIO}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Login:</td>
								<td class="claro" align="left">{LOGIN}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Password:</td>
								<td class="oscuro" align="left">{PASSWORD}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Perfil:</td>
								<td class="claro" align="left">{COD_PERFIL}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Teléfono:</td>
								<td class="oscuro" align="left">{TELEFONO}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Celular:</td>
								<td class="claro" align="left">{CELULAR}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Mail:</td>
								<td class="oscuro" align="left">{MAIL}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Autorizado Ingreso: </td>
								<td class="claro" align="left" >{AUTORIZA_INGRESO}</td>
							</tr>
							<tr class="encabezado_right">
								<td>Es Cajero: </td>
								<td class="oscuro" align="left" >{ES_CAJERO}</td>
							</tr>
						</table>
						</div>
						</td>
					</tr>
				</table>
				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</form>
</body>
</html>
