<?php
require_once(dirname(__FILE__)."/../../../../commonlib_seven/trunk/php/auto_load.php");
require_once(session::get('K_ROOT_DIR')."appl.ini");

class sql_reprogramacion_base extends sql_tabla {
	static function get_sql($selector_sql) {
		switch ($selector_sql) {
			/////////////////  OUTPUT ///////////////
			case 'OUTPUT':
				if(K_TIPO_BD=="oci"){
					$sql = "SELECT	RE.COD_REPROGRAMACION
									,TO_CHAR(RE.FECHA_REPROGRAMACION,'DD/MM/YYYY') FECHA_REPROGRAMACION
									,DR.RUT
									,DR.DIG_VERIF
									,DR.NOMBRE
									,DR.APELLIDO_PATERNO
									,DR.APELLIDO_MATERNO
									,E.NOM_ESTADO_REPROGRAMACION
									,RE.K_CLIENTE
							FROM		REPROGRAMACION RE, DEUDOR_REPROGRAMACION DR, ESTADO_REPROGRAMACION E
							WHERE		RE.COD_REPROGRAMACION = DR.COD_REPROGRAMACION
							  and 		E.COD_ESTADO_REPROGRAMACION = RE.COD_ESTADO_REPROGRAMACION
							ORDER BY	COD_REPROGRAMACION DESC";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT	RE.COD_REPROGRAMACION
									,CONVERT(VARCHAR(10),RE.FECHA_REPROGRAMACION,103) FECHA_REPROGRAMACION
									,DR.RUT
									,DR.DIG_VERIF
									,DR.NOMBRE
									,DR.APELLIDO_PATERNO
									,DR.APELLIDO_MATERNO
									,E.NOM_ESTADO_REPROGRAMACION
									,RE.K_CLIENTE
							FROM		REPROGRAMACION RE, DEUDOR_REPROGRAMACION DR, ESTADO_REPROGRAMACION E
							WHERE		RE.COD_REPROGRAMACION = DR.COD_REPROGRAMACION
							  and 		E.COD_ESTADO_REPROGRAMACION = RE.COD_ESTADO_REPROGRAMACION
							ORDER BY	COD_REPROGRAMACION DESC";
				}
				break;


				/////////////////  INPUT ///////////////
			case 'INPUT' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT	RE.COD_REPROGRAMACION
									,TO_DATE(RE.FECHA_REPROGRAMACION,'DD/MM/YYYY') FECHA_REPROGRAMACION
									,RE.COD_ESTADO_REPROGRAMACION
									,DR.RUT
									,DR.RUT RUT_H
									,DR.DIG_VERIF
									,RE.COD_USUARIO
									,U.NOM_USUARIO
									,DR.NOMBRE || ' ' || DR.APELLIDO_PATERNO || ' ' || DR.APELLIDO_MATERNO NOMBRE
									,RE.DOC_PAGO_INICIAL
									,RE.DOC_PAGARES
									,RE.DOC_MANIFIESTO
									,TO_CHAR(M.FECHA_RECEP_MANIFIESTO,'DD/MM/YYYY') FECHA_RECEP_MANIFIESTO
									,TO_CHAR(SYSDATE,'DD/MM/YYYY') FECHA_RECEP_MANIFIESTO_H
									,RE.COD_DEUDA_CRPI
									,RE.COD_DEUDA_CR12
									,'' NRO_CUOTAS_REPROGRAMADO_I
									,RE.DOC_PAGARES DOC_PAGARES_H
									,case DOC_MANIFIESTO
										when 'S' then '' 
										else 'none'
									end DISPLAY_F_RECEP
									,RE.K_CLIENTE
							FROM REPROGRAMACION RE
								,DEUDOR_REPROGRAMACION DR
								,USUARIO U
								,MANIFIESTO M
							WHERE RE.COD_REPROGRAMACION = {KEY1}
								  AND RE.COD_REPROGRAMACION = DR.COD_REPROGRAMACION
								  AND RE.COD_USUARIO = U.COD_USUARIO
                  				  AND RE.COD_REPROGRAMACION = M.COD_REPROGRAMACION";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT	RE.COD_REPROGRAMACION
									,CONVERT(VARCHAR(10),RE.FECHA_REPROGRAMACION,103) FECHA_REPROGRAMACION
									,RE.COD_ESTADO_REPROGRAMACION
									,DR.RUT
									,DR.RUT RUT_H
									,DR.DIG_VERIF
									,RE.COD_USUARIO
									,U.NOM_USUARIO
									,DR.NOMBRE + ' ' + DR.APELLIDO_PATERNO + ' ' + DR.APELLIDO_MATERNO NOMBRE
									,RE.DOC_PAGO_INICIAL
									,RE.DOC_PAGARES
									,RE.DOC_MANIFIESTO
									,CONVERT(VARCHAR(10),M.FECHA_RECEP_MANIFIESTO,103) FECHA_RECEP_MANIFIESTO
									,CONVERT(nvarchar(20),getdate(),103) FECHA_RECEP_MANIFIESTO_H
									,RE.COD_DEUDA_CRPI
									,RE.COD_DEUDA_CR12
									,'' NRO_CUOTAS_REPROGRAMADO_I
									,RE.DOC_PAGARES DOC_PAGARES_H
									,case DOC_MANIFIESTO
										when 'S' then '' 
										else 'none'
									end DISPLAY_F_RECEP
									,RE.K_CLIENTE
							FROM REPROGRAMACION RE
								,DEUDOR_REPROGRAMACION DR
								,USUARIO U
								,MANIFIESTO M
							WHERE RE.COD_REPROGRAMACION = {KEY1}
								  AND RE.COD_REPROGRAMACION = DR.COD_REPROGRAMACION
								  AND RE.COD_USUARIO = U.COD_USUARIO
								  AND RE.COD_REPROGRAMACION = M.COD_REPROGRAMACION";
						
				}
				break;

				////////////// CONFIRMA_REPRO ////////////////				
			case 'CONFIRMA_REPRO' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT P.ID_PAGARE
						  		,TO_CHAR(P.FECHA_GENERACION_PAGARE, 'DD/MM/YYYY') FECHA_PAGARE
						  		,TO_CHAR(R. FECHA_REPROGRAMACION, 'DD/MM/YYYY') FECHA_REPROGRAMACION
						  		,TO_CHAR(M.FECHA_RECEP_MANIFIESTO, 'DD/MM/YYYY') FECHA_MANIFIESTO  
						  		,TO_CHAR(Nvl(R.FECHA_PAGO_INICIAL, sysdate), 'DD/MM/YYYY') FECHA_PAGO_INICIAL
						  		,Nvl(R.INFORMADO_MINEDUC, 'NULL') INFORMADO_MINEDUC
							FROM REPROGRAMACION R, DEUDOR_REPROGRAMACION D
								,PAGARE_REPROGRAMACION P, MANIFIESTO M
							WHERE R.COD_REPROGRAMACION = {PARAM1}
							AND R.COD_REPROGRAMACION = D.COD_REPROGRAMACION
							AND D.RUT = {PARAM2}
							AND R.COD_REPROGRAMACION = P.COD_REPROGRAMACION
							AND	R.COD_REPROGRAMACION = M.COD_REPROGRAMACION";
					}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT P.ID_PAGARE
							      ,convert(varchar(10),P.FECHA_GENERACION_PAGARE, 103) FECHA_PAGARE 
							      ,convert(varchar(10),R. FECHA_REPROGRAMACION, 103) FECHA_REPROGRAMACION
							      ,convert(varchar(10),M.FECHA_RECEP_MANIFIESTO, 103) FECHA_MANIFIESTO
							      ,convert(varchar(10),isnull(R.FECHA_PAGO_INICIAL, getdate()), 103) FECHA_PAGO_INICIAL
							      ,ISNULL(R.INFORMADO_MINEDUC, 'NULL') INFORMADO_MINEDUC
							FROM REPROGRAMACION R, DEUDOR_REPROGRAMACION D
								,PAGARE_REPROGRAMACION P, MANIFIESTO M
							WHERE R.COD_REPROGRAMACION = {PARAM1}
							AND R.COD_REPROGRAMACION = D.COD_REPROGRAMACION
							AND D.RUT = {PARAM2}
							AND R.COD_REPROGRAMACION = P.COD_REPROGRAMACION
							AND	R.COD_REPROGRAMACION = M.COD_REPROGRAMACION";
				}
				break;
					

				/////////////////  DD_ESTADO_REPROGRAMACION ///////////////
			case 'DD_ESTADO_REPROGRAMACION' :
				if (K_TIPO_BD=="oci" || K_TIPO_BD=="mssql"){
					$sql = "SELECT		COD_ESTADO_REPROGRAMACION
										,NOM_ESTADO_REPROGRAMACION
							FROM 		ESTADO_REPROGRAMACION
							ORDER BY 	COD_ESTADO_REPROGRAMACION";
				}
				break;

				/////////////////  DW_DEUDA_REPROGRAMACION ///////////////
			case 'DW_DEUDA_REPROGRAMACION' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT DRE.COD_DEUDA_REPROGRAMACION
								  ,DRE.COD_REPROGRAMACION
								  ,DRE.COD_UNIVERSIDAD_DEUDA
								  ,U.NOM_UNIVERSIDAD
								  ,DRE.COD_DEUDA
								  ,DRE.COD_TIPO_DEUDA
								  ,DRE.SALDO_CAPITAL
								  ,DRE.SALDO_INTERES_PENAL
								  ,DRE.SALDO_CAPITAL + DRE.SALDO_INTERES_PENAL TOTAL_SALDO_MONEDA
								  ,DRE.SALDO_CAPITAL * f_mon_get_valor_moneda(TD.COD_MONEDA, SYSDATE) SALDO_CAPITAL_PESOS
								  ,DRE.SALDO_INTERES_PENAL * f_mon_get_valor_moneda(TD.COD_MONEDA, SYSDATE) SALDO_INTERES_PENAL_PESOS
								  ,(DRE.SALDO_CAPITAL + DRE.SALDO_INTERES_PENAL) * f_mon_get_valor_moneda(TD.COD_MONEDA, SYSDATE) TOTAL_SALDO_PESOS
								  ,NULL PORC
							FROM REPROGRAMACION RE
								,DEUDA_REPROGRAMACION DRE left outer join TIPO_DEUDA TD on TD.COD_TIPO_DEUDA = DRE.COD_TIPO_DEUDA
								,UNIVERSIDAD U
							WHERE RE.COD_REPROGRAMACION = {KEY1}
							  AND DRE.COD_REPROGRAMACION = RE.COD_REPROGRAMACION
							  AND U.COD_UNIVERSIDAD = DRE.COD_UNIVERSIDAD_DEUDA";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT DRE.COD_DEUDA_REPROGRAMACION
								  ,DRE.COD_REPROGRAMACION
								  ,DRE.COD_UNIVERSIDAD_DEUDA
								  ,U.NOM_UNIVERSIDAD
								  ,DRE.COD_DEUDA
								  ,DRE.COD_TIPO_DEUDA
								  ,DRE.SALDO_CAPITAL
								  ,DRE.SALDO_INTERES_PENAL
								  ,DRE.SALDO_CAPITAL + DRE.SALDO_INTERES_PENAL TOTAL_SALDO_MONEDA
								  ,DRE.SALDO_CAPITAL * dbo.f_mon_get_valor_moneda(TD.COD_MONEDA, getdate()) SALDO_CAPITAL_PESOS
								  ,DRE.SALDO_INTERES_PENAL * dbo.f_mon_get_valor_moneda(TD.COD_MONEDA, getdate()) SALDO_INTERES_PENAL_PESOS
								  ,(DRE.SALDO_CAPITAL + DRE.SALDO_INTERES_PENAL) * dbo.f_mon_get_valor_moneda(TD.COD_MONEDA, getdate()) TOTAL_SALDO_PESOS
								  ,NULL PORC
							FROM REPROGRAMACION RE
								,DEUDA_REPROGRAMACION DRE left outer join TIPO_DEUDA TD on TD.COD_TIPO_DEUDA = DRE.COD_TIPO_DEUDA
								,UNIVERSIDAD U
							WHERE RE.COD_REPROGRAMACION = {KEY1}
							  AND DRE.COD_REPROGRAMACION = RE.COD_REPROGRAMACION
							  AND U.COD_UNIVERSIDAD = DRE.COD_UNIVERSIDAD_DEUDA";
				}
				break;

				/////////////////  DW_PAGO_INICIAL ///////////////
			case 'DW_PAGO_INICIAL' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT 
									(SELECT MONTO_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) MONTO_PAGO_INICIAL
									,(SELECT MONTO_PAGO_INICIAL * f_mon_get_valor_moneda(3, sysdate) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) MONTO_PAGO_INICIAL_PESOS
									,(SELECT MONTO_PAGO_INICIAL / NRO_CUOTAS_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) CUOTA_PAGO_INICIAL
									,(SELECT (MONTO_PAGO_INICIAL / NRO_CUOTAS_PAGO_INICIAL) * f_mon_get_valor_moneda(3, sysdate) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) CUOTA_PAGO_INICIAL_PESOS
									,(SELECT Sum(SALDO_INTERES_PENAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) *
									(SELECT PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1)/100.0000 MONTO_CONDONADO
									,((SELECT Sum(SALDO_INTERES_PENAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) *
									(SELECT PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1)/100.0000) * f_mon_get_valor_moneda(3, sysdate) MONTO_CONDONADO_PESOS
									,(SELECT Sum(MONTO_REPROGRAMADO) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) MONTO_REPROGRAMADO
									,(SELECT Sum(MONTO_REPROGRAMADO) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) * f_mon_get_valor_moneda(3, sysdate) MONTO_REPROGRAMADO_PESOS
									,(SELECT NRO_CUOTAS_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) NRO_CUOTAS_PAGO_INICIAL
									,Round((SELECT (MONTO_PAGO_INICIAL * 100.0000) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) /
									(SELECT Sum(SALDO_CAPITAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION), 4) PORC_INICIAL
									,(SELECT PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION AND ROWNUM = 1) PORC_CONDONACION_INTERES_PENAL
							FROM REPROGRAMACION R
							WHERE COD_REPROGRAMACION = {KEY1}";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT 
									(SELECT top 1 MONTO_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) MONTO_PAGO_INICIAL
									,(SELECT top 1 MONTO_PAGO_INICIAL * dbo.f_mon_get_valor_moneda(3, GETDATE()) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) MONTO_PAGO_INICIAL_PESOS
									,(SELECT top 1 MONTO_PAGO_INICIAL / NRO_CUOTAS_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) CUOTA_PAGO_INICIAL
									,(SELECT top 1 (MONTO_PAGO_INICIAL / NRO_CUOTAS_PAGO_INICIAL) * dbo.f_mon_get_valor_moneda(3, GETDATE()) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) CUOTA_PAGO_INICIAL_PESOS
									,(SELECT Sum(SALDO_INTERES_PENAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) *
									(SELECT top 1 PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION)/100.0000 MONTO_CONDONADO
									,((SELECT Sum(SALDO_INTERES_PENAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) *
									(SELECT top 1 PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION)/100.0000) * dbo.f_mon_get_valor_moneda(3, GETDATE()) MONTO_CONDONADO_PESOS
									,(SELECT Sum(MONTO_REPROGRAMADO) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) MONTO_REPROGRAMADO
									,(SELECT Sum(MONTO_REPROGRAMADO) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) * dbo.f_mon_get_valor_moneda(3, GETDATE()) MONTO_REPROGRAMADO_PESOS
									,(SELECT top 1 NRO_CUOTAS_PAGO_INICIAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) NRO_CUOTAS_PAGO_INICIAL
									,Round((SELECT top 1 (MONTO_PAGO_INICIAL * 100.0000) FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) /
									(SELECT Sum(SALDO_CAPITAL) FROM DEUDA_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION), 4) PORC_INICIAL
									,(SELECT top 1 PORC_CONDONACION_INTERES_PENAL FROM PAGARE_REPROGRAMACION WHERE COD_REPROGRAMACION = R.COD_REPROGRAMACION) PORC_CONDONACION_INTERES_PENAL
							FROM REPROGRAMACION R
							WHERE COD_REPROGRAMACION = {KEY1}";
				}
				break;

				/////////////////  DW_PAGARE_REPRO ///////////////
			case 'DW_PAGARE_REPRO' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT CA.NRO
								  ,SUM(CA.CAPITAL) CAPITAL
								  ,SUM(CA.INTERES_PENAL) INTERES_PENAL
								  ,SUM(CA.INTERES_NORMAL + CA.INTERES) INTERESES_NORMAL
								  ,SUM(CA.VALOR_CUOTA_CUPONERA) VALOR_CUOTA_CUPONERA
								  ,SUM(CA.INTERES_PENAL) DESCUENTO_OPORTUNO
								  ,SUM(CA.MONTO) MONTO
								  ,SUM(CA.MONTO * f_mon_get_valor_moneda(3, RE.FECHA_REPROGRAMACION)) MONTO_PESOS
								  ,PR.NRO_CUOTAS_REPROGRAMADO NRO_CUOTAS_REPROGRAMADO_P
							FROM CUOTA_ANUAL CA
								,REPROGRAMACION RE
								,PAGARE_REPROGRAMACION PR
							WHERE RE.COD_REPROGRAMACION = {KEY1}
								AND RE.COD_REPROGRAMACION = PR.COD_REPROGRAMACION
								AND PR.COD_PAGARE_REPROGRAMACION = CA.COD_PAGARE_REPROGRAMACION
							GROUP BY CA.NRO, PR.NRO_CUOTAS_REPROGRAMADO
							ORDER BY CA.NRO";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT CA.NRO
								  ,SUM(CA.CAPITAL) CAPITAL
								  ,SUM(CA.INTERES_PENAL) INTERES_PENAL
								  ,SUM(CA.INTERES_NORMAL + CA.INTERES) INTERESES_NORMAL
								  ,SUM(CA.VALOR_CUOTA_CUPONERA) VALOR_CUOTA_CUPONERA
								  ,SUM(CA.INTERES_PENAL) DESCUENTO_OPORTUNO
								  ,SUM(CA.MONTO) MONTO
								  ,SUM(CA.MONTO * dbo.f_mon_get_valor_moneda(3, RE.FECHA_REPROGRAMACION)) MONTO_PESOS
								  ,PR.NRO_CUOTAS_REPROGRAMADO NRO_CUOTAS_REPROGRAMADO_P
							FROM CUOTA_ANUAL CA
								,REPROGRAMACION RE
								,PAGARE_REPROGRAMACION PR
							WHERE RE.COD_REPROGRAMACION = {KEY1}
								AND RE.COD_REPROGRAMACION = PR.COD_REPROGRAMACION
								AND PR.COD_PAGARE_REPROGRAMACION = CA.COD_PAGARE_REPROGRAMACION
							GROUP BY CA.NRO, PR.NRO_CUOTAS_REPROGRAMADO
							ORDER BY CA.NRO";
				}
				break;

				/////////////////  DW_DEUDOR_REPRO ///////////////
			case 'DW_DEUDOR_REPRO' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT DRE.RUT RUT_DEUDOR
								  ,DRE.DIG_VERIF DIG_VERIF_DEUDOR 
								  ,DRE.NOMBRE
								  ,DRE.APELLIDO_PATERNO
								  ,DRE.APELLIDO_MATERNO
								  ,DRE.CODIGO_AREA1||'-'||DRE.TELEFONO1 TELEFONO1
								  ,DRE.CODIGO_AREA2||'-'||DRE.TELEFONO2 TELEFONO2
								  ,DRE.EMAIL
								  ,DRE.DIRECCION
								  ,DRE.COMUNA
								  ,DRE.CIUDAD
								  ,DRE.REGION
							FROM DEUDOR_REPROGRAMACION DRE
							WHERE DRE.COD_REPROGRAMACION ={KEY1}";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT DRE.RUT RUT_DEUDOR
								  ,DRE.DIG_VERIF DIG_VERIF_DEUDOR 
								  ,DRE.NOMBRE
								  ,DRE.APELLIDO_PATERNO
								  ,DRE.APELLIDO_MATERNO
								  ,DRE.CODIGO_AREA1+'-'+DRE.TELEFONO1 TELEFONO1
								  ,DRE.CODIGO_AREA2+'-'+DRE.TELEFONO2 TELEFONO2
								  ,DRE.EMAIL
								  ,DRE.DIRECCION
								  ,DRE.COMUNA
								  ,DRE.CIUDAD
								  ,DRE.REGION
							FROM DEUDOR_REPROGRAMACION DRE
							WHERE DRE.COD_REPROGRAMACION ={KEY1}";
				}
				break;

				/////////////////  DW_PAGARE ///////////////
			case 'DW_PAGARE' :
				if (K_TIPO_BD=="oci"){
					$sql = "SELECT COD_PAGARE_REPROGRAMACION
								  ,PR.ID_PAGARE
	  							  ,U.NOM_UNIVERSIDAD NOM_UNIVERSIDAD_P
	  							  ,TO_CHAR(PR.FECHA_GENERACION_PAGARE,'DD/MM/YYYY') FECHA_GENERACION_PAGARE
								  ,PR.MONTO_PAGARE
								  ,PR.MONTO_PAGARE * f_mon_get_valor_moneda(3, sysdate) MONTO_PAGARE_PESOS
								  ,PR.SALDO_CAPITAL SALDO_CAPITAL_P
								  ,PR.INTERESES INTERESES_P
								  ,PR.MONTO_PAGO_INICIAL MONTO_PAGO_INICIAL_PAGARE
								  ,PR.MONTO_PAGO_INICIAL / PR.NRO_CUOTAS_PAGO_INICIAL CUOTA_PAGO_INICIAL_PAGARE
								  ,PR.PORC_CONDONACION_INTERES_PENAL PORC_CONDONACION_INTERES
								  ,PR.MONTO_REPROGRAMADO MONTO_REPROGRAMADO_P
								  ,PR.NRO_CUOTAS_REPROGRAMADO
								  ,PR.RECIBIDO
							FROM PAGARE_REPROGRAMACION PR
								,REPROGRAMACION RE
								,UNIVERSIDAD U
							WHERE PR.COD_REPROGRAMACION = {KEY1}
								AND PR.COD_REPROGRAMACION = RE.COD_REPROGRAMACION
								AND U.COD_UNIVERSIDAD = PR.COD_UNIVERSIDAD";
				}
				else if (K_TIPO_BD=="mssql"){
					$sql = "SELECT COD_PAGARE_REPROGRAMACION
								  ,PR.ID_PAGARE
	  							  ,U.NOM_UNIVERSIDAD NOM_UNIVERSIDAD_P
								  ,CONVERT(VARCHAR(10),PR.FECHA_GENERACION_PAGARE,103) FECHA_GENERACION_PAGARE
								  ,PR.MONTO_PAGARE
								  ,PR.MONTO_PAGARE * dbo.f_mon_get_valor_moneda(3, getdate()) MONTO_PAGARE_PESOS
								  ,PR.SALDO_CAPITAL SALDO_CAPITAL_P
								  ,PR.INTERESES INTERESES_P
								  ,PR.MONTO_PAGO_INICIAL MONTO_PAGO_INICIAL_PAGARE
								  ,PR.MONTO_PAGO_INICIAL / PR.NRO_CUOTAS_PAGO_INICIAL CUOTA_PAGO_INICIAL_PAGARE
								  ,PR.PORC_CONDONACION_INTERES_PENAL PORC_CONDONACION_INTERES
								  ,PR.MONTO_REPROGRAMADO MONTO_REPROGRAMADO_P
								  ,PR.NRO_CUOTAS_REPROGRAMADO
								  ,PR.RECIBIDO
							FROM PAGARE_REPROGRAMACION PR
								,REPROGRAMACION RE
								,UNIVERSIDAD U
							WHERE PR.COD_REPROGRAMACION = {KEY1}
								AND PR.COD_REPROGRAMACION = RE.COD_REPROGRAMACION
								AND U.COD_UNIVERSIDAD = PR.COD_UNIVERSIDAD";
				}
				break;

				////////////// AJAX_VALIDA_REPRO ////////////////
			case 'AJAX_VALIDA_REPRO_CONFIRMADA' :
				if (K_TIPO_BD=="oci" || K_TIPO_BD=="mssql"){
					$sql = "SELECT	COUNT(*) CANT
								FROM	REPROGRAMACION RE, DEUDOR_REPROGRAMACION DRE
								WHERE	DRE.RUT ={PARAM1}
									AND RE.COD_REPROGRAMACION = DRE.COD_REPROGRAMACION
									AND RE.COD_ESTADO_REPROGRAMACION ={PARAM2}";
				}
				break;

			case 'AJAX_VALIDA_REPRO_SOLICITADA' :
				if (K_TIPO_BD=="oci" || K_TIPO_BD=="mssql"){
					$sql = "SELECT	COUNT(*) CANTI
								FROM	REPROGRAMACION RE, DEUDOR_REPROGRAMACION DRE
								WHERE	DRE.RUT ={PARAM1}
									AND RE.COD_REPROGRAMACION = DRE.COD_REPROGRAMACION
									AND RE.COD_ESTADO_REPROGRAMACION ={PARAM2}";
				}
				break;

			case 'AJAX_COD_REPROGRAMACION' :
				if (K_TIPO_BD=="oci" || K_TIPO_BD=="mssql"){
					$sql = "SELECT	RE.COD_REPROGRAMACION
								FROM	REPROGRAMACION RE, DEUDOR_REPROGRAMACION DRE
								WHERE	DRE.RUT ={PARAM1}
									AND RE.COD_REPROGRAMACION = DRE.COD_REPROGRAMACION
									AND RE.COD_ESTADO_REPROGRAMACION ={PARAM2}";
				}
				break;

				////////////// AJAX_RUT_REPRO ////////////////
			case 'AJAX_RUT_REPRO' :
				if (K_TIPO_BD=="oci" || K_TIPO_BD=="mssql"){
					$sql = "SELECT	COUNT(*) CANT
								FROM	DEUDOR DR
								WHERE	DR.RUT ={PARAM1}";
				}
				break;

				/////////////////  ERROR ///////////////
			default:
				base::error("sql_reprogramacion::get_sql, selector: '$selector_sql' no definido");
		}
		$keys = func_get_args();
		$sql = sql_tabla::replace_KEYS($sql, $keys);
		return $sql;
	}
}

/////////////////////////////////////////////////////////////
// Se separa por UNIVERSIDAD
$file_name = dirname(__FILE__)."/".K_CLIENTE."/class_sql_reprogramacion.php";
if (file_exists($file_name))
    require_once($file_name);
else {
    class sql_reprogramacion extends sql_reprogramacion_base {
    }
}
?>