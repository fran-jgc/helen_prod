<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Crear Ingreso Desde</title>
<script charset="utf-8" src="../../../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="../../../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="reprogramacion.js" type="text/javascript"></script>
<script src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/jquery.min.js" type="text/javascript"></script>
<script src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/jquery.js" type="text/javascript"></script>
<link href="{W_CSS}" rel="stylesheet" type="text/css"/>

<script type="text/javascript">
// DIALOG Required Code
	var prntWindow = getParentWindowWithDialog(); //$(top)[0];

	var $dlg = prntWindow && prntWindow.$dialog;

	function getParentWindowWithDialog() {
		var p = window.parent;
		var previousParent = p;
		while (p != null) {
			if ($(p.document).find('#iframeDialog').length) return p;

			p = p.parent;

			if (previousParent == p) return null;

			// save previous parent

			previousParent = p;
		}
		return null;
	}

	function setWindowReturnValue(value) {
		if ($dlg) $dlg.returnValue = value;
		window.returnValue = value; // in case popup is called using showModalDialog

	}

	function getWindowReturnValue() {
		// in case popup is called using showModalDialog

		if (!$dlg && window.returnValue != null)
			return window.returnValue;

		return $dlg && $dlg.returnValue;
	}

	if ($dlg) window.dialogArguments = $dlg.dialogArguments;
	if ($dlg) window.close = function() { if ($dlg) $dlg.dialogWindow.dialog('close'); };
	// END of dialog Required Code

    function okMe() {
		var rut_deudor	= document.getElementById('RUT_DEUDOR_0').value;
		var nro_folio	= document.getElementById('NRO_FOLIO_0').value;
		document.getElementById('RUT_DEUDOR_0').value =  rut_deudor.replace('.', '', 'g');
		if (rut_deudor == ''){
			alert('Debe Ingresar Rut Deudor para continuar.');
			document.getElementById('RUT_DEUDOR_0').focus();
			return false;
		}
		if (nro_folio == ''){
			alert('Debe Ingresar Nro. de Folio para continuar.');
			document.getElementById('NRO_FOLIO_0').focus();
			return false;
		}
    	returnValue=rut_deudor+'|'+nro_folio;  
		setWindowReturnValue(returnValue);
		
    	if (returnValue)
    		window.close(); 
    	else 
    		return false;		
    }
    function closeMe() {
        setWindowReturnValue(null);
        window.close();
	}
	

function set_null() {
	document.getElementById('RUT_DEUDOR_0').value = null;
	document.getElementById('NRO_FOLIO_0').value = null;
	document.getElementById('RUT_DEUDOR_0').focus();
}
</script>
</head>
<body onLoad="window.document.form1.RUT_DEUDOR_0.focus();">
<form id="form1" name="form1" method="post" action="">
	<div class="titulo_tabla_wm">&nbsp;&nbsp;Crear Reprogramación Desde Folio:</div>
	<br></br>
	<div style="overflow-x:hidden; overflow-y:auto; height:180; margin-top:-1em;">
		<table width="500" border="0" rules="none" align="center">
			<tr class="encabezado_right">
				<td width="25%">Rut Deudor:</td>
				<td width="75%" colspan=3 class="oscuro" align="left">{RUT_DEUDOR}<a><FONT size = 1 color = "red">*Ingrese Rut sin puntos ni dígito.</FONT></a></td>
			</tr>
			<tr class="encabezado_right">
				<td width="25%">Folio Pagaré</td>
				<td width="75%" colspan=3 class="oscuro" align="left">{NRO_FOLIO}</td>
			</tr>
		</table>
	</div>
	<table width="500" border="0" align="center">
		<tr>
			<td align="right"><br/><input name="Aceptar" type="button" value="OK." onclick="okMe();" class="button"/></td>
			<td align="left"><br/><input name="cancelar" type="button" value="Cancelar" onclick="closeMe();" class="button"/></td>
		</tr>
	</table>
</form>
</body>
</html>