class dw_pagare extends datawindow {
	function __construct(){
		$sql = sql_reprogramacion::get_sql('DW_PAGARE');
		parent::__construct($sql,'R_PAGARE');
		
		$this->add_control(new edit_text('COD_PAGARE_REPROGRAMACION',1, 1, 'hidden'));
		$this->add_control(new static_text('NOM_UNIVERSIDAD_P'));
		$this->add_control(new static_text('ID_PAGARE'));
		$this->add_control(new static_text('FECHA_GENERACION_PAGARE'));
		$this->add_control(new static_num('MONTO_PAGARE', 4));
		$this->add_control(new static_num('MONTO_PAGARE_PESOS', 0));
		$this->add_control(new static_num('SALDO_CAPITAL_P', 4));
		$this->add_control(new static_num('INTERESES_P', 4));
		$this->add_control(new static_num('MONTO_PAGO_INICIAL_PAGARE', 4));
		$this->add_control(new static_num('CUOTA_PAGO_INICIAL_PAGARE', 4));
		$this->add_control(new static_num('PORC_CONDONACION_INTERES', 2));
		$this->add_control(new static_num('MONTO_REPROGRAMADO_P', 4));
		$this->add_control(new static_text('NRO_CUOTAS_REPROGRAMADO'));
		$this->add_control(new static_num('PORC_CONDONACION_INTERES_PENAL', 2));
		$this->add_control($control = new edit_check_box('RECIBIDO', 'S', 'N', ''));
		$control->set_onChange("change_recibido();");
	}
	
	function update($db){
        $sp = 'spu_pagare_reprogramacion';
        for ($i = 0; $i < $this->row_count(); $i++) {
            $statuts = $this->get_status_row($i);
            if ($statuts == K_ROW_NOT_MODIFIED){
                continue;
            }
            // siempre es UPDATE
            $cod_pagare_reprogramacion         = $this->get_item($i, 'COD_PAGARE_REPROGRAMACION');
            $recibido						   = $this->get_item($i, 'RECIBIDO');
            
          	$param = "'UPDATE'
                        ,$cod_pagare_reprogramacion
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,NULL
                        ,'$recibido'";

            if (!$db->EXECUTE_SP($sp, $param)){
                return false;
            }
        }
        return true;
    }
}

