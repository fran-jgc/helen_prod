														<td width="151">Sexo:</td>
														<td width="165" class="claro" align="left">{SEXO}</td>
														<td width="151">Estado Civil:</td>
														<td width="165" class="claro" align="left">{COD_ESTADO_CIVIL}</td>
													</tr>
													<tr class="encabezado_right">
														<td>Apellido Paterno:</td>
														<td class="oscuro" align="left">{APELLIDO_PATERNO}</td>
														<td>Apellido Materno:</td>
														<td class="oscuro" align="left">{APELLIDO_MATERNO}</td>
														<td>Nombre:</td>
														<td class="oscuro" align="left">{NOMBRE}</td>
													</tr>
													<tr class="encabezado_right">
														<td>Fecha de Nacimiento:</td>
