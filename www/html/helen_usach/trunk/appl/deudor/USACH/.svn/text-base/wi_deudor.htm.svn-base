														<td width="100" align="center">Docs. al día</td>
														<td width="100" align="center">Docs. a fecha</td>
														<td width="100" align="center">Total</td>
														<td width="80" align="lefcentert">Nº ingreso</td>
													</tr>
												</table>
												<div style="overflow-x: hidden; overflow-y: auto; height: 150;">
													<table width="1000" rules="none" border="1" align="center" class="claro" id="SIMULACION">
														<!-- startBlock(SIMULACION) -->
														<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
															<td width="120" align="center">{COD_SIMULACION}</td>
															<td width="100" align="center">{FECHA_SIMULACION}</td>
															<td width="400" align="left">{DEUDAS}</td>
															<td width="100" align="right">{TOT_DOC_AL_DIA}</td>
															<td width="100" align="right">{TOT_DOC_AFECHA}</td>
															<td width="100" align="right">{TOT_DOC}</td>
															<td width="80" align="center">{COD_INGRESO_REAL}</td>
														</tr>
														<!-- endBlock(SIMULACION) -->
													</table>						
												</div>
												<table width="1000" border="0" align="center" class="claro">
