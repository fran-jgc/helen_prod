																<td align="right" width="80">{NO_EXIGIBLE}</td>
																<td align="right" width="80">{VENCIDA}</td>
																<td align="right" width="80">{VIGENTE}</td>
																<td align="right" width="80">{FUTURA}</td>
																<td align="right" width="80">{SALDO}</td>
																<td align="center" width="120">{NOM_CARTERA}</td>
															</tr>
														<!-- endBlock(DETALLE_DEUDA) -->
