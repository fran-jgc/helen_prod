											<li class="TabbedPanelsTab" tabindex="0" style="display:{TAB_100530}">Bitacora</li>
											<li class="TabbedPanelsTab" tabindex="0">Mineduc</li>
										</ul>
										<div class="TabbedPanelsContentGroup">
											<div class="TabbedPanelsContent" style="height: 492px;">
												<!--INI DEUDOR-->
												<table width="1000" rules="none" border="1" align="center" class="claro">
													<tr class="titulo_tabla">
														<td colspan="6">ANTECEDENTES PERSONALES</td>
													</tr>
													<tr class="encabezado_right">
