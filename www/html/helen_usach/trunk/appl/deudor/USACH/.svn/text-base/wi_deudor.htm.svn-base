															<td align="left" width="100">{NOM_USUARIO}</td>
															<td align="center" width="50">{ELIMINAR_BITACORA_DEUDOR}</td>
														</tr>
														<!-- endBlock(BITACORA_DEUDOR) -->
													</table>
												</div>
												<table width="1000" rules="none" border="1" align="center" class="claro" id="ADD_BITACORA_DEUDOR" style="display: {">
													<tr class="claro">
														<td colspan="4" align="left">{AGREGAR_BITACORA_DEUDOR}</td>
													</tr>
												</table>
												
											</div><!--FIN TabbedPanelsContentGroup-->
