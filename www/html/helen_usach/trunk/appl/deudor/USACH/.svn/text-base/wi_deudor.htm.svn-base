																	</table>						
																	<div style="overflow-x: hidden; overflow-y: auto; height:141; width:1200;">
																		<table width="1200" rules="none" border="1" align="center" class="claro">
																			<!-- startBlock(DIRECCION_COMERCIAL_HISTORICA) -->
																			<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
																				<td width="215" align="left">{DIRECCION}</td>
																				<td width="125" align="left">{NOM_PAIS}</td>
