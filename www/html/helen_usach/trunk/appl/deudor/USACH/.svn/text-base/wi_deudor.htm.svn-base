															<td width="10%" align="center">{CON_HIJO}</td>
															<td width="15%" align="right">{TOT_DECL_DEUDOR_UTM}</td>
															<td width="15%" align="right">{TOT_DECL_CONYUGE_UTM}</td>
														</tr>
														<!-- endBlock(DECLARACION) -->
													</table>						
												</div>
												<table width="1000" rules="none" border="1" align="center" class="claro">
													<tr class="titulo_tabla">
														<td colspan="5">DETALLE DECLARACION AÑO CUOTA {ANO_DECLARACION_SELECCIONADA}</td>
													</tr>
													<tr class="encabezado_center">
														<td width="150">Mes</td>
														<td width="100">UTM Deudor</td>
														<td width="100">Pesos Deudor</td>
														<td width="100">UTM Conyuge</td>
														<td width="100">Pesos Conyuge</td>
													</tr>
												</table>		
												<div style="overflow-x: hidden; overflow-y: auto; height:305;">			
													<table width="1000" rules="none" border="1" align="center" class="claro">
														<!-- startBlock(DETALLE_DECLARACION) -->
														<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
															<td width="150" align="left">{MES}</td>
															<td width="100" align="right">{MONTO_DEUDOR_MONEDA}</td>
															<td width="100" align="right">{MONTO_DEUDOR_PESOS}</td>
															<td width="100" align="right">{MONTO_CONYUGE_MONEDA}</td>
															<td width="100" align="right">{MONTO_CONYUGE_PESOS}</td>
														</tr>
														<!-- endBlock(DETALLE_DECLARACION) -->
													</table>
												</div>
												<table width="1000" rules="none" border="1" align="center" class="claro">
													<tr class="titulo_tabla">
														<td width="150" class="encabezado_center">TOTAL</td>
														<td width="100" align="right">{SUM_MONTO_DEUDOR_MONEDA}</td>
														<td width="100" align="right">{SUM_MONTO_DEUDOR_PESOS}</td>
														<td width="100" align="right">{SUM_MONTO_CONYUGE_MONEDA}</td>
														<td width="100" align="right">{SUM_MONTO_CONYUGE_PESOS}</td>
													</tr>
												</table>
											</div>
												<!--FIN DECLARACIONES-->
												<!--INI SIMULACION-->
											<div class="TabbedPanelsContent" style="height: 492px;">
