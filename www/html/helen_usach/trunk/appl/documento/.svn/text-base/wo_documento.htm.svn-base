<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
{WO_JAVA_SCRIPT}
</head>
<body {WO_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js" type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="output" id="output">
<input name="wo_hidden" id="wo_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000"  height="51" align="center" id="awmAnchor-menu" style="width:100px; height:50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="592" border="0">
							<tr>
								<td height="100%"><div class="titulo_central">{WO_RUTA_MENU}</div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WO_FECHA_ACTUAL}</font></div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WO_NOM_USUARIO}</font></div></td>
							</tr>
						</table>
					</td> 
					<td>{WO_ADD}</td>
					<td>{WO_EXPORT}</td>					
				</tr>
			</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>	  
			<table width="1000" border="0" align="center" height="570">
				<tr bgcolor="#FFFFFF" height="520">
					<td valign="top">
						<table width="1000" border="0" align="center">
							<tr class="encabezado_center">
								<th width="6%">Detalle</th>
								<th width="6%">{H_NRO_INGRESO}</th>
								<th width="6%">{H_NRO_DOCUMENTO_PAGO}</th>
								<th width="8%">{H_FECHA_REGISTRO}</th>
								<th width="8%">{H_FECHA_DOCUMENTO_PAGO}</th>
								<th>{H_RUT}</th>
								<th>{H_NOM_BANCO}</th>
								<th>{H_MONTO}</th>
								<th>{H_NOM_TIPO_DOCUMENTO_PAGO}</th>
								<th>{H_NOM_ESTADO_DOCUMENTO_PAGO}</th>
							</tr>
							<!-- startBlock(wo_registro) -->
							<tr class="{WO_TR_CSS}">
								<td align="center">{WO_DETALLE}</td>
								<td align="left">{NRO_INGRESO}</td>
								<td align="right">{COD_DOCUMENTO_PAGO}{NRO_DOCUMENTO_PAGO}</td>
								<td align="center">{FECHA_REGISTRO}</td>
								<td align="center">{FECHA_DOCUMENTO_PAGO}</td>
								<td align="center">{RUT}-{DIG_VERIF}</td>
								<td>{NOM_BANCO}</td>
								<td align="right">{MONTO}</td>
								<td>{NOM_TIPO_DOCUMENTO_PAGO}</td>
								<td>{NOM_ESTADO_DOCUMENTO_PAGO}</td>								
							</tr>
							<!-- endBlock(wo_registro) -->
						</table>
					</td>
				</tr>		
				<tr bgcolor="#FFFFFF" height="28">
					<td>						
						<table width="1000" border="0" align="center">
							<tr valign="middle">
								<td width="290" >{WO_BACK}</td>
								<td align="right">{WO_FIRST}{WO_PREV}</td>
								<td align="center" class="cant_paginas" width="230">{WO_PAGES}</td>
								<td align="left">{WO_NEXT}{WO_LAST}</td>
								<td width="180"></td>
							</tr>
						</table> 
					</td>
				</tr>
			</table>
		</td>
	</tr>
</table>
</form>
</body>
</html>
	
	