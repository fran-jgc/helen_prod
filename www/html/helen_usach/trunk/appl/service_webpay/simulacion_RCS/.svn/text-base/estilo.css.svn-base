----manu ---
body {margin: 0;}

ul.sidenav {
    list-style-type: none;
    margin: 1%;
    padding: 1%;
    width: auto;
    background-color: #f1f1f1;
    position: auto;
    height: auto;
    overflow: auto;
}

ul.sidenav li a {
    display: block;
    color: #000;
    padding: 8px 16px;
    text-decoration: none;
}
 
ul.sidenav li a.active {
    background-color: #1D58A8;
    color: white;
}

ul.sidenav li a:hover:not(.active) {
    background-color: #EA7600;
    color: white;
}

div.content {
    margin-left: 20%;
    padding: auto;
    height: auto;
}

@media screen and (max-width: 900px) {
    ul.sidenav {
        width: 100%;
        height: auto;
        position: relative;
    }
    ul.sidenav li a {
        float: left;
        padding: 15px;
    }
    div.content {margin-left: auto;}
}

@media screen and (max-width: 400px) {
    ul.sidenav li a {
        text-align: center;
        float: none;
    }
}

---- usach ---
*{font-family: Arial, Helvetica,sans-serif;}
.letras
{
	text-align: justify;
	font-style: italic;
	font-size: 17px;
	line-height: 20px;
	padding-left: 15px;
	padding-right: 15px;
	padding-top: 15px;
}
#beneficios
{
	width: 78%;
	height: 22%;
	border-radius: 40px;
	border: 1px solid #DCE6F2;
	background-color: #DCE6F2;
	box-shadow: 2px 2px 0px 2px rgba(0,0,0,0.4);
	margin: auto;
}

/*ul
{
	list-style-image: url("check-black.png");
}
*/
.beneficios
{
	height: 30px;
	width: 250px;
	border: 1px solid #f5f6f6;
	text-align: center;
	background: #f5f6f6; /* Old browsers */
	background: #f5f6f6; /* Old browsers */
	background: -moz-linear-gradient(top,  #f5f6f6 0%, #b8bac6 49%, #dbdce2 60%, #dddfe3 80%, #f5f6f6 100%); /* FF3.6+ */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#f5f6f6), color-stop(49%,#b8bac6), color-stop(60%,#dbdce2), color-stop(80%,#dddfe3), color-stop(100%,#f5f6f6)); /* Chrome,Safari4+ */
	background: -webkit-linear-gradient(top,  #f5f6f6 0%,#b8bac6 49%,#dbdce2 60%,#dddfe3 80%,#f5f6f6 100%); /* Chrome10+,Safari5.1+ */
	background: -o-linear-gradient(top,  #f5f6f6 0%,#b8bac6 49%,#dbdce2 60%,#dddfe3 80%,#f5f6f6 100%); /* Opera 11.10+ */
	background: -ms-linear-gradient(top,  #f5f6f6 0%,#b8bac6 49%,#dbdce2 60%,#dddfe3 80%,#f5f6f6 100%); /* IE10+ */
	background: linear-gradient(to bottom,  #f5f6f6 0%,#b8bac6 49%,#dbdce2 60%,#dddfe3 80%,#f5f6f6 100%); /* W3C */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#f5f6f6', endColorstr='#f5f6f6',GradientType=0 ); /* IE6-9 */
	margin-left: 10px;

}		

.h3
{
	text-align: center;
