}

.button
{
	background-color: #1589C5;
	height: 50px;
	width: 160px;
	border-radius: 12px;
	font-size: 18px;
	color: white;
	border: 1px outset #3064A2;
	-webkit-box-shadow: 5px 5px 5px 0px rgba(0,0,0,0.75);
	-moz-box-shadow: 5px 5px 5px  0px rgba(0,0,0,0.75);
	box-shadow: 5px 5px 5px  0px rgba(0,0,0,0.75);
}

.button:hover
{
	background-color: #366CB5;
	cursor: hand;
	cursor: pointer;
	
	
}

.divBoton
{
	width: 200px;
	height: 50px;
	margin: auto;
}


#imagenes
{
	width: 100%;
}


