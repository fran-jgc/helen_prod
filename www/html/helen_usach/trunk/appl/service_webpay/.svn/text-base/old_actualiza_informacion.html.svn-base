	</table>
</div>

<!--  <div class="sub_tit_superior" align="left">Direcci&oacute;n Particular &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(*) Campos Obligatorios</div>-->
<table width="800" border="0" align="left" cellpadding="3" cellspacing="1" class="tabla_deuda">
	<tr valign="middle" align="left">
		<td width="35%" bgcolor="#F3F3F3" >
			<div>Direcci&oacute;n: (*)</div>
		</td>
		<td width="65%" bgcolor="#FFFFFF">
			<div class="deuda_resultado">{COD_DIRECCION_PARTICULAR}{DIRECCION_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
			<div>Fecha Ingreso:</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{FECHA_DIRECCION_PARTICULAR}</div>
			<div class="deuda_resultado" style="display:none">{ES_VALIDA_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
			<div>Pais: (*)</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{COD_PAIS_PARTICULAR}</div>
		</td>
	</tr>
