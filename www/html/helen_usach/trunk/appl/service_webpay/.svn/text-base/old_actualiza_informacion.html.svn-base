			<div>Región: (*)</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{COD_REGION_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
			<div>Ciudad: (*)</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{COD_CIUDAD_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
			<div>Comuna:</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{COD_COMUNA_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
			<div>e-mail:</div>
		</td>
		<td bgcolor="#FFFFFF">
			<div class="deuda_resultado">{EMAIL_PARTICULAR}</div>
		</td>
	</tr>
	<tr valign="middle">
		<td bgcolor="#F3F3F3" >
