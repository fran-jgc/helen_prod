<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/>
	<title>WEBPAY</title>
	<script src="Scripts/AC_RunActiveContent.js" type="text/javascript"></script>
	<link href="style_web_pay_usach.css" rel="stylesheet" type="text/css"></link>
	<script charset="iso-8859-1" src="{K_ROOT_URL}../../commonlib/trunk/script_js/edit_filter.js" type="text/javascript"></script>
	<script language="javascript">
		function isNumberKey(evt){
			/*
			var charCode = (evt.which) ? evt.which : event.keyCode
			if (charCode > 31 && (charCode < 48 || charCode > 57))
				return false;
			return true;
			*/
		}
	</script>
</head>
<body><br />
	<table width="80%" border="0" align="center">
		<tr>
			<td width="15%">
			</td>
			<td width="40%">
				
			</td>
			<td width="50%">
				<table border="0" align="center">
					<tr>
						<td align="left">Fecha Actual: {FECHA_ACTUAL}</td>
					</tr>
				</table>
				<br>
				<br>
			</td>
		</tr>
		<tr>
			<td colspan="2">
				<form action="" method="post">
					<br>
					<br>
					<table width="95%" align="center">
						<tr class="camp_sesion">
							<td colspan="3" height="26">Iniciar Sesion</td>
						</tr>
						<tr class="titulo_2_tabla_left" style="width: 982px">
							<td width="20%" height="26" bgcolor="#F3F3F3">RUT:</td>
							<td width="10%">{RUT}</td>
							<td width="70%" class="glosa_ayuda">(sin puntos, sin digito verificador)<br><font color="#A04514">Ejemplo: 7365895</font></td>
						</tr>
						<tr class="titulo_2_tabla_left">
							<td bgcolor="#F3F3F3">Contrase&ntilde;a:</td>
							<td>{CLAVE}</td>
							<td class="glosa_ayuda">Fecha de Nacimiento (dd/mm/aaaa)<br><font color="#A04514">Ejemplo: 01/12/2013</font></td>
						</tr>
						<tr>
							<td></td>
							<td align="center">
								<input type="submit" name="b_ingresar" id="b_ingresar" value="Ingresar" class="button" />
							</td>							
						</tr>
					</table>
				</form>
			</td>
		</tr>
		<tr>
			<td>
			</td>
		</tr>
	</table>
	
	<br /><br />
	<script>
	if (/Firefox[\/\s](\d+\.\d+)/.test(navigator.userAgent))
		{ //prueba para Firefox/x.x o Firefox x.x (ignorando los números restantes);
			 var ffversion=new Number(RegExp.$1) //capturamos la x.x y la almacenamos como un número
			 if (ffversion<=3)
			 {
				document.write("<p style='color:#FF0000;font-weight:bold;'>Para Realizar Pagos En Internet Debe Usar FireFox 3.0 o Superior..</p>")
			 }	 
		}
		else
		{
			document.write("<p style='color:#FF0000;font-weight:bold;'>Para Realizar Pagos En Internet Debe Usar FireFox 3.0 o Superior..</p>")
			
		}
	</script>
	<table width="60%" align="center" class="tabla_deuda">
		<tr class="deuda_resultado">
			<td bgcolor="#F3F3F3">
			<blockquote>
			  <p><u class="sub_tit_superior">INFORMACI&Oacute;N&nbsp;IMPORTANTE</u><br /> 
			    <br />
			    <span class="glosa_ayuda">
					Se informa a los Ex alumnos del Fondo Solidario de Crédito Universitario que a partir del 15 de Marzo estará disponible la Declaración Jurada 2014.  <br />
					Contacto: <br /><br />
					7181500 - 7181501 - 7181505 -7181507 <br />
					7181508 - 7181511 - 7181512<br /><br />
					FONDO SOLIDARIO DE CRÉDITO UNIVERSITARIO<br />
					AVDA. EL BELLOTO (EX AVDA SUR) 3530<br />
					CASILLA 442 CORREO 2 SANTIAGO
										
			    </p>
			  </blockquote>				
	           <p>&nbsp;</p></td>
	  </tr>
	</table>
	<br><br>
	
	<br><br>
</body>
</html>