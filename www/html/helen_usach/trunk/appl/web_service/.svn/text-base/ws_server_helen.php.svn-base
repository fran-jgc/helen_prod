	  'Retorna todos los datos solicitados'	// documentation
	);
	
	$server->register('ws_wp_init_transaccion',	// method name
      array('ve_cod_wp_transaccion' => 'xsd:string','ve_token' => 'xsd:string'),			// input parameters
