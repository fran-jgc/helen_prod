	,PORC_USACH					  NUMBER			NULL
	,POR_FONDO					  NUMBER			NULL
	,ESTADO_DEUDA 				VARCHAR2(100)	NULL
  	,NOMBRE_UNIVERSIDAD   VARCHAR2(100)	NULL
  	,NOMBRE_CARTERA       VARCHAR2(100)	NULL
	,MONTO_ANO1					  NUMBER(14,4)	NULL
	,MONTO_ANO2					  NUMBER(14,4)	NULL
	,MONTO_ANO3					  NUMBER(14,4)	NULL
	,MONTO_ANO4					  NUMBER(14,4)	NULL
	,MONTO_ANO5					  NUMBER(14,4)	NULL
	,MONTO_ANO6					  NUMBER(14,4)	NULL
	,MONTO_ANO7					  NUMBER(14,4)	NULL
	,MONTO_ANO8					  NUMBER(14,4)	NULL
	,MONTO_ANO9					  NUMBER(14,4)	NULL
	,MONTO_ANO10				  NUMBER(14,4)	NULL
	,MONTO_ANO11				  NUMBER(14,4)	NULL
	,MONTO_ANO12				  NUMBER(14,4)	NULL
	,MONTO_ANO13				  NUMBER(14,4)	NULL
	,MONTO_ANO14				  NUMBER(14,4)	NULL
	,MONTO_ANO15				  NUMBER(14,4)	NULL
	,MONTO_ANO16				  NUMBER(14,4)	NULL
	,MONTO_ANO17				  NUMBER(14,4)	NULL
	,MONTO_9999				    NUMBER(14,4)	NULL
  	,CTY                  NUMBER(14,4)	NULL
  	,CAT                  NUMBER(14,4)	NULL
  	,CRUZADO	            VARCHAR2(100)	NULL
  	,CRUZADO_INTERNO      VARCHAR2(100)	NULL
  	,PRORROGA             VARCHAR2(100)	NULL
  	,SUSPENSION           VARCHAR2(100)	NULL
  	,FECHA_CONDONACION    VARCHAR2(100)	NULL
  	,CUOTA_FIJA           VARCHAR2(100)	NULL
  	,COD_CARRERA	        VARCHAR2(100)	NULL
  	,NOM_CARRERA          VARCHAR2(100)	NULL
	,COD_USUARIO				NUMBER			NULL
  	,FECHA_REGISTRO       DATE NULL
);

create index IND_T_FLUJO_EXIGIBLE_1 on TEMP_FLUJO_EXIGIBLE (COD_USUARIO asc);
create index IND_T_FLUJO_EXIGIBLE_2 on TEMP_FLUJO_EXIGIBLE (COD_DEUDA asc);
