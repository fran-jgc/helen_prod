DROP TABLE   TEMP_FLUJO_EXIGIBLE;


create table TEMP_FLUJO_EXIGIBLE
  ( RUT							    NUMBER			NULL
	,DIG_VERIF					  VARCHAR2(1)		NULL
	,COD_DEUDA          	NUMBER			NULL
	,TIPO_DEUDA					  VARCHAR2(20)	NULL
	,FECHA_INICIO_COBRO		DATE			NULL
