CREATE OR REPLACE PROCEDURE spi_ingreso (ve_codigo NUMBER)
AS
BEGIN
	BEGIN
		-- CH AL DIA
		INSERT INTO TEMP_INF_INGRESO 
					(COD_INGRESO
					,FECHA_INGRESO
					,COD_DEUDOR
					,COD_ESTADO_INGRESO
					,COD_USUARIO
					,NOM_USUARIO
					,RUT
					,DIG_VERIF
					,NOMBRE
					,COD_DEUDA
					,COD_TIPO_DEUDA
					,NOM_TIPO_DEUDA
					,FECHA_VENCTO
					,ANO_COBRO
					,SALDO_TOTAL_PESOS
					,SALDO_TOTAL
					,COD_DOCUMENTO_PAGO_H
					,COD_TIPO_DOCUMENTO_PAGO
					,NOM_TIPO_DOCUMENTO_PAGO
					,NRO_DOCUMENTO_PAGO
					,COD_BANCO
					,COD_PLAZA
					,FECHA_DOCUMENTO_PAGO
					,MONTO
					,NOM_BANCO
					,NOM_PLAZA)
			SELECT	 I.COD_INGRESO
					,FECHA_INGRESO
					,I.COD_DEUDOR
					,I.COD_ESTADO_INGRESO
					,I.COD_USUARIO
					,U.NOM_USUARIO
					,DR.RUT
					,DR.DIG_VERIF
					,DR.APELLIDO_PATERNO || ' ' || DR.APELLIDO_MATERNO || ' ' || DR.NOMBRE  NOMBRE
					,DA.COD_DEUDA
					,TD.COD_TIPO_DEUDA
					,TD.NOM_TIPO_DEUDA
					,TO_CHAR(PP.FECHA_VENCTO, 'DD/MM/YYYY') FECHA_VENCTO
					,PP.ANO_COBRO
					,SALDO_TOTAL_PESOS
					,SALDO_TOTAL
					,DP.COD_DOCUMENTO_PAGO COD_DOCUMENTO_PAGO_H
					,TDP.COD_TIPO_DOCUMENTO_PAGO
					,TDP.NOM_TIPO_DOCUMENTO_PAGO
					,DP.NRO_DOCUMENTO_PAGO  
					,DP.COD_BANCO
					,DP.COD_PLAZA
					,DP.FECHA_DOCUMENTO_PAGO
					,DP.MONTO
					,B.NOM_BANCO
					,P.NOM_PLAZA
			FROM	INGRESO I, ITEM_INGRESO IT LEFT OUTER JOIN PLAN_PAGO PP ON IT.COD_PLAN_PAGO = PP.COD_PLAN_PAGO 
					,DEUDA DA, TIPO_DEUDA TD, USUARIO U, DEUDOR DR
					,DOCUMENTO_INGRESO DI
					,DOCUMENTO_PAGO DP	LEFT OUTER JOIN BANCO B ON DP.COD_BANCO = B.COD_BANCO
										LEFT OUTER JOIN PLAZA P ON DP.COD_PLAZA = P.COD_PLAZA 
					,TIPO_DOCUMENTO_PAGO TDP
			WHERE	I.COD_INGRESO = ve_codigo
			AND		I.COD_USUARIO = U.COD_USUARIO
			AND		I.COD_DEUDOR = DR.COD_DEUDOR
			AND		I.COD_INGRESO = IT.COD_INGRESO
			AND		IT.COD_DEUDA = DA.COD_DEUDA
			AND		DA.COD_TIPO_DEUDA = TD.COD_TIPO_DEUDA
			AND     DI.COD_INGRESO = I.COD_INGRESO
			AND		DP.COD_DOCUMENTO_PAGO = DI.COD_DOCUMENTO_PAGO
			AND		TDP.COD_TIPO_DOCUMENTO_PAGO = DP.COD_TIPO_DOCUMENTO_PAGO;
			
			-- CH A FECHA
		INSERT INTO	TEMP_INF_INGRESO
					(COD_INGRESO
					,FECHA_INGRESO
					,COD_DEUDOR
					,COD_ESTADO_INGRESO
					,COD_USUARIO
					,NOM_USUARIO
					,RUT
					,DIG_VERIF
					,NOMBRE
					,COD_DEUDA
					,COD_TIPO_DEUDA
					,NOM_TIPO_DEUDA
					,FECHA_VENCTO
					,ANO_COBRO
					,SALDO_TOTAL_PESOS
					,SALDO_TOTAL
					,COD_DOCUMENTO_PAGO_H
					,COD_TIPO_DOCUMENTO_PAGO
					,NOM_TIPO_DOCUMENTO_PAGO
					,NRO_DOCUMENTO_PAGO
					,COD_BANCO
					,COD_PLAZA
					,FECHA_DOCUMENTO_PAGO
					,MONTO
					,NOM_BANCO
					,NOM_PLAZA)
			SELECT	 I.COD_INGRESO
					,FECHA_INGRESO
					,I.COD_DEUDOR
					,I.COD_ESTADO_INGRESO
					,I.COD_USUARIO
					,U.NOM_USUARIO
					,DR.RUT
					,DR.DIG_VERIF
					,DR.APELLIDO_PATERNO || ' ' || DR.APELLIDO_MATERNO || ' ' || DR.NOMBRE  NOMBRE
					,DA.COD_DEUDA
					,TD.COD_TIPO_DEUDA
					,TD.NOM_TIPO_DEUDA
					,TO_CHAR(PP.FECHA_VENCTO, 'DD/MM/YYYY') FECHA_VENCTO
					,PP.ANO_COBRO
					,SALDO_TOTAL_PESOS
					,SALDO_TOTAL
					,DP.COD_DOCUMENTO_PAGO COD_DOCUMENTO_PAGO_H
					,TDP.COD_TIPO_DOCUMENTO_PAGO
					,TDP.NOM_TIPO_DOCUMENTO_PAGO
					,DP.NRO_DOCUMENTO_PAGO  
					,DP.COD_BANCO
					,DP.COD_PLAZA
					,DP.FECHA_DOCUMENTO_PAGO
					,DP.MONTO
					,B.NOM_BANCO
					,P.NOM_PLAZA
			FROM	INGRESO I, ITEM_INGRESO IT LEFT OUTER JOIN PLAN_PAGO PP ON IT.COD_PLAN_PAGO = PP.COD_PLAN_PAGO 
					,DEUDA DA, TIPO_DEUDA TD, USUARIO U, DEUDOR DR
					,DOCUMENTO_INGRESO_CH_FECHA DI
					, DOCUMENTO_PAGO DP LEFT OUTER JOIN BANCO B ON DP.COD_BANCO = B.COD_BANCO
										LEFT OUTER JOIN PLAZA P ON DP.COD_PLAZA = P.COD_PLAZA 
					, TIPO_DOCUMENTO_PAGO TDP
			WHERE	I.COD_INGRESO = ve_codigo
			AND		I.COD_USUARIO = U.COD_USUARIO
			AND		I.COD_DEUDOR = DR.COD_DEUDOR
			AND		I.COD_INGRESO = IT.COD_INGRESO
			AND		IT.COD_DEUDA = DA.COD_DEUDA
			AND		DA.COD_TIPO_DEUDA = TD.COD_TIPO_DEUDA
			AND     DI.COD_INGRESO = I.COD_INGRESO
			AND		DP.COD_DOCUMENTO_PAGO = DI.COD_DOCUMENTO_PAGO
			AND		TDP.COD_TIPO_DOCUMENTO_PAGO = DP.COD_TIPO_DOCUMENTO_PAGO;
	END;
END;
/