/////////////////////////////////////////////////////////////
// Se separa por UNIVERSIDAD
$file_name = dirname(__FILE__)."/".K_CLIENTE."/class_wi_ingreso.php";
if (file_exists($file_name))
    require_once($file_name);
else {
    class wi_ingreso extends wi_ingreso_base {
        function __construct($cod_item_menu) {
            parent::__construct($cod_item_menu);
        }
    }
	class dw_documento_pago extends dw_documento_pago_base {
	    function __construct() {
	        parent::__construct();
        }
    }
	class dw_item_ingreso extends dw_item_ingreso_base {
	    function __construct() {
	        parent::__construct();
        }
    }
    
}
?>