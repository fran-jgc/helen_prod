        $this->dws['dw_item_ingreso']                 = new dw_item_ingreso_base();
        $this->dws['dw_documento_pago']             = new dw_documento_pago_base();
        $this->dws['dw_documento_pago_ch_fecha']     = new dw_documento_pago_ch_fecha();

        //CONTROLES
        $this->dws['dw_ingreso']->add_control(new static_text('COD_INGRESO'));
        $this->dws['dw_ingreso']->add_control(new edit_text_upper('RUT_H', 10, 10, 'hidden'));
        $this->dws['dw_ingreso']->add_control(new static_text('DIG_VERIF'));
        $this->dws['dw_ingreso']->add_control(new static_text('NOMBRE'));

        $this->dws['dw_ingreso']->add_control(new edit_text('COD_USUARIO',10, 10, 'hidden'));
        $this->dws['dw_ingreso']->add_control(new static_text('NOM_USUARIO'));
        $this->dws['dw_ingreso']->add_control(new edit_text('COD_DEUDOR',10, 10, 'hidden'));

        $sql_estado_ingreso = sql_ingreso::get_sql('DD_ESTADO_INGRESO');
		$this->dws['dw_ingreso']->add_control(new drop_down_dw('COD_ESTADO_INGRESO', $sql_estado_ingreso, 140, '', false));
        
        $this->dws['dw_ingreso']->add_control($control = new edit_num('TASA_INTERES', 14, 19, 4));
        $control->set_onChange("calc_cheque_fecha();");
        $this->dws['dw_ingreso']->add_control($control = new edit_num('MONTO_CHEQUE_FECHA'));
        $control->set_onChange("calc_cheque_fecha();");
        $this->dws['dw_ingreso']->add_control($control = new edit_num('CANT_CHEQUE_FECHA'));
        $control->set_onChange("calc_cheque_fecha();");
        $this->dws['dw_ingreso']->add_control($control = new edit_date('FECHA_PRIMER_CHEQUE_FECHA'));
        $control->set_onChange("valida_fecha_ch_fecha(this);calc_cheque_fecha();");
        $this->dws['dw_ingreso']->add_control(new edit_text('FECHA_PRIMER_CHEQUE_FECHA_H', 20,20,'hidden'));

        $this->dws['dw_ingreso']->add_control(new static_num('STATIC_MONTO_INTERES'));
        $this->dws['dw_ingreso']->add_control(new static_num('STATIC_MONTO_INTERES2'));
        $this->dws['dw_ingreso']->add_control(new static_num('STATIC_TOTAL'));

        $this->dws['dw_ingreso']->add_control(new static_num('SUMA_MONTO'));
        $this->dws['dw_ingreso']->add_control(new static_num('SUMA_MONTO_CH_FECHA'));

        $this->dws['dw_ingreso']->add_control(new edit_text('SUMA_MONTO_H',20, 20, 'hidden'));
        $this->dws['dw_ingreso']->add_control(new edit_text('STATIC_MONTO_CHEQUE_FECHA_H',20, 20, 'hidden'));
        $this->dws['dw_ingreso']->add_control(new edit_text('VALOR_MONEDA',10, 10, 'hidden'));

