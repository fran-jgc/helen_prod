class dw_documento_pago_ch_fecha extends datawindow{
    
    function __construct() {

        $sql = sql_ingreso::get_sql('DW_DOCUMENTO_PAGO_CH_FECHA');

        parent::__construct($sql, 'DOCUMENTO_PAGO_CH_FECHA', true, true);

        $this->add_control(new edit_text('COD_DOCUMENTO_INGRESO_CH_FECHA', 10,10, 'hidden'));
        $this->add_control($control = new edit_num('NRO_DOCUMENTO_PAGO_CH_FECH', 10, 10));
        $control->set_onChange("cambia_nro_documento(this);");

        $sql = sql_ingreso::get_sql('DD_BANCO');
        $this->add_control($control = new drop_down_dw('COD_BANCO_CH_FECH', $sql, 250));
        $control->set_onChange("cambia_banco(this);");

        $sql = sql_ingreso::get_sql('DD_PLAZA');
        $this->add_control($control = new drop_down_dw('COD_PLAZA_CH_FECH', $sql, 250));
        $control->set_onChange("cambia_plaza(this);");

        $this->add_control($control = new edit_date('FECHA_DOCUMENTO_PAGO_CH_FECH'));
        $control->set_onChange("valida_fecha_ch_fecha(this);modifica_fecha_monto(true);");

        $this->add_control($control = new edit_num('MONTO_CH_FECH',10,10));
        $control->set_onChange("sum_total_documento_pago_ch_fecha(); modifica_fecha_monto(true);");

        $this->add_control($control = new edit_rut('RUT_GIRADOR'));
        $control->set_onChange("cambia_rut_girador(this);");
        $this->add_control($control = new edit_dig_verif('DIG_VERIF_GIRADOR'));
        $control->set_onChange("valida_digito(this, 'RUT_GIRADOR'); this.focus();cambia_rut_girador(this);");

        $this->set_mandatory('COD_BANCO_CH_FECH','Banco');
      	$this->set_mandatory('COD_PLAZA_CH_FECH','Plaza');
    }
    function update($db,$cod_ingreso,$cod_deudor, $cod_familia_deuda){
        $sp = 'spu_documento_ingreso_ch_fecha ';
        for ($i = 0; $i < $this->row_count(); $i++) {
            $statuts = $this->get_status_row($i);
            if ($statuts == K_ROW_NOT_MODIFIED){
                continue;
            }
            // siempre es INSERT
            $nro_documento_pago         = $this->get_item($i, 'NRO_DOCUMENTO_PAGO_CH_FECH');
            $cod_banco                  = $this->get_item($i, 'COD_BANCO_CH_FECH');
            $cod_plaza                  = $this->get_item($i, 'COD_PLAZA_CH_FECH');
            $fecha_documento_pago       = $this->get_item($i, 'FECHA_DOCUMENTO_PAGO_CH_FECH');
            $monto                      = $this->get_item($i, 'MONTO_CH_FECH');
            $rut_girador                = $this->get_item($i, 'RUT_GIRADOR');
            $dig_verif_girador            = $this->get_item($i, 'DIG_VERIF_GIRADOR');
            $nro_documento_pago        = ($nro_documento_pago =='') ? "null" : $nro_documento_pago;
            $cod_banco                = ($cod_banco =='') ? "null" : $cod_banco;
            $cod_plaza                = ($cod_plaza =='') ? "null" : $cod_plaza;
            $fecha_documento_pago    = ($fecha_documento_pago =='') ? "null" : "$fecha_documento_pago";
            $monto                    = ($monto =='') ? 0 : "$monto";

            $rut_girador            = ($rut_girador =='') ? "null" : "$rut_girador";
            $dig_verif_girador        = ($dig_verif_girador =='') ? "null" : "'$dig_verif_girador'";

            if ($fecha_documento_pago != "null"){
                $fecha_documento_pago = $this->str2date($fecha_documento_pago);
            }

            $param = "    $cod_ingreso
                        ,$nro_documento_pago
                        ,$cod_banco
                        ,$cod_plaza
                        ,$fecha_documento_pago
                        ,$monto
                        ,$cod_deudor
                        ,$cod_familia_deuda
                        ,$rut_girador
                        ,$dig_verif_girador";

            if (!$db->EXECUTE_SP($sp, $param)){
                return false;
            }
        }
        return true;
    }
}
class dw_documento_pago_base extends datawindow{
    function __construct() {

        $sql = sql_ingreso::get_sql('DW_DOCUMENTO_PAGO');
        parent::__construct($sql, 'DOCUMENTO_PAGO', true, true);

        $this->add_control(new edit_text('COD_DOCUMENTO_PAGO_H', 2,2, 'hidden'));
        $sql = sql_ingreso::get_sql('DD_TIPO_DOCUMENTO_PAGO');
        $this->add_control(new drop_down_dw('COD_TIPO_DOCUMENTO_PAGO', $sql, 160));
      
        $this->add_control(new edit_text('COD_TIPO_DOCUMENTO_PAGO_H', 2,2, 'hidden'));

        $this->add_control(new edit_num('NRO_DOCUMENTO_PAGO', 20, 16 ,0 ,true, false, false));

        $sql = sql_ingreso::get_sql('DD_BANCO');
        $this->add_control(new drop_down_dw('COD_BANCO', $sql, 120));

        $sql = sql_ingreso::get_sql('DD_PLAZA');
        $this->add_control(new drop_down_dw('COD_PLAZA', $sql, 120));

        $db = new database(K_TIPO_BD, K_SERVER, K_BD, K_USER, K_PASS);
        $sql = sql_ingreso::get_sql('FECHAS');
        $result = $db->build_results($sql);
        $fecha_60_dias_antes = $result[0]['FECHA_60_DIAS_ANTES'];
        $fecha_ult_dia_mes = $result[0]['FECHA_ULT_DIA_MES'];

        $this->add_control($control = new edit_date('FECHA_DOCUMENTO_PAGO', 10, 10));
        $control->set_onChange("valida_ch_al_dia('$fecha_ult_dia_mes','$fecha_60_dias_antes'); fecha_deposito_ingreso(this);");
        $this->add_control($control = new edit_num('MONTO'));
        $control->set_onChange("sum_total_documento_pago();");

        //MANDATORY
        $this->set_mandatory('COD_TIPO_DOCUMENTO_PAGO', 'Tipo Documento');
    }
    function fill_record(&$temp, $record) {
        parent::fill_record($temp, $record);
        $row = $this->redirect($record);
        if ($this->entrable)
            $eliminar = '<img src="../../../../commonlib_seven/trunk/images/b_delete_line.jpg" onClick="del_line_doc(\''.$this->label_record.'_'.$row.'\', \''.$this->nom_tabla.'\');" style="cursor:pointer"/>';
        else
            $eliminar = '<img src="../../../../commonlib_seven/trunk/images/b_delete_line_d.jpg"/>';
        $temp->setVar($this->label_record.".ELIMINAR_".strtoupper($this->label_record), $eliminar);
    }
    function update($db,$cod_ingreso,$cod_deudor,$cod_familia_deuda){
        $sp = 'spu_documento_ingreso ';
        for ($i = 0; $i < $this->row_count(); $i++) {
            $statuts = $this->get_status_row($i);
            if ($statuts == K_ROW_NOT_MODIFIED){
                continue;
            }
            // siempre es INSERT

            $cod_tipo_documento_pago    = $this->get_item($i, 'COD_TIPO_DOCUMENTO_PAGO');
            $nro_documento_pago         = $this->get_item($i, 'NRO_DOCUMENTO_PAGO');
            $cod_banco                  = $this->get_item($i, 'COD_BANCO');
            $cod_plaza                  = $this->get_item($i, 'COD_PLAZA');
            $fecha_documento_pago       = $this->get_item($i, 'FECHA_DOCUMENTO_PAGO');
            $monto                      = $this->get_item($i, 'MONTO');

            $nro_documento_pago        = ($nro_documento_pago =='') ? "null" : $nro_documento_pago;
            $cod_banco                = ($cod_banco =='') ? "null" : $cod_banco;
            $cod_plaza                = ($cod_plaza =='') ? "null" : $cod_plaza;
            $fecha_documento_pago    = ($fecha_documento_pago =='') ? "null" : "$fecha_documento_pago";
            $monto                    = ($monto =='') ? 0 : "$monto";

            if ($fecha_documento_pago != "null"){
                $fecha_documento_pago = $this->str2date($fecha_documento_pago);
            }

            $param = "    $cod_ingreso
                        ,$cod_tipo_documento_pago
                        ,$nro_documento_pago
                        ,$cod_banco
                        ,$cod_plaza
                        ,$fecha_documento_pago
                        ,$monto
                        ,$cod_deudor
                        ,$cod_familia_deuda";

            if (!$db->EXECUTE_SP($sp, $param)){
                return false;
            }
        }
        return true;
    }
}


class dw_item_ingreso_base extends datawindow{
    function __construct() {

        $sql = sql_ingreso::get_sql('DW_ITEM_INGRESO');

        parent::__construct($sql, 'ITEM_INGRESO', true, true);

        $this->add_control($control = new edit_check_box('SELECCION', 'S', 'N'));
        if (K_CLIENTE=="USACH"){
        	$control->set_onChange("valida_pago_99_usach(this);");
        }else{
        	$control->set_onChange("asigna_totales(this);valida_morosa(this);");
        }
        
        if (K_CLIENTE=="UPLA"){
           	$control->set_onChange("asigna_totales(this);valida_morosa(this);comprueba_seleccion(this);");
        }
        
        $this->add_control(new static_text('COD_DEUDA'));
        $this->add_control(new edit_text('COD_DEUDA_H', 20,20, 'hidden'));
        $this->add_control(new edit_text('NRO_CUOTA_H', 20,20, 'hidden'));
        $this->add_control(new static_text('COD_TIPO_DEUDA'));
        $this->add_control(new static_text('SIMBOLO'));
        $this->add_control(new static_text('ANO_COBRO'));
        $this->add_control(new edit_text('COD_PLAN_PAGO', 10,10, 'hidden'));
        $this->add_control(new static_text('FECHA_VENCTO'));
        $this->add_control(new static_num('SALDO_CUOTA', 4));
        $this->add_control(new edit_text('SALDO_CUOTA_H', 10,10, 'hidden'));
        $this->add_control(new static_num('SALDO_MULTA', 4));
        $this->add_control(new edit_text('SALDO_MULTA_H', 10,10, 'hidden'));
        $this->add_control(new static_num('SALDO_TOTAL', 4));
        $this->add_control(new edit_text('SALDO_TOTAL_H', 10,10, 'hidden'));
        $this->add_control(new static_num('SALDO_TOTAL_PESOS'));
        $this->add_control(new edit_text('SALDO_TOTAL_PESOS_H', 10,10, 'hidden'));
        $this->add_control(new static_num('MONTO_PAGO', 4));
        $this->add_control(new edit_text('MONTO_PAGO_H', 10,10, 'hidden'));
        $this->add_control(new static_num('MONTO_PAGO_PESOS'));
        $this->add_control(new edit_text('MONTO_PAGO_PESOS_H', 10,10, 'hidden'));
        $this->add_control(new edit_text('COD_FAMILIA_DEUDA_H', 10, 10, 'hidden'));
        $this->add_control(new edit_text('COD_SUB_BOLETA_H', 10, 10, 'hidden'));
		
        $sql = sql_ingreso::get_sql('DD_TIPO_DESCUENTO');
       	$this->add_control($control = new drop_down_dw('COD_TIPO_DESCUENTO', $sql, 50));
        $control->set_onChange("change_descuento(this);");
        
        $this->add_control($control = new edit_porcentaje('PORC_DESCUENTO'));
		$control->set_onChange("change_porc_descuento(this);");
		
        $this->add_control(new static_num('MONTO_DESCUENTO', 4));
        $this->add_control(new edit_text('MONTO_DESCUENTO_H', 10,10, 'hidden'));
        $this->add_control(new edit_text('SALDO_TOTAL_SIN_DESCTO_H', 10,10, 'hidden'));

    }

    function update($db,$cod_ingreso){
        $sp = 'spu_item_ingreso ';
        for ($i = 0; $i < $this->row_count(); $i++) {
            $statuts = $this->get_status_row($i);
            if ($statuts == K_ROW_NOT_MODIFIED){
                continue;
            }
            // siempre es INSERT
            $operacion                    = 'INSERT';
            $cod_item_ingreso            = $this->get_item($i, 'COD_ITEM_INGRESO');
            $seleccion                    = $this->get_item($i, 'SELECCION');
            $cod_deuda                    = $this->get_item($i, 'COD_DEUDA_H');
            $cod_plan_pago                = $this->get_item($i, 'COD_PLAN_PAGO');
            $saldo_cuota                = $this->get_item($i, 'SALDO_CUOTA_H');
            $saldo_multa                = $this->get_item($i, 'SALDO_MULTA_H');
            $cod_tipo_descuento         = $this->get_item($i, 'COD_TIPO_DESCUENTO');
            $monto_descuento            = $this->get_item($i, 'MONTO_DESCUENTO_H');
            $saldo_total                = $this->get_item($i, 'SALDO_TOTAL_H');
            $saldo_total_pesos            = $this->get_item($i, 'SALDO_TOTAL_PESOS_H');
            $monto_pago                    = $this->get_item($i, 'MONTO_PAGO_H');
            $monto_pago_pesos            = $this->get_item($i, 'MONTO_PAGO_PESOS_H');
            $cod_sub_boleta                = $this->get_item($i, 'COD_SUB_BOLETA');
            $porc_descuento 			= $this->get_item($i, 'PORC_DESCUENTO');

            $cod_item_ingreso    = ($cod_item_ingreso =='') ? "null" : $cod_item_ingreso;
            $cod_plan_pago        = ($cod_plan_pago =='') ? "null" : $cod_plan_pago;
            $cod_tipo_descuento    = ($cod_tipo_descuento =='') ? "null" : $cod_tipo_descuento;
            $monto_descuento    = ($monto_descuento =='') ? 0 : $monto_descuento;
            $cod_sub_boleta        = ($cod_sub_boleta =='') ? "null" : $cod_sub_boleta;
			$porc_descuento		= ($porc_descuento =='') ? "null" : $porc_descuento;
			
            $param = "    '$operacion'
                        ,$cod_item_ingreso
                        ,'$seleccion'
                        ,$cod_ingreso
                        ,$cod_deuda
                        ,$cod_plan_pago
                        ,$saldo_cuota
                        ,$saldo_multa
                        ,$cod_tipo_descuento
                        ,$monto_descuento
                        ,$saldo_total
                        ,$saldo_total_pesos
                        ,$monto_pago
                        ,$monto_pago_pesos
                        ,$cod_sub_boleta
                        ,$porc_descuento";

            if (!$db->EXECUTE_SP($sp, $param)){
                return false;
            }
        }
        return true;
    }
}

class wi_ingreso_base extends w_input {
    
    const K_ESTADO_EMITIDO    = 1;
    const K_ESTADO_ANULADO     = 2;
    const K_ESTADO_CERRADO     = 3;
    const K_ESTADO_POR_RENDIR  = 4;

    const K_TASA_INT_CH_FECHA= 22;
    const K_PARAM_MAX_NUM_CH = 23;
    const K_ESTADO_DOC_PROTESTADO = 3;

    const K_AUTORIZA_ANULACION = '990510';
    const K_ESTADO_SIMULACION        = 1000;
    const K_PARAM_MAX_VALIDEZ_SIMULACION = 24;
    const K_FAMILIA_CI_UACH        		= 2;

    const K_DEPOSITO = 3;

    function __construct($cod_item_menu) {
        
