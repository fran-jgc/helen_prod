<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<title></title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">
<script charset="utf-8" src="../../../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="../proc_common/barra_avance.js" type="text/javascript"></script>
<script type="text/javascript">
function validate_load_pdf() {
	var vl_cod_tipo_deuda_value = document.getElementById('COD_TIPO_DEUDA_0').value;
	var vl_cod_ejecucion_proceso_value = document.getElementById('COD_EJECUCION_PROCESO_0').value;
	if (vl_cod_tipo_deuda_value == '') {
		alert("Debe seleccionar un tipo de deuda.");
		return false;
	}else if (vl_cod_ejecucion_proceso_value == '') {
		alert("Debe seleccionar una ejecución proceso.");
		return false;
	}
	else{
		return true;
	}
}

function validate_load_carta() {
	var vl_cod_tipo_deuda_value = document.getElementById('COD_TIPO_DEUDA_0').value;
	var vl_cod_ejecucion_proceso_value = document.getElementById('COD_EJECUCION_PROCESO_0').value;
	if (vl_cod_tipo_deuda_value == '') {
		alert("Debe seleccionar un tipo de Deuda.");
		return false;
	}
	else if(vl_cod_ejecucion_proceso_value == '') {
		alert("Debe seleccionar una ejecución proceso.");
		return false;
	}
	else{
		return true;
	}
}
</script>
</head>
<body><!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js" type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->

<form action="" method="post" name="input" id="input">
<input name="wi_hidden" id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
	<!-- menu superior-->
		<td width="1000"  height="51" align="center" id="awmAnchor-menu" style="width:100px; height:50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="520" border="0">
							<tr>
								<td height="100%"><div class="titulo_central_parametro">{WP_RUTA_MENU}</div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WP_FECHA_ACTUAL}</font></div></td>
							</tr>
							<tr>
								<td height="0%"><div class="tit_superior"><font color="#999999">{WP_NOM_USUARIO}</font></div></td>
							</tr>
						</table>
					</td> 
				</tr>
			</table>
		</td>
	</tr>  
	<tr bgcolor="#FFFFFF">
	  	<td>
			<table width="1000" border="0" align="center">
				<tr>
					<td height="95" valign="top">
						<table width="1015" border="0" align="center" >
							<tr valign="top">
								<td>						
									<div style="height:526px;" class="claro">																					
										<table width="1000" rules="none" border="0" align="center" class="claro">							
												<tr class="titulo_tabla">				
													<td colspan="6" >CUPONERAS</td>
												</tr>
										</table>
										<table width="1000" rules="none" border="1" style="padding-top:5px;"align="center" class="claro">										
											<tr class="titulo_tabla">				
												<td colspan="6" ></td>
											</tr>
											<tr class="encabezado_right">
												<td width="200"><div class="encabezado_right">Descripci&oacute;n del Proceso</div></td>
												<td width="800" class="claro" align="left">
												<div style="overflow-x:hidden; overflow-y:auto; height:100; widht:100%;">
													<table width="100%" border="0"align="left" rules="none" class="claro" style="padding-top:5px;">
														<tr>
															<td>Despliega cupones
															</td>																												
														</tr>
													</table>
												</div>
												</td>														
											</tr>
										</table>	
										<br><br>										
										<table width="1000" rules="none" border="1" align="center" class="claro" style="display:{LAST_DISPLAY_EJECUCION}">							
												<tr class="titulo_tabla">				
													<td colspan="6" >ULTIMA EJECUCION</td>
												</tr>
												<tr class="encabezado_right">
													<td width="200">Fecha:</td>
													<td width="300" class="claro" align="left">{LAST_FECHA_EJECUCION_PROCESO}</td>	
													<td width="150">Duración:</td>
													<td width="350" class="claro" align="left">{LAST_DURACION}<label style="color:#FF0000">{LAST_NOM_USUARIO_CANCELA}</label></td>	
												</tr>
												<tr class="encabezado_right">
													<td>Usuario:</td>
													<td class="oscuro" align="left" colspan="3">{LAST_NOM_USUARIO}</td>
												</tr>
												<tr class="encabezado_right">
													<td>Registros procesados:</td>
													<td class="claro" align="left">{LAST_ACTUAL_REGISTRO}</td>
													<td>Errores:</td>
													<td class="claro" align="left">{LAST_CANT_ERROR} errores, {LAST_CANT_WARNING} alertas</td>
												</tr>
										</table>
										<br><br>
										<table width="1000" rules="none" border="1" align="center" class="claro">							
												<tr class="titulo_tabla">				
													<td colspan="6" >EJECUTAR PROCESO</td>
												</tr>
												<tr class="encabezado_right">
													<td width="200">Seleccionar Tipo Deuda:</td>
													<td class="claro" align="left">{COD_TIPO_DEUDA}</td>
													<td>Ejecución Proceso:</td>
													<td colspan = "3" class="claro" align="left">{COD_EJECUCION_PROCESO}</td>
														
											    </tr>
											    <tr class="encabezado_right">
													<td width="200">Genera Cuponera:</td>
													<td class="oscuro" align="left">
														<input type="submit"  class="Button" align="left" name="b_pdf" id="b_pdf" value="Crea Pdf..." onClick="return validate_load_pdf();"/>
													</td>
													<td>Genera Cartas:</td>
													<td class="oscuro" align="left">
														<input type="submit"  class="Button" align="left" name="b_carta" id="b_carta" value="Crea Carta..." onClick="return validate_load_carta();"/>
													</td>
													<td>Genera Mail:</td>
													<td class="oscuro" align="left">
														<input type="submit"  class="Button" align="left" name="b_mail" id="b_mail" value="Crea Mail..." onClick="return validate_load_carta();"/>
													</td>
												</tr>
												
												<tr class="encabezado_right">
													<td width="200">Iniciado:</td>
													<td width="300" class="oscuro" align="left">{ACTUAL_FECHA_EJECUCION_PROCESO}</td>	
													<td width="150">Tiempo transcurrido:</td>
													<td colspan="3" class="oscuro" align="left">{ACTUAL_DURACION}</td>	
												</tr>
												<tr class="encabezado_right">
													<td>Usuario:</td>
													<td class="claro" align="left" colspan="5">{ACTUAL_NOM_USUARIO}</td>
												</tr>
												<tr class="encabezado_right">
													<td>Registros procesados:</td>
													<td class="oscuro" align="left">{ACTUAL_ACTUAL_REGISTRO}</td>
													<td>Errores:</td>
													<td colspan="3" class="oscuro" align="left">{ACTUAL_CANT_ERROR} errores, {ACTUAL_CANT_WARNING} alertas</td>
												</tr>
										</table>
									</div>	
								</td>
							</tr>
						</table>
						<table width="1000" border="0" align="center">
				<tr valign="middle">
					  <td>{WP_BACK}</td>
				</tr>
			</table> 		
					</td>	
				</tr>  
			</table>
		</td>
	</tr>
</table>		
</form>
</body>
</html>