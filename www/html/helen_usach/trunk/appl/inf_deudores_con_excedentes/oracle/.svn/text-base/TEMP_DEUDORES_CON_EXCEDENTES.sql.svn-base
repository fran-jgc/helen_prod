create global temporary table TEMP_DEUDORES_CON_EXCEDENTES
  ( COD_EXCEDENTE         NUMBER
  ,FECHA_EXCEDENTE        DATE
  ,RUT							      VARCHAR2(20)
  ,NOMBRE                 VARCHAR2(100)
  ,APELLIDO_PATERNO       VARCHAR2(100)
  ,DIRECCION              VARCHAR2(100)
  ,NOM_COMUNA             VARCHAR2(100)
  ,NOM_CIUDAD             VARCHAR2(100)
  ,TELEFONO               VARCHAR2(100)
  ,EMAIL                  VARCHAR2(100)
  ,MONTO_EXCEDENTE        NUMBER
)
on commit delete ROWS;
