<Report>
	<Font name="Arial" size="7" style="" id="ArialSmall"/>
	<Font name="Arial" size="7" style="" id="ArialSmallBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="17" style="B" id="ArialBoldBigB" red="0" green="0" blue="128"/>
	<Font name="Arial" size="8" style="B" id="ArialBold"/>
	<Font name="Arial" size="8" style="" id="Arial"/>
	<PageHeader>	
		<Cell text="" height="40" newline="1"/>
		<Cell text="{str_fecha_hora}" align="R" font="ArialSmall" newline="1" />
		<Cell text="Pag. {SectionPageNumber}/{snb}" align="R" font="ArialSmall" newline="1" />
		<Cell text="RECAUDACIÓN POR ENTIDAD" width="100%" align="C" newline="1" font="ArialBoldBigB"/>
		<Cell text="{str_filtro}" width="100%" align="C" newline="1" font="ArialSmallBlue"/>
		<Cell text="" height="10" newline="1"/>		
	</PageHeader>
	<Content font="Arial">
		<Cell text="{RUT}" width="25%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{FECHA_ABONO}" width="25%" align="C" border="LRTB" font="Arial"/>		
		<Cell text="{MONTO_ABONO}" width="50%" align="R" border="LRTB" format="N4,." font="Arial" newline="1"/>
	</Content>
	<Group>
		<Variable name="sum_abono" function="SUM" value="MONTO_ABONO"/>
		<GroupHeader>
			<Cell text="Rut" width="25%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Fecha" width="25%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Monto" width="50%" align="C" border="LRTB" font="ArialSmallBlue" newline="1"/>
</GroupHeader>
		<GroupFooter>
			<Cell text="Total:" width="50%" align="R" font="ArialBold"/>	
			<Cell text="{sum_abono}" width="50%"  align="R" border="LRTB" format="N4,." font="ArialBold" newline="1"/>
		</GroupFooter> 
	</Group>
</Report>