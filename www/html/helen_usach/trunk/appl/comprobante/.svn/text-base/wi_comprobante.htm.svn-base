<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="comprobante.js" type="text/javascript"></script>
<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />
{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js"
	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input" enctype="multipart/form-data"><input name="wi_hidden" id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu" style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0">
				<tr>
					<td>
						<table width="520" border="0">
							<tr>
								<td height="100%">
								<div class="titulo_central">{WI_RUTA_MENU}</div>
								</td>
							</tr>
							<tr>
								<td height="0%">
								<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}
								</font></div>
								</td>
							</tr>
							<tr>
								<td height="0%">
								<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}
								</font></div>
								</td>
							</tr>
						</table>
					</td>
					<td width="408" colspan="6"><div align="right">{WI_NO_SAVE}&nbsp;{WI_SAVE}&nbsp;{WI_MODIFY}&nbsp;<input type="image" onmouseover="MM_swapImage('b_export','','../../../../commonlib_seven/trunk/images/b_export_over.jpg',1)" onmouseout="MM_swapImgRestore()" onmouseup="MM_swapImgRestore()" onmousedown="MM_swapImage('b_export','','../../../../commonlib_seven/trunk/images/b_export_click.jpg',1)" src="../../../../commonlib_seven/trunk/images/b_export.jpg" id="b_export" name="b_export">&nbsp;{WI_PRINT}</div></td>
				</tr>
			</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
			<table width="1000" border="0" align="center">
				<tr>
					<td height="95">
						<table width="1015" border="0" align="center">
							<tr valign="top">
								<td height="520">
									<div id="TabbedPanels1" class="TabbedPanels">
										<ul class="TabbedPanelsTabGroup">
											<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_200505}">Comprobante</li>
											<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_200510}">Análitico Comprobante</li>
										</ul>
										<div class="TabbedPanelsContentGroup">
											<!--INI COMPROBANTE-->
											<div class="TabbedPanelsContent">
												<table width="1000" border="1" rules="none" align="center">
													<tr class="titulo_tabla">
														<td colspan="6">COMPROBANTE</td>
													</tr>
													<tr class="encabezado_right">
														<td width="166">Cod. Comprobante:</td>
														<td width="166" class="claro" align="left">{COD_COMPROBANTE}</td>
														<td width="166">Fecha:</td>
														<td width="166" class="claro" align="left">{FECHA_COMPROBANTE}</td>
														<td width="166">Usuario:</td>
														<td width="166" class="claro" align="left">{NOM_USUARIO}{COD_USUARIO}</td>
													</tr>
													<tr class="encabezado_right">
														<td width="166">Nro. Comprobante:</td>
														<td width="166" class="claro" align="left">{NRO_COMPROBANTE}</td>
														<td>Glosa:</td>
														<td colspan="4" class="oscuro" align="left">{NOM_COMPROBANTE}</td>
													</tr>
													<tr class="encabezado_right">
														<td>Familia Deuda:</td>
														<td class="claro" colspan="2" align="left">{COD_FAMILIA_DEUDA}
														</td>
														<td>Tipo Comprobante:</td>
														<td colspan="2" class="claro" align="left">{COD_TIPO_COMPROBANTE}
														</td>
													</tr>
													<tr class="encabezado_right">
														<td>Comprobante:</td>
														<td class="oscuro" colspan="5" align="left">{COD_ORIGEN_COMPROBANTE_H}{NOM_ORIGEN_COMPROBANTE}</td>
													</tr>	
													<tr class="encabezado_right">
														<td>Estado:</td>
														<td class="claro" align="left">{COD_ESTADO_COMPROBANTE}</td>
														<td class="claro" align="left">{COD_USUARIO_ESTADO_H}{NOM_USUARIO_ESTADO}</td>
														<td class="claro" colspan="3" align="left">{FECHA_ESTADO}{FECHA_ESTADO_H}</td>
													</tr>
													
												</table>
											<P />
												<table width="1000" border="1" rules="none" align="center">
													<tr class="titulo_tabla">
														<td colspan="5">DETALLE CUENTAS</td>
													</tr>
													<tr class="encabezado_center">
														<td width="410">Cuenta</td>
														<td width="100">Debe</td>
														<td width="100">Haber</td>
														<td width="50">Elim.</td>
													</tr>
												</table>
											<div style="overflow-x:hidden; overflow-y:auto; height:180; margin-top:-1em;">						
												<table width="1000" border="1" rules="none" align="center" id="DETALLE_CUENTA">
													<!-- startBlock(DETALLE_CUENTA) -->
													<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
														<td width="410" align="left">{COD_ITEM_COMPROBANTE_H}{COD_CUENTA_CONTABLE}{COD_COMPROBANTE_H}</td>
														<td width="100" align="right">{DEBE}{DEBE2}</td>
														<td width="100" align="right">{HABER}{HABER2}</td>
														<td width="50" align="center" >{ELIMINAR_DETALLE_CUENTA}</td>
													</tr>
													<!-- endBlock(DETALLE_CUENTA) -->
												</table>
												<table width="1000" border="1" rules="none" align="center" >
													<tr class="encabezado_right">
														<td width="410">TOTAL</td>
														<td width="100" class="claro" align="right">{SUM_DEBE2}</td>
														<td width="100" class="claro" align="right">{SUM_HABER2}</td>
														<td width="50"></td>
													</tr>
												</table>
											</div>
												<table width="1000" rules="none" border="1" align="center" id="ADD_DETALLE_CUENTA">
													<tr class="claro">
														<td align="left">{AGREGAR_DETALLE_CUENTA}</td>
													</tr>
												</table>
											</div><!--FIN COMPROBANTE-->
										<!--INI ANALITICO_COMPROBANTE-->
										<div class="TabbedPanelsContent">
											<div width="1000" style="display:{DISPLAY_ANALITICO}">											
												<table width="1000" border="1" rules="none" align="center">
													<tr class="titulo_tabla">
														<td colspan="6">ANALITICO COMPROBANTE</td>
													</tr>
													<tr class="encabezado_center">
														<td width="10%">Rut Deudor</td>
														<td width="11%">Nº Deuda</td>
														<td width="23%">Tipo Deuda</td>
														<td width="34%">Cuenta</td>
														<td width="11%">Monto Debe</td>
														<td width="11%">Monto Haber</td>
													</tr>
												</table>
												<div style="overflow-x:hidden; overflow-y:auto; height:350; margin-top:0em;">						
													<table width="1000" border="1" rules="none" align="center" id="ANALITICO_COMPROBANTE">
														<!-- startBlock(ANALITICO_COMPROBANTE) -->
														<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
															<td width="10%" align="center">{RUT}-{DIG_VERIF}{COD_ANALITICO_COMPROBANTE}</td>
															<td width="11" align="right">{COD_DEUDA}</td>
															<td width="23%" align="left">{NOM_TIPO_DEUDA}</td>
															<td width="34%" align="left">{COD_CUENTA_CONTABLE_CC}</td>
															<td width="11%" align="right">{MONTO_DEBE}{MONTO_DEBE_H}</td>
															<td width="11%" align="right"><div style="padding-right:13px;">{MONTO_HABER}{MONTO_HABER_H}</div></td>
														</tr>
														<!-- endBlock(ANALITICO_COMPROBANTE) -->
													</table>
												</div>
												<div style="overflow-x:hidden; overflow-y:auto; height:30; margin-top:0em;">	
													<table width="1000" border="1" rules="none" align="center" >
														<tr class="encabezado_right">
															<td width="78%">TOTAL:</td>
															<td width="11%" class="claro">{SUM_MONTO_DEBE_H}</td>
															<td width="11%" class="claro"><div style="padding-right:13px;">{SUM_MONTO_HABER_H}</div></td>
														</tr>
													</table>
												</div>
											</div>
											<div width="1000" style="display:{DISPLAY_MENSAJE_ANALITICO};">
												<table width="1000" border="1" rules="none" align="center" height="480">
													<tr class="titulo_tabla" valign="top">
														<td colspan="6" align="left" style="padding-left:10px;padding-top:10px; color:#0066CC;font-size:18px;">Anal&iacute;tico contiene demasiada informaci&oacute;n, favor usar bot&oacute;n &quot;Exportar&quot;.</td>
													</tr>
												</table>
											</div>
										</div><!--FIN ANALITICO_COMPROBANTE-->																				
								</div><!--FIN TabbedPanelsContentGroup-->
							</div>
						</td>						
					</tr>
				</table>
				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</form>
<script type="text/javascript">
<!--
var TabbedPanels1 = new Spry.Widget.TabbedPanels("TabbedPanels1");
//-->
</script>
</body>
</html>