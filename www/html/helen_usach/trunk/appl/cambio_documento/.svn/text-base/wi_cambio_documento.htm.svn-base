<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML//EN">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>Sistema Helen</title>
<link href="{W_CSS}" rel="stylesheet" type="text/css">

<script src="../../../../commonlib_seven/trunk/script_js/SpryTabbedPanels.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/edit_filter.js" type="text/javascript"></script>
<script charset="utf-8" src="{K_ROOT_URL}../../commonlib_seven/trunk/script_js/general.js" type="text/javascript"></script>
<script charset="utf-8" src="cambio_documento.js" type="text/javascript"></script>
<link href="../../../../commonlib_seven/trunk/css/SpryTabbedPanels.css" rel="stylesheet" type="text/css" />

<style type="text/css">
<!--
.Estilo1 {
	color: #FF0000;
	font-weight: bold;
}

.Estilo2 {
	color: #993300;
	font-weight: bold;
	align: right;
}
-->
</style>


{WI_JAVA_SCRIPT}
</head>
<body {WI_ONLOAD}>
<!-- DO NOT MOVE! The following AllWebMenus linking code section must always be placed right AFTER the BODY tag-->
<!-- ******** BEGIN ALLWEBMENUS CODE FOR menu ******** -->
<script type="text/javascript">var MenuLinkedBy="AllWebMenus [4]",awmMenuName="menu",awmBN="740";awmAltUrl="";</script>
<script charset="UTF-8" src="{K_ROOT_URL}menu/menu.js"
	type="text/javascript"></script>
<script type="text/javascript">{W_MENU}</script>
<!-- ******** END ALLWEBMENUS CODE FOR menu ******** -->
<form action="" method="post" name="input" id="input"
	enctype="multipart/form-data"><input name="wi_hidden"
	id="wi_hidden" type="hidden" value="">
<table width="1050" border="0" align="center">
	<tr bgcolor="#FFFFFF">
		<!-- menu superior-->
		<td width="1000" height="51" align="center" id="awmAnchor-menu"
			style="width: 100px; height: 50px;"></td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0">
			<tr>
				<td>
				<table width="520" border="0">
					<tr>
						<td height="100%">
						<div class="titulo_central">{WI_RUTA_MENU}</div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_ACTUAL}
						</font></div>
						</td>
					</tr>
					<tr>
						<td height="0%">
						<div class="tit_superior"><font color="#999999">{WI_FECHA_MODIF}
						</font></div>
						</td>
					</tr>
				</table>
				</td>
				<td width="68"></td>

				<td width="68">{WI_PRINT}</td>
				<td width="68"{DISABLE_BUTTON}>{WI_DELETE}</td>
				<td width="68">{WI_NO_SAVE}</td>
				<td width="68">{WI_SAVE}</td>
				<td width="68">{WI_MODIFY}</td>
			</tr>
		</table>
		</td>
	</tr>
	<tr bgcolor="#FFFFFF">
		<td>
		<table width="1000" border="0" align="center">
			<tr>
				<td height="95">
				<table width="1015" border="0" align="center">
					<tr valign="top">
						<td>

						<div id="TabbedPanels1" class="TabbedPanels">
							<ul class="TabbedPanelsTabGroup">
								<li class="TabbedPanelsTab" tabindex="0" style="display: {TAB_152305}">Cambio Documentos</li>
							</ul>
						<div style="height:500px;" class="TabbedPanelsContentGroup">
						<!--INI DOCUMENTOS-->
						<div class="TabbedPanelsContent">
							<table width="1000" border="1" rules="none" align="center">
								<tr class="encabezado_right">
									<td width="166">Nº Cambio Documento:</td>
									<td width="166" class="claro" align="left">{COD_CAMBIO_DOCUMENTO}</td>
									<td width="166">Fecha:</td>
									<td width="166" class="claro" align="left">{FECHA_CAMBIO_DOCUMENTO}</td>
									<td width="166">Usuario:</td>
									<td width="166" class="claro" align="left">{COD_USUARIO}{NOM_USUARIO}</td>
								</tr>
								<tr class="encabezado_right">
									<td>Rut:</td>
									<td class="oscuro" align="left">{RUT}-{DIG_VERIF}</td>
									<td>Nombre:</td>
									<td colspan="3" class="oscuro" align="left">{NOMBRE}{APELLIDO_PATERNO}{COD_DEUDOR}{COD_DEUDA}</td>
								</tr>
								<tr class="encabezado_right">
									<td>Familia Deuda:</td>
									<td colspan="5" class="claro" align="left">{COD_FAMILIA_DEUDA}</td>
								</tr>
							</table>
							<table width="1000" border="1" rules="none">
								<tr>
									<td>
									<table width="1000" border="1" rules="none" align="center">
										<tr class="titulo_tabla">
											<td colspan="6">DOCUMENTO ORIGINAL</td>
										</tr>
										<tr class="encabezado_center">
											<td width="70">Selección</td>
											<td width="190">Tipo Documento Pago</td>
											<td width="190">Estado Documento</td>
											<td width="100">Nº Doc.</td>
											<td width="200">Banco</td>
											<td width="200">Plaza</td>
											<td width="100">Fecha Documento</td>
											<td width="140">Monto</td>
										</tr>
									</table>
									<div style="overflow-x: hidden; overflow-y: auto; height: 100; margin-top: 0em;">
										<table width="1000" border="1" rules="none" align="center" ID="DOCUMENTO_ORIGINAL">
											<!-- startBlock(DOCUMENTO_ORIGINAL) -->
											<tr class="{DW_TR_CSS}" id="{DW_TR_ID}" style="display:{DISPLAY_TR}">
												<td width="88" align="center">{SELECCION}{COD_DOCUMENTO_PAGO_DO_H}{COD_DOCUMENTO_ORIGINAL}{COD_FAMILIA_DEUDA_H}{COD_DEUDOR_DOC_ORI}</td>
												<td width="215" align="left">{NOM_TIPO_DOCUMENTO_PAGO}</td>
												<td width="200" align="left">{NOM_ESTADO_DOCUMENTO_PAGO}</td>
												<td width="113" align="right">{NRO_DOCUMENTO_PAGO_DO}</td>
												<td width="210" align="left">{NOM_BANCO}</td>
												<td width="200" align="left">{NOM_PLAZA}</td>
												<td width="100" align="center">{FECHA_DOCUMENTO_PAGO_DO}</td>
												<td width="140" align="right"><div style="padding-right:20px;">{MONTO_DO}{SELECCION_V}{MONTO_SELECCIONADO}<div style="padding-right:20px;"></td>
											</tr>
											<!-- endBlock(DOCUMENTO_ORIGINAL) -->
										</table>
									</div>
									</td>
								</tr>
								<tr>
								<td>
								<table width="1000" border="1" rules="none" align="center">
									<tr class="encabezado_right">
										<td width="860" colspan="5" align="right">SUBTOTAL</td>
										<td width="140" class="titulo_tabla_right_oscuro" width="150"><div style="padding-right:20px;">{SUM_MONTO_SELECCIONADO}</div></td>
									</tr>
								</table>
							</tr>
							</table>
							<table width="1000" border="0" rules="none" align="center">
								<tr class="encabezado_right">
									<td width="166">Monto Recargo:</td>
									<td width="166" class="oscuro" align="left">{RECARGO}</td>
									<td width="166">Monto Descuento:</td>
									<td width="166" class="oscuro" align="left">{DESCUENTO}</td>
									<td width="166">TOTAL:</td>
									<td width="140" class="oscuro_decl"><div style="padding-right:20px;">{STATIC_RESULT}</div></td>
								</tr>
							</table>
							<table width="1000" border="1" rules="none" align="center">
							<tr align="right">
								<td>
								<table width="1000" rules="none" border="1" align="center">
									<tr class="titulo_tabla">
										<td colspan="7">DOCUMENTO NUEVO</td>
									</tr>
									<tr class="encabezado_center">
										<th width="200">Tipo Documento Pago</th>
										<th width="150">Nro Documento</th>
										<th width="150">Banco</th>
										<th width="150">Plaza</th>
										<th width="150">Fecha Documento</th>
										<th width="150">Monto</th>
										<th width="50">Eliminar</th>
									</tr>
								</table>
								</td>
							</tr>
							<tr>
								<td>
								<div style="overflow-x: hidden; overflow-y: auto; height: 70; margin-top: 0em;">
								<table width="1000" border="1" rules="none" align="center" id="DOCUMENTO_PAGO">
									<!-- startBlock(DOCUMENTO_PAGO) -->
									<tr class="{DW_TR_CSS}" id="{DW_TR_ID}">
										<td width="200" align="left">{COD_DOCUMENTO_PAGO_H}{COD_DOCUMENTO_NUEVO}{COD_TIPO_DOCUMENTO_PAGO}</td>
										<td width="150" align="center">{NRO_DOCUMENTO_PAGO}</td>
										<td width="150" align="left">{COD_BANCO}</td>
										<td width="150" align="left">{COD_PLAZA}</td>
										<td width="150" align="center">{FECHA_DOCUMENTO_PAGO}</td>
										<td width="150" align="right">{MONTO}{MONTO_C}</td>
										<td width="50" align="center" width="50">{ELIMINAR_DOCUMENTO_PAGO}</td>
									</tr>
									<!-- endBlock(DOCUMENTO_PAGO) -->
								</table>
								</div>
								<table width="20" rules="none" border="1" align="left" class="claro" id="ADD_DOCUMENTO_PAGO" style="display: {">
									<tr class="claro">
										<td colspan="4" align="left">{AGREGAR_DOCUMENTO_PAGO}</td>
									</tr>
								</table>
								</td>
							</tr>
							<tr>
								<td>
								<table width="1000" border="1" rules="none" align="center">
									<tr class="encabezado_right">
										<td width="800" colspan="5" align="right">TOTAL DOCUMENTOS</td>
										<td width="150" class="titulo_tabla_right_oscuro" width="150">{SUM_MONTO_C}</td>
										<td width="50"></td>
									</tr>
								</table>
							</tr>
						</table>
						<!--FIN DOCUMENTOS-->
						</div></div></div>
						
						
						
						</td>
					</tr>
				</table>


				<table width="1000" border="0" align="center">
					<tr valign="middle">
						<td width="290">{WI_BACK}</td>
						<td align="right">{WI_FIRST}{WI_PREV}</td>
						<td align="left">{WI_NEXT}{WI_LAST}</td>
						<td width="290"></td>
					</tr>
				</table>
				</td>
			</tr>
		</table>
		</td>
	</tr>
</table>
</form>
<script type="text/javascript">
<!--
var TabbedPanels1 = new Spry.Widget.TabbedPanels("TabbedPanels1");
//-->
</script>
</body>
</html>