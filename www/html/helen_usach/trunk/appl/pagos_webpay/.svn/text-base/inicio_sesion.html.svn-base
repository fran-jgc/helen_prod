	<div class="row content">
		    <div class="container">
			
			  <h2>Iniciar Sesion</h2>
			   <h4>Ingrese Su usuario de helen.</h4>
					  
					  <form class="form-horizontal" action="" method="post">
							
							<div class="form-group">
							<label class="control-label col-sm-2" for="Rut" >Usuario:</label>
									      <div class="col-sm-2">
									      <td width="170"><input name="login"  placeholder="Usuario" autocomplete="off" required type="text" id="login" value="{W_LOGIN}" onfocus="this.style.border='1px solid red'" onblur= "this.style.border=''"></td>
						     			  </div>
							</div>

						    <div class="form-group">
						      	<label class="control-label col-sm-2" for="pwd">Contraseña:</label>
								      <div class="col-sm-2">          
								          <td><input name="password"  placeholder="Contraseña" autocomplete="off" required type="password" id="password" value="{W_PASSOWRD}" onfocus="this.style.border='1px solid red'" onblur= "this.style.border=''"></td>
								      </div>
						    </div>
					    
						  
						    

						    <div class="form-group">        
							      <div class="col-sm-offset-2 col-sm-10">
							        <input type="submit" name="b_ingresar" id="b_ingresar" value="Ingresar" class="button" />
							      </div>
						    </div>

							<br>
						     


					  </form>
			</div>
