create global temporary table TEMP_PROJECT_MATRICULA
  ( RUT               NUMBER
	,DIG_VERIF          VARCHAR2(1)
  ,APELLIDO_PATERNO   VARCHAR2(100)
  ,APELLIDO_MATERNO   VARCHAR2(100)
  ,NOMBRE             VARCHAR2(100)
)
on commit delete ROWS;

create index IND_TEMP_PRO_MA1 on TEMP_PROJECT_MATRICULA (RUT asc);
create index IND_TEMP_PRO_MA2 on TEMP_PROJECT_MATRICULA (DIG_VERIF asc);
create index IND_TEMP_PRO_MA3 on TEMP_PROJECT_MATRICULA (APELLIDO_PATERNO asc);
create index IND_TEMP_PRO_MA4 on TEMP_PROJECT_MATRICULA (APELLIDO_MATERNO asc);
create index IND_TEMP_PRO_MA5 on TEMP_PROJECT_MATRICULA (NOMBRE asc);