create global temporary table TEMP_RECUP_TIPO_DEUDA
  ( COD_TIPO_DEUDA					VARCHAR2(20)
	,MONTO_MORA						NUMBER
	,MONTO_MULTA					NUMBER
	,MONTO_MULTA_TOTAL_PESOS		NUMBER
	,MONTO_CAPITAL_VIGENTE			NUMBER
	,MONTO_INTERES_VIGENTE			NUMBER
	,MONTO_CI_TOTAL_VIGENTE_PESOS	NUMBER
	,MONTO_CAPITAL_FUTURO			NUMBER
	,MONTO_INTERES_FUTURO			NUMBER
	,MONTO_CI_TOTAL_FUTURO_PESOS	NUMBER
	,MONTO_CAPITAL_NO_EXIGIBLE		NUMBER
	,MONTO_INTERES_NO_EXGIGIBLE		NUMBER
	,MONTO_CI_TOTAL_NO_EXGIGIBLE_P	NUMBER
	,MONTO_TOTAL                    NUMBER
	,MONTO_TOTAL_PESOS              NUMBER
)
on commit delete ROWS;
