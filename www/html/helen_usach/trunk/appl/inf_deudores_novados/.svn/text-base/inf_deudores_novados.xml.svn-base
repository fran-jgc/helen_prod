<Report>
	<Font name="Arial" size="7" style="" id="ArialSmall"/>
	<Font name="Arial" size="7" style="" id="ArialSmallBlue" red="0" green="0" blue="128"/>
	<Font name="Arial" size="17" style="B" id="ArialBoldBigB" red="0" green="0" blue="128"/>
	<Font name="Arial" size="8" style="B" id="ArialBold"/>
	<Font name="Arial" size="8" style="" id="Arial"/>
	<PageHeader>	
		<Cell text="" height="40" newline="1"/>
		<Cell text="{str_fecha_hora}" align="R" font="ArialSmall" newline="1" />
		<Cell text="Pag. {SectionPageNumber}/{snb}" align="R" font="ArialSmall" newline="1" />
		<Cell text="DEUDORES NOVADOS" width="100%" align="C" newline="1" font="ArialBoldBigB"/>
		<Cell text="{str_filtro}" width="100%" align="C" newline="1" font="ArialSmallBlue"/>
		<Cell text="" height="10" newline="1"/>		
	</PageHeader>
	<Content font="Arial">
		<Cell text="{COD_NOVACION}" width="9%" align="C" border="LRTB" format="N0,." font="Arial"/>
		<Cell text="{FECHA_NOVACION}" width="9%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{RUT}" width="10%" align="C" border="LRTB" font="Arial"/>
		<Cell text="{NOMBRE}" width="14%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{APELLIDO_PATERNO}" width="14%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{APELLIDO_MATERNO}" width="14%" align="L" border="LRTB" font="Arial"/>
		<Cell text="{COD_DEUDA_ANTIGUA}" width="10%" align="C" border="LRTB" format="N0,." font="Arial"/>
		<Cell text="{COD_DEUDA_NUEVA}" width="10%" align="C" border="LRTB" format="N0,." font="Arial"/>
		<Cell text="{FOLIO_PAGARE}" width="10%" align="C" border="LRTB" font="Arial" newline="1"/>
	</Content>
	<Group>
		<Variable name="cant_reg" function="COUNT"  value="COD_NOVACION"/>
		<GroupHeader>
			<Cell text="Cantidad de Registros: " width="17%" align="L"  font="ArialBold"/>
			<Cell text="{cant_reg}" width="10%" align="L" font="ArialBold" newline="1"/>
			
			<Cell text="Nº Novación" width="9%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Fecha Novación" width="9%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Rut" width="10%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Nombre" width="14%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Paterno" width="14%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Materno" width="14%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Nº Deuda Antigua" width="10%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Nº Deuda Nueva" width="10%" align="C" border="LRTB" font="ArialSmallBlue"/>
			<Cell text="Folio Pagaré" width="10%" align="C" border="LRTB" font="ArialSmallBlue" newline="1"/>
		</GroupHeader>
	</Group>
</Report>

